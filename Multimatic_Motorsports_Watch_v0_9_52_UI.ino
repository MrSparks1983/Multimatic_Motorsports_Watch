static void watch_pwr_hold_begin(
    uint32_t now) {
  if (!watchScreenOn) {
    watch_screen_wake();
  } else {
    watch_note_activity();
  }

  // Start timing immediately, but intentionally delay the visual overlay.
  // A normal short PWR press can return HOME without flashing a power-off
  // message on the screen.
  watchPwrHoldActive = true;
  watchPwrHoldStartedMs = now;

  USBSerial.println(
    "[WATCH] PWR hold timing started");
}

static void watch_pwr_hold_update(
    uint32_t now) {
  if (!watchPwrHoldActive) {
    return;
  }

  uint32_t elapsed =
    now - watchPwrHoldStartedMs;

  // Do not show anything for an ordinary short PWR press.
  if (elapsed <
      WATCH_PWR_HOLD_UI_DELAY_MS) {
    return;
  }

  if (!watchPwrHoldOverlay) {
    watch_pwr_hold_show();
  }

  if (!watchPwrHoldBar) {
    return;
  }

  if (elapsed >
      WATCH_PWR_HOLD_OFF_MS) {
    elapsed =
      WATCH_PWR_HOLD_OFF_MS;
  }

  // Once the overlay becomes visible, the bar fills through the remaining
  // portion of the 2-second shutdown hold.
  uint32_t visibleElapsed =
    elapsed - WATCH_PWR_HOLD_UI_DELAY_MS;

  uint32_t visibleDuration =
    WATCH_PWR_HOLD_OFF_MS -
    WATCH_PWR_HOLD_UI_DELAY_MS;

  int pct =
    (int)(
      (visibleElapsed * 100UL) /
      visibleDuration);

  if (pct < 0) pct = 0;
  if (pct > 100) pct = 100;

  lv_bar_set_value(
    watchPwrHoldBar,
    pct,
    LV_ANIM_OFF);

  if (watchPwrHoldPercent) {
    char pctText[8];

    snprintf(
      pctText,
      sizeof(pctText),
      "%d%%",
      pct);

    lv_label_set_text(
      watchPwrHoldPercent,
      pctText);
  }

  if (pct >= 100 &&
      watchPwrHoldTitle) {
    lv_label_set_text(
      watchPwrHoldTitle,
      "POWERING OFF...");
  }
}

static bool watch_pwr_button_init() {
  watchPwrButtonReady = false;

  // Probe the AXP2101.
  Wire.beginTransmission(
    WATCH_AXP2101_ADDR);

  if (Wire.endTransmission() != 0) {
    USBSerial.println(
      "[WATCH] AXP2101 not detected; PWR/battery unavailable");
    return false;
  }

  // Explicit 320mAh LiPo charge profile:
  // 100mA constant-current / 4.20V constant-voltage.
  watch_apply_charge_profile();

  // Enable battery presence detection.
  watch_axp_update_bits(
    WATCH_AXP2101_BAT_DET_CTRL,
    0x00,
    0x01);

  // Keep the AXP2101 fuel gauge enabled so REG A4 can report SOC.
  watch_axp_update_bits(
    WATCH_AXP2101_FUEL_GAUGE_CTRL,
    0x00,
    0x01);

  // REG27 IRQLEVEL bits 5:4:
  // 00=1.0s, 01=1.5s, 10=2.0s, 11=2.5s.
  // Set exactly 2.0 seconds for our software shutdown gesture while
  // preserving the PMIC's hardware OFFLEVEL/ONLEVEL fields.
  if (!watch_axp_update_bits(
        WATCH_AXP2101_IRQ_LEVEL_CTRL,
        0x30,
        0x20)) {
    USBSerial.println(
      "[WATCH] AXP2101 2s long-press level config failed");
  }

  uint8_t irqEnable = 0;

  if (!watch_axp_read_reg(
        WATCH_AXP2101_INTEN2,
        irqEnable)) {
    USBSerial.println(
      "[WATCH] AXP2101 IRQ enable read failed");
    return false;
  }

  // INTEN2:
  // bit 3 = short press
  // bit 2 = long press (threshold controlled by REG27 IRQLEVEL)
  // bit 1 = negative edge (physical press)
  // bit 0 = positive edge (physical release)
  // Edge IRQs drive the live HOLD TO POWER OFF progress UI.
  irqEnable |=
    WATCH_AXP2101_PKEY_SHORT_MASK |
    WATCH_AXP2101_PKEY_LONG_MASK |
    WATCH_AXP2101_PKEY_NEG_EDGE_MASK |
    WATCH_AXP2101_PKEY_POS_EDGE_MASK;

  if (!watch_axp_write_reg(
        WATCH_AXP2101_INTEN2,
        irqEnable)) {
    USBSerial.println(
      "[WATCH] AXP2101 PWR IRQ enable failed");
    return false;
  }

  // Clear stale PWR flags from before firmware startup.
  watch_axp_write_reg(
    WATCH_AXP2101_INTSTS2,
    WATCH_AXP2101_PKEY_SHORT_MASK |
    WATCH_AXP2101_PKEY_LONG_MASK |
    WATCH_AXP2101_PKEY_NEG_EDGE_MASK |
    WATCH_AXP2101_PKEY_POS_EDGE_MASK);

  watchPwrButtonReady = true;
  watchPwrButtonLastPollMs =
    millis();

  watchBatteryLastPollMs = 0;
  watchBatteryLastAnimMs = millis();
  watchBatteryAnimStep = 0;

  watch_battery_poll_pmic();

  USBSerial.println(
    "[WATCH] Physical PWR ready: short=HOME / hold 2s=OFF");

  return true;
}

static void watch_pwr_button_service() {
  if (!watchPwrButtonReady) {
    return;
  }

  uint32_t now =
    millis();

  if ((now - watchPwrButtonLastPollMs) <
      WATCH_PWR_BUTTON_POLL_MS) {
    return;
  }

  watchPwrButtonLastPollMs =
    now;

  // Animate continuously between the physical press edge and release/long IRQ.
  watch_pwr_hold_update(
    now);

  uint8_t status = 0;

  if (!watch_axp_read_reg(
        WATCH_AXP2101_INTSTS2,
        status)) {
    return;
  }

  // PWRON is active-low:
  // negative edge = button physically pressed.
  if ((status &
       WATCH_AXP2101_PKEY_NEG_EDGE_MASK) != 0) {
    watch_axp_write_reg(
      WATCH_AXP2101_INTSTS2,
      WATCH_AXP2101_PKEY_NEG_EDGE_MASK);

    if (!watchPwrHoldActive) {
      watch_pwr_hold_begin(
        now);
    }
  }

  // Long press always wins over release/short events.
  if ((status &
       WATCH_AXP2101_PKEY_LONG_MASK) != 0) {
    watch_axp_write_reg(
      WATCH_AXP2101_INTSTS2,
      WATCH_AXP2101_PKEY_LONG_MASK |
      WATCH_AXP2101_PKEY_SHORT_MASK |
      WATCH_AXP2101_PKEY_NEG_EDGE_MASK |
      WATCH_AXP2101_PKEY_POS_EDGE_MASK);

    if (!watchPwrHoldActive) {
      watchPwrHoldActive = true;
      watchPwrHoldStartedMs =
        now - WATCH_PWR_HOLD_OFF_MS;
    }

    if (!watchPwrHoldOverlay) {
      watch_pwr_hold_show();
    }

    // Force the final state before shutdown.
    watchPwrHoldStartedMs =
      now - WATCH_PWR_HOLD_OFF_MS;
    watch_pwr_hold_update(
      now);

    // Keep the final POWERING OFF state visible long enough to read.
    lv_timer_handler();
    delay(350);

    watch_pmu_shutdown();
    return;
  }

  bool released =
    (status &
     WATCH_AXP2101_PKEY_POS_EDGE_MASK) != 0;

  if (released) {
    watch_axp_write_reg(
      WATCH_AXP2101_INTSTS2,
      WATCH_AXP2101_PKEY_POS_EDGE_MASK);

    // Releasing before the 2-second long-press IRQ cancels shutdown.
    watch_pwr_hold_hide();
  }

  if ((status &
       WATCH_AXP2101_PKEY_SHORT_MASK) == 0) {
    return;
  }

  watch_axp_write_reg(
    WATCH_AXP2101_INTSTS2,
    WATCH_AXP2101_PKEY_SHORT_MASK);

  // Make sure a short tap never leaves the hold overlay behind.
  watch_pwr_hold_hide();

  USBSerial.println(
    "[WATCH] PWR short press -> HOME");

  // Do not navigate behind the password editor.
  if (wifiPasswordOverlay) {
    return;
  }

  if (!watchScreenOn) {
    watch_screen_wake();
  } else {
    watch_note_activity();
  }

  // If USB charging standby is currently covering the UI, PWR explicitly
  // dismisses it for this cable session and resumes the watch on HOME.
  if (watchBatteryVbusPresent &&
      (watchChargingScreenVisible ||
       watchChargingScreen)) {
    USBSerial.println(
      "[WATCH] Charging standby dismissed -> HOME");

    watchChargingScreenDismissed = true;
    watch_charging_screen_hide();

    // Rebuild HOME even though activePageId is normally already PAGE_HOME
    // underneath the charging overlay.
    build_page(PAGE_HOME);
    return;
  }

  if (activePageId != PAGE_HOME) {
    build_page(PAGE_HOME);
  }
}




// -------------------- FIRMWARE UPDATE PROGRESS --------------------

// Force LVGL to render the current progress widgets and then physically
// transfer the full direct-render framebuffer to the AMOLED. This is needed
// while HTTP/OTA code is blocking before loop() reaches its normal display
// flush at the bottom.
static void watch_ota_progress_render_now(
    bool force) {
  if (!watchScreenOn ||
      !watchOtaProgressOverlay) {
    return;
  }

  uint32_t now =
    millis();

  // Avoid pushing the entire 410x502 framebuffer on every 4 KB network chunk.
  // Forced calls are used for opening/final states; normal calls are limited
  // to about 8 frames/sec.
  if (!force &&
      (now -
       watchOtaProgressLastRenderMs) <
        120UL) {
    return;
  }

  watchOtaProgressLastRenderMs =
    now;

  // Apply object changes immediately rather than waiting for the normal LVGL
  // refresh timer, which may not get another main-loop opportunity during OTA.
  lv_obj_invalidate(
    watchOtaProgressOverlay);

  lv_refr_now(
    disp);

#ifdef DIRECT_RENDER_MODE
#if defined(CANVAS) || defined(RGB_PANEL) || defined(DSI_PANEL)
  gfx->flush();
#else
  gfx->draw16bitRGBBitmap(
    0,
    0,
    (uint16_t *)disp_draw_buf,
    screenWidth,
    screenHeight
  );
#endif
#else
#ifdef CANVAS
  gfx->flush();
#endif
#endif

  // Give the Wi-Fi/TCP task a scheduling opportunity after the display copy.
  delay(1);
}



