static void build_settings(lv_obj_t *parent) {
  settingsBrightnessValueLabel = nullptr;

  switch (settingsSection) {
    case SETTINGS_SECTION_WIFI:
      build_settings_wifi(parent);
      break;

    case SETTINGS_SECTION_BLUETOOTH:
      build_settings_bluetooth(parent);
      break;

    case SETTINGS_SECTION_GENERAL:
      build_settings_general(parent);
      break;

    case SETTINGS_SECTION_BATTERY:
      build_settings_battery(parent);
      break;

    case SETTINGS_SECTION_TIME_DATE:
      build_settings_time_date(parent);
      break;

    case SETTINGS_SECTION_FIRMWARE:
      build_settings_firmware(parent);
      break;

    case SETTINGS_SECTION_ROOT:
    default:
      build_settings_root(parent);
      break;
  }
}

