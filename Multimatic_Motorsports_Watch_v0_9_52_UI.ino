static void connectivity_service() {
  // Wi-Fi connect / auto-reconnect supervision.
  wl_status_t current =
    WiFi.status();

  if (wifiConnectInProgress) {
    if (current == WL_CONNECTED) {
      wifiConnectInProgress = false;
      wifiLastConnectFailed = false;

      if (wifiPendingSave) {
        wifiSavedSsid = wifiPendingSsid;
        wifiSavedPassword = wifiPendingPassword;

        if (connectivityPrefsReady) {
          connectivityPrefs.putString(
            "wifi_ssid",
            wifiSavedSsid);
          connectivityPrefs.putString(
            "wifi_pass",
            wifiSavedPassword);
        }

        wifiPendingSave = false;
      }

      settingsStatusLine =
        "Wi-Fi connected: " + WiFi.SSID();

      if (activePageId == PAGE_SETTINGS) {
        build_page(PAGE_SETTINGS);
      }

    } else if (
      (millis() - wifiConnectStartedMs)
      > 15000UL) {

      wifiConnectInProgress = false;
      wifiPendingSave = false;
      wifiLastConnectFailed = true;

      WiFi.disconnect(false, false);

      settingsStatusLine =
        "Wi-Fi connection timed out";

      if (activePageId == PAGE_SETTINGS) {
        build_page(PAGE_SETTINGS);
      }
    }
  }

  // Finish the asynchronous BLE discovery screen cleanly.
  if (settingsBleScanComplete) {
    settingsBleScanComplete = false;

    if (bf1BleScan) {
      bf1BleScan->clearResults();
    }

    if (settingsBleSelectedMac.length() > 0) {
      ble_ui_set_selected();
    } else {
      ble_ui_set_disconnected();
    }

    settingsStatusLine =
      String(settingsBleCount)
      + " Bluetooth devices found";

    if (activePageId == PAGE_SETTINGS) {
      build_page(PAGE_SETTINGS);
    }
  }

  // Rebuild Settings only on meaningful Wi-Fi state transitions.
  if (current != wifiLastStatus) {
    wifiLastStatus = current;

    update_wifi_header_ui();

    if (activePageId == PAGE_SETTINGS &&
        !wifiConnectInProgress) {
      build_page(PAGE_SETTINGS);
    }
  }
}

