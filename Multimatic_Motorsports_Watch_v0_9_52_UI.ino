  lv_obj_set_style_width(pageBody, 3, LV_PART_SCROLLBAR);
  lv_obj_set_style_radius(pageBody, 2, LV_PART_SCROLLBAR);

  // Track user scroll activity so BF1 live refresh cannot pull the page
  // back to the radar while the sensor values are being viewed.
  lv_obj_add_event_cb(pageBody, bf1_page_scroll_cb, LV_EVENT_SCROLL, nullptr);

  // Create the persistent bottom navigation outside pageBody.
  // It is hidden on HOME and shown on every sub-page.
  create_fixed_bottom_nav();

  build_page(PAGE_HOME);

  // Re-read PMIC state now that the LVGL charging/header objects can exist.
  // This makes USB-connected boot enter charging standby immediately.
  watchBatteryLastPollMs = 0;
  watch_battery_poll_pmic();
  watch_charging_screen_sync();

  // AXP2101 VBUS status can settle just after startup. Two one-shot checks
  // guarantee charging standby wins over any boot-time HOME rendering.
  lv_timer_create(
    startup_charge_sync_cb,
    250,
    nullptr);

  lv_timer_create(
    startup_charge_sync_cb,
    900,
    nullptr);
}

// -------------------- SETUP --------------------

void setup() {
#ifdef DEV_DEVICE_INIT
  DEV_DEVICE_INIT();
#endif

  USBSerial.begin(115200);
  USBSerial.println();
  USBSerial.println("Multimatic Motorsports Watch V0.9.58");
  USBSerial.print("[WATCH] Reset reason: ");
  USBSerial.println((int)esp_reset_reason());

  // If this is the first boot of a newly installed OTA image, mark it valid
  // immediately so an enabled rollback configuration cannot return to the
  // previous application on the next reset.
  watch_ota_confirm_running_app();

  // Display
  if (!gfx->begin()) {
    USBSerial.println("ERROR: gfx->begin() failed");
  }

  gfx->fillScreen(RGB565_BLACK);

  // I2C / touch
  Wire.begin(IIC_SDA, IIC_SCL);

  while (FT3168->begin() == false) {
    USBSerial.println("FT3168 initialization failed");
    delay(1000);
  }

  USBSerial.println("FT3168 OK");

  FT3168->IIC_Write_Device_State(
    FT3168->Arduino_IIC_Touch::Device::TOUCH_POWER_MODE,
    FT3168->Arduino_IIC_Touch::Device_Mode::TOUCH_POWER_MONITOR
  );

  // QMI8658 is the board's motion sensor used for raise-to-wake.
  // Built-in QMI8658 driver; no external IMU library required.
  watch_motion_init();

  // Physical PWR is the AXP2101 power key, not GPIO0.
  // Short press returns HOME; hold 2 sec performs PMIC shutdown.
  // The AXP2101 is also explicitly configured for the 320mAh watch battery:
  // 100mA constant-current charging with a 4.20V CV target.
  watch_pwr_button_init();

  // Initialize the onboard ES8311 speaker path. No alert tones are played
  // yet; the amplifier remains in standby until a future sound requests it.
  watch_audio_init();

  // LVGL
  lv_init();
  lv_tick_set_cb(millis_cb);

#if LV_USE_LOG != 0
  lv_log_register_print_cb(my_print);
#endif

  screenWidth  = gfx->width();
  screenHeight = gfx->height();

#ifdef DIRECT_RENDER_MODE
  bufSize = screenWidth * screenHeight;
#else
  bufSize = screenWidth * 50;
#endif

#ifdef ESP32
#if defined(DIRECT_RENDER_MODE) && \
    (defined(CANVAS) || defined(RGB_PANEL) || defined(DSI_PANEL))
  disp_draw_buf = (lv_color_t *)gfx->getFramebuffer();
#else
  disp_draw_buf =
    (lv_color_t *)heap_caps_malloc(
      bufSize * 2,
      MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT
    );

  if (!disp_draw_buf) {
    disp_draw_buf =
      (lv_color_t *)heap_caps_malloc(
        bufSize * 2,
        MALLOC_CAP_8BIT
      );
  }
#endif
#else
  disp_draw_buf = (lv_color_t *)malloc(bufSize * 2);
#endif

  if (!disp_draw_buf) {
    USBSerial.println("ERROR: LVGL draw buffer allocation failed");
    while (true) delay(1000);
  }

  disp = lv_display_create(screenWidth, screenHeight);
  lv_display_set_flush_cb(disp, my_disp_flush);

#ifdef DIRECT_RENDER_MODE
  lv_display_set_buffers(
    disp,
    disp_draw_buf,
    NULL,
    bufSize * 2,
    LV_DISPLAY_RENDER_MODE_DIRECT
  );
#else
  lv_display_set_buffers(
    disp,
    disp_draw_buf,
    NULL,
    bufSize * 2,
    LV_DISPLAY_RENDER_MODE_PARTIAL
  );
#endif

  lv_indev_t *indev = lv_indev_create();
  lv_indev_set_type(indev, LV_INDEV_TYPE_POINTER);
  lv_indev_set_read_cb(indev, my_touchpad_read);

  lv_display_add_event_cb(
    disp,
    rounder_event_cb,
    LV_EVENT_INVALIDATE_AREA,
    NULL
  );

  show_startup_splash();

  // Load saved Wi-Fi/BLE selections and begin saved Wi-Fi reconnect.
  // WiFi.begin() is non-blocking; the main UI appears immediately.
  connectivity_init();

  // Prepare secure Web OTA routes. OTA remains disabled until the user
  // explicitly enables a session from Settings -> Firmware Update.
  watch_ota_init();

  // Apply saved timezone and load PCF85063 RTC before the header is built.
  // If Auto Wi-Fi Sync is enabled, NTP refresh begins when Wi-Fi connects.
  watch_time_init();

  // BOOT is GPIO0 and active LOW during normal runtime.
  // Holding BOOT while powering/resetting still enters ROM download mode.
  pinMode(
    WATCH_BOOT_BUTTON_PIN,
    INPUT_PULLUP);

  watchBootButtonLastReadingHigh =
    (digitalRead(WATCH_BOOT_BUTTON_PIN) != LOW);
  watchBootButtonStableHigh =
    watchBootButtonLastReadingHigh;
  watchBootButtonLastChangeMs =
    millis();

  create_main_ui();

  USBSerial.println("UI ready");
}

// -------------------- LOOP --------------------

void loop() {
  lv_timer_handler();

  // Live BF1 radar service. Scanning runs only while TPMS / BF1 RADAR
  // is the active page, using repeating one-second BLE scan passes.
  bf1_service_live_scan();

  // Non-blocking Wi-Fi connection supervision and BLE-settings completion.
  connectivity_service();

  // Secure local Web OTA. Server handles clients only after the user has
  // explicitly enabled an OTA session in Settings.
  watch_ota_service();

  // Periodic firmware-feed check, notification, and user-approved install.
  // OTA progress performs its own forced direct-render AMOLED refresh while
  // the network/update path is blocking.
  watch_fw_update_service();

  // Header clock, RTC persistence, automatic NTP sync, and manual clock state.
  watch_time_service();

  // AXP2101 battery state first so charging-screen state is current.
  watch_battery_service();

  // Screen timeout, tap-to-wake, and optional QMI8658 raise-to-wake.
  // Charging mode overrides timeout and keeps the charging screen visible.
  watch_display_service();

  // Physical PWR button:
  // short press -> HOME, hold 2 sec -> PMIC shutdown.
  watch_pwr_button_service();

  // Physical BOOT button: GPIO0 -> user-selected shortcut.
  watch_boot_button_service();

if (watchScreenOn) {
#ifdef DIRECT_RENDER_MODE
#if defined(CANVAS) || defined(RGB_PANEL) || defined(DSI_PANEL)
  gfx->flush();
#else
  gfx->draw16bitRGBBitmap(
    0,
    0,
    (uint16_t *)disp_draw_buf,
    screenWidth,
    screenHeight
  );
#endif
#else
#ifdef CANVAS
  gfx->flush();
#endif
#endif
}

  // Small simulated live movement so the UI does not feel static.
  // Real CAN data will replace these Vitals values later.
  if (millis() - lastSimUpdate >= 250) {
    lastSimUpdate = millis();
    simCounter++;

    uint32_t p = simCounter % 80;
    float tri =
      (p < 40)
        ? (float)p
        : (float)(80 - p);

    vehicle.rpm =
      5200.0f + tri * 65.0f;

    vehicle.speedKph =
      172.0f + tri * 0.65f;

    vehicle.throttle =
      62.0f + tri * 0.80f;

    vehicle.brake =
      (p < 5)
        ? (float)(5 - p) * 7.0f
        : 0.0f;

    vehicle.steeringDeg =
      ((int)(simCounter % 25) - 12)
      * 1.25f;

    vehicle.gear =
      (vehicle.rpm >= 7450.0f)
        ? 5
        : 4;

    vehicle.batteryV =
      13.8f +
      ((simCounter % 3) * 0.05f);

    // Engine-page demo channels. These are intentionally subtle so the
    // page behaves like live telemetry without looking artificial.
    vehicle.mapPsi =
      17.2f +
      tri * 0.14f;

    vehicle.intakeAirC =
      39.0f +
      (float)(simCounter % 8) * 0.35f;

    vehicle.lambda =
      0.90f +
      (float)(simCounter % 7) * 0.006f;

    vehicle.oilPressure =
      48.0f +
      vehicle.rpm * 0.0040f;

    vehicle.fuelPressure =
      57.5f +
      (float)(simCounter % 5) * 0.25f;

    vehicle.transIn =
      62.0f +
      tri * 0.16f;

    vehicle.transOut =
      58.0f +
      tri * 0.12f;

    vitals_update_ui();
    engine_update_ui();
  }

  delay(5);
}
