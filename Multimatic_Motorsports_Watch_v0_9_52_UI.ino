static lv_image_dsc_t img_home_vitals;
static lv_image_dsc_t img_home_engine;
static lv_image_dsc_t img_home_tpms;
static lv_image_dsc_t img_home_session;

static void init_home_image_descriptors() {
  static bool initialized = false;
  if (initialized) return;
  initialized = true;

  img_home_vitals.header.magic = LV_IMAGE_HEADER_MAGIC;
  img_home_vitals.header.cf = LV_COLOR_FORMAT_RGB565;
  img_home_vitals.header.flags = 0;
  img_home_vitals.header.w = 148;
  img_home_vitals.header.h = 116;
  img_home_vitals.header.stride = 296;
  img_home_vitals.data_size = sizeof(img_home_vitals_map);
  img_home_vitals.data = (const uint8_t *)img_home_vitals_map;

  img_home_engine.header.magic = LV_IMAGE_HEADER_MAGIC;
  img_home_engine.header.cf = LV_COLOR_FORMAT_RGB565;
  img_home_engine.header.flags = 0;
  img_home_engine.header.w = 148;
  img_home_engine.header.h = 116;
  img_home_engine.header.stride = 296;
  img_home_engine.data_size = sizeof(img_home_engine_map);
  img_home_engine.data = (const uint8_t *)img_home_engine_map;

  img_home_tpms.header.magic = LV_IMAGE_HEADER_MAGIC;
  img_home_tpms.header.cf = LV_COLOR_FORMAT_RGB565;
  img_home_tpms.header.flags = 0;
  img_home_tpms.header.w = 148;
  img_home_tpms.header.h = 116;
  img_home_tpms.header.stride = 296;
  img_home_tpms.data_size = sizeof(img_home_tpms_map);
  img_home_tpms.data = (const uint8_t *)img_home_tpms_map;

  img_home_session.header.magic = LV_IMAGE_HEADER_MAGIC;
  img_home_session.header.cf = LV_COLOR_FORMAT_RGB565;
  img_home_session.header.flags = 0;
  img_home_session.header.w = 148;
  img_home_session.header.h = 116;
  img_home_session.header.stride = 296;
  img_home_session.data_size = sizeof(img_home_session_map);
  img_home_session.data = (const uint8_t *)img_home_session_map;
}

static const lv_image_dsc_t *home_image_for_page(PageId page) {
  switch (page) {
    case PAGE_VITALS:  return &img_home_vitals;
    case PAGE_ENGINE:  return &img_home_engine;
    case PAGE_TPMS:    return &img_home_tpms;
    case PAGE_SESSION: return &img_home_session;
    default:           return nullptr;
  }
}


