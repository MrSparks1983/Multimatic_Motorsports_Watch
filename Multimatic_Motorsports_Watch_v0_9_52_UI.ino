// -------------------- WATCH DISPLAY / WAKE SERVICES --------------------

static uint8_t watch_brightness_raw() {
  uint32_t raw =
    (watchBrightnessPct * 255UL) / 100UL;

  if (raw < 18) raw = 18;
  if (raw > 255) raw = 255;

  return (uint8_t)raw;
}

static void watch_note_activity() {
  watchLastActivityMs = millis();
}

static float watch_clampf(float v, float lo, float hi) {
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static void watch_normalize3(
    float x,
    float y,
    float z,
    float &nx,
    float &ny,
    float &nz) {
  float mag =
    sqrtf(x * x + y * y + z * z);

  if (mag < 0.0001f) {
    nx = 0.0f;
    ny = 0.0f;
    nz = 1.0f;
    return;
  }

  nx = x / mag;
  ny = y / mag;
  nz = z / mag;
}

static float watch_vector_angle_deg(
    float ax,
    float ay,
    float az,
    float bx,
    float by,
    float bz) {
  float dot =
    ax * bx + ay * by + az * bz;

  dot =
    watch_clampf(dot, -1.0f, 1.0f);

  return acosf(dot) * 57.2957795f;
}

static const char *watch_raise_sensitivity_label(
    uint8_t sensitivity) {
  switch (sensitivity) {
    case 0:  return "LOW";
    case 2:  return "HIGH";
    case 1:
    default: return "NORMAL";
  }
}

static float watch_raise_start_movement_threshold() {
  switch (watchRaiseSensitivity) {
    case 0:  return 0.30f;
    case 2:  return 0.15f;
    case 1:
    default: return 0.21f;
  }
}

static float watch_raise_angle_threshold_deg() {
  switch (watchRaiseSensitivity) {
    case 0:  return 42.0f;
    case 2:  return 21.0f;
    case 1:
    default: return 30.0f;
  }
}

static float watch_raise_step_angle_threshold_deg() {
  switch (watchRaiseSensitivity) {
    case 0:  return 14.0f;
    case 2:  return 8.0f;
    case 1:
    default: return 10.0f;
  }
}

static float watch_raise_settle_movement_threshold() {
  switch (watchRaiseSensitivity) {
    case 0:  return 0.085f;
    case 2:  return 0.135f;
    case 1:
    default: return 0.105f;
  }
}

static void watch_raise_reset_state() {
  watchHavePrevAccel = false;
  watchRaiseHaveBase = false;
  watchRaiseCandidate = false;
  watchRaiseCandidateStartedMs = 0;
  watchRaisePeakAngleDeg = 0.0f;
  watchRaiseSettleSamples = 0;
}

static void watch_screen_wake() {
  if (!watchScreenOn) {
    gfx->displayOn();
    gfx->setBrightness(watch_brightness_raw());
    watchScreenOn = true;

    // Consume the entire wake gesture. The user must release and touch
    // again after this short guard interval before LVGL receives input.
    watchWakeTouchGuard = true;
    watchWakeTouchGuardStartedMs = millis();
  }

  watchLastActivityMs = millis();
  watch_raise_reset_state();
}

static void watch_screen_off() {
  if (!watchScreenOn) return;

  gfx->displayOff();
  watchScreenOn = false;
  watchScreenOffMs = millis();
  watchWakeTouchGuard = false;
  watchWakeTouchGuardStartedMs = 0;
  watch_raise_reset_state();
}

static const char *watch_timeout_label(uint32_t seconds) {
  switch (seconds) {
    case 15:  return "15 SEC";
    case 30:  return "30 SEC";
    case 60:  return "1 MIN";
    case 120: return "2 MIN";
    case 300: return "5 MIN";
    case 0:   return "NEVER";
    default:  return "30 SEC";
  }
}

static bool watch_qmi_write_reg(
    uint8_t reg,
    uint8_t value) {
  Wire.beginTransmission(watchQmiAddress);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission() == 0;
}

static bool watch_qmi_read_reg(
    uint8_t reg,
    uint8_t &value) {
  Wire.beginTransmission(watchQmiAddress);
  Wire.write(reg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  if (Wire.requestFrom(
        (int)watchQmiAddress,
        1) != 1) {
    return false;
  }

  value = (uint8_t)Wire.read();
  return true;
}

static bool watch_qmi_read_bytes(
    uint8_t startReg,
    uint8_t *buffer,
    size_t len) {
  Wire.beginTransmission(watchQmiAddress);
  Wire.write(startReg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  size_t got =
    Wire.requestFrom(
      (int)watchQmiAddress,
      (int)len);

  if (got != len) {
    while (Wire.available()) {
      Wire.read();
    }
    return false;
  }

  for (size_t i = 0; i < len; ++i) {
    if (!Wire.available()) {
      return false;
    }
    buffer[i] = (uint8_t)Wire.read();
  }

  return true;
}

static bool watch_qmi_probe_address(
    uint8_t address) {
  watchQmiAddress = address;

  uint8_t who = 0;
  if (!watch_qmi_read_reg(
        WATCH_QMI8658_WHOAMI,
        who)) {
    return false;
  }

  return who == WATCH_QMI8658_WHOAMI_VALUE;
}

static bool watch_qmi_data_ready() {
  uint8_t status0 = 0;

  if (!watch_qmi_read_reg(
        WATCH_QMI8658_STATUS0,
        status0)) {
    return false;
  }

  return (status0 & 0x01) != 0;
}

static bool watch_qmi_read_accelerometer(
    float &x,
    float &y,
    float &z) {
  uint8_t data[6] = {0};

  if (!watch_qmi_read_bytes(
        WATCH_QMI8658_AX_L,
        data,
        sizeof(data))) {
    return false;
  }

  int16_t rawX =
    (int16_t)(
      ((uint16_t)data[1] << 8) |
      data[0]);

  int16_t rawY =
    (int16_t)(
      ((uint16_t)data[3] << 8) |
      data[2]);

  int16_t rawZ =
    (int16_t)(
      ((uint16_t)data[5] << 8) |
      data[4]);

  const float scale =
    4.0f / 32768.0f;

  x = rawX * scale;
  y = rawY * scale;
  z = rawZ * scale;

  return true;
}

static bool watch_motion_init() {
  watchImuReady = false;

  bool found =
    watch_qmi_probe_address(
      WATCH_QMI8658_ADDR_LOW);

  if (!found) {
    found =
      watch_qmi_probe_address(
        WATCH_QMI8658_ADDR_HIGH);
  }

  if (!found) {
    USBSerial.println(
      "[WATCH] QMI8658 not detected on 0x6B or 0x6A");
    return false;
  }

  if (!watch_qmi_write_reg(
        WATCH_QMI8658_RESET,
        0xB0)) {
    USBSerial.println(
      "[WATCH] QMI8658 reset write failed");
    return false;
  }

  delay(20);

  uint8_t who = 0;
  if (!watch_qmi_read_reg(
        WATCH_QMI8658_WHOAMI,
        who) ||
      who != WATCH_QMI8658_WHOAMI_VALUE) {
    USBSerial.println(
      "[WATCH] QMI8658 WHO_AM_I failed after reset");
    return false;
  }

  // Address auto increment + little endian.
  uint8_t ctrl1 = 0;
  if (!watch_qmi_read_reg(
        WATCH_QMI8658_CTRL1,
        ctrl1)) {
    return false;
  }

  ctrl1 |= 0x40;
  ctrl1 &= (uint8_t)~0x20;

  if (!watch_qmi_write_reg(
        WATCH_QMI8658_CTRL1,
        ctrl1)) {
    return false;
  }

  // +/-4g, 31.25 Hz.
  if (!watch_qmi_write_reg(
        WATCH_QMI8658_CTRL2,
        0x18)) {
    USBSerial.println(
      "[WATCH] QMI8658 CTRL2 config failed");
    return false;
  }

  // Accelerometer LPF mode 0, enabled.
  uint8_t ctrl5 = 0;
  if (!watch_qmi_read_reg(
        WATCH_QMI8658_CTRL5,
        ctrl5)) {
    return false;
  }

  ctrl5 &= 0xF9;
  ctrl5 |= 0x01;

  if (!watch_qmi_write_reg(
        WATCH_QMI8658_CTRL5,
        ctrl5)) {
    return false;
  }

  // Enable accelerometer, leave gyro disabled.
  uint8_t ctrl7 = 0;
  if (!watch_qmi_read_reg(
        WATCH_QMI8658_CTRL7,
        ctrl7)) {
    return false;
  }

  ctrl7 &= (uint8_t)~0x02;
  ctrl7 |= 0x01;

  if (!watch_qmi_write_reg(
        WATCH_QMI8658_CTRL7,
        ctrl7)) {
    USBSerial.println(
      "[WATCH] QMI8658 accelerometer enable failed");
    return false;
  }

  delay(50);

  float x = 0.0f;
  float y = 0.0f;
  float z = 0.0f;
  bool sampleOk = false;

  for (int i = 0; i < 10; ++i) {
    if (watch_qmi_data_ready() &&
        watch_qmi_read_accelerometer(
          x,
          y,
          z)) {
      sampleOk = true;
      break;
    }
    delay(20);
  }

  if (!sampleOk) {
    USBSerial.println(
      "[WATCH] QMI8658 detected but no accelerometer sample");
    return false;
  }

  watchAccel.x = x;
  watchAccel.y = y;
  watchAccel.z = z;

  watchImuReady = true;
  watch_raise_reset_state();

  USBSerial.print(
    "[WATCH] QMI8658 built-in driver READY @ 0x");
  USBSerial.print(
    watchQmiAddress,
    HEX);
  USBSerial.print(
    " | sensitivity=");
  USBSerial.println(
    watch_raise_sensitivity_label(
      watchRaiseSensitivity));

  return true;
}

static void watch_motion_service() {
  if (!watchImuReady ||
      !watchRaiseToWake ||
      watchScreenOn) {
    return;
  }

  uint32_t now = millis();

  if ((now - watchLastMotionSampleMs) <
      WATCH_RAISE_SAMPLE_MS) {
    return;
  }
  watchLastMotionSampleMs = now;

  if (!watch_qmi_data_ready()) {
    return;
  }

  if (!watch_qmi_read_accelerometer(
        watchAccel.x,
        watchAccel.y,
        watchAccel.z)) {
    return;
  }

  float ax = watchAccel.x;
  float ay = watchAccel.y;
  float az = watchAccel.z;

  float accelMag =
    sqrtf(ax * ax + ay * ay + az * az);

  // A valid stationary gravity vector should be close to 1 g.
  // Very large shocks are ignored instead of being treated as a raise.
  if (accelMag < 0.25f ||
      accelMag > 2.20f) {
    watchHavePrevAccel = false;
    watchRaiseCandidate = false;
    watchRaiseSettleSamples = 0;
    watchRaiseLastCandidateEndMs = now;
    return;
  }

  float nx, ny, nz;
  watch_normalize3(
    ax,
    ay,
    az,
    nx,
    ny,
    nz);

  if (!watchHavePrevAccel) {
    watchPrevAx = ax;
    watchPrevAy = ay;
    watchPrevAz = az;

    watchRaiseBaseX = nx;
    watchRaiseBaseY = ny;
    watchRaiseBaseZ = nz;
    watchRaiseHaveBase = true;

    watchHavePrevAccel = true;
    return;
  }

  float prevNx, prevNy, prevNz;
  watch_normalize3(
    watchPrevAx,
    watchPrevAy,
    watchPrevAz,
    prevNx,
    prevNy,
    prevNz);

  float dx = ax - watchPrevAx;
  float dy = ay - watchPrevAy;
  float dz = az - watchPrevAz;

  float movement =
    sqrtf(dx * dx + dy * dy + dz * dz);

  float stepAngleDeg =
    watch_vector_angle_deg(
      prevNx,
      prevNy,
      prevNz,
      nx,
      ny,
      nz);

  watchPrevAx = ax;
  watchPrevAy = ay;
  watchPrevAz = az;

  if (!watchRaiseHaveBase) {
    watchRaiseBaseX = nx;
    watchRaiseBaseY = ny;
    watchRaiseBaseZ = nz;
    watchRaiseHaveBase = true;
  }

  float baseAngleDeg =
    watch_vector_angle_deg(
      watchRaiseBaseX,
      watchRaiseBaseY,
      watchRaiseBaseZ,
      nx,
      ny,
      nz);

  // Ignore the first fraction of a second after screen-off so the motion
  // that caused the timeout cannot immediately wake the display again.
  if ((now - watchScreenOffMs) <
      WATCH_RAISE_ARM_DELAY_MS) {
    watchRaiseBaseX = nx;
    watchRaiseBaseY = ny;
    watchRaiseBaseZ = nz;
    watchRaiseCandidate = false;
    watchRaiseSettleSamples = 0;
    return;
  }

  if (!watchRaiseCandidate) {
    // While the wrist is quiet, slowly track its resting orientation.
    bool quiet =
      movement < 0.075f &&
      fabsf(accelMag - 1.0f) < 0.18f &&
      stepAngleDeg < 5.0f;

    if (quiet) {
      const float alpha = 0.08f;

      float bx =
        watchRaiseBaseX * (1.0f - alpha)
        + nx * alpha;
      float by =
        watchRaiseBaseY * (1.0f - alpha)
        + ny * alpha;
      float bz =
        watchRaiseBaseZ * (1.0f - alpha)
        + nz * alpha;

      watch_normalize3(
        bx,
        by,
        bz,
        watchRaiseBaseX,
        watchRaiseBaseY,
        watchRaiseBaseZ);
    }

    bool retryReady =
      (now - watchRaiseLastCandidateEndMs) >=
      WATCH_RAISE_RETRY_DELAY_MS;

    bool deliberateStart =
      movement >=
        watch_raise_start_movement_threshold()
      ||
      stepAngleDeg >=
        watch_raise_step_angle_threshold_deg();

    if (retryReady && deliberateStart) {
      watchRaiseCandidate = true;
      watchRaiseCandidateStartedMs = now;
      watchRaisePeakAngleDeg = baseAngleDeg;
      watchRaiseSettleSamples = 0;
    }

    return;
  }

  // Candidate gesture is active.
  if (baseAngleDeg > watchRaisePeakAngleDeg) {
    watchRaisePeakAngleDeg = baseAngleDeg;
  }

  uint32_t gestureMs =
    now - watchRaiseCandidateStartedMs;

  if (gestureMs > WATCH_RAISE_MAX_GESTURE_MS) {
    watchRaiseCandidate = false;
    watchRaiseLastCandidateEndMs = now;
    watchRaiseSettleSamples = 0;

    // Treat the new orientation as the next resting reference.
    watchRaiseBaseX = nx;
    watchRaiseBaseY = ny;
    watchRaiseBaseZ = nz;
    return;
  }

  bool enoughRotation =
    watchRaisePeakAngleDeg >=
    watch_raise_angle_threshold_deg();

  bool gravityLooksSettled =
    fabsf(accelMag - 1.0f) < 0.20f;

  bool movementSettled =
    movement <=
      watch_raise_settle_movement_threshold();

  bool angleSettled =
    stepAngleDeg < 7.0f;

  if (enoughRotation &&
      gravityLooksSettled &&
      movementSettled &&
      angleSettled) {
    if (watchRaiseSettleSamples < 10) {
      watchRaiseSettleSamples++;
    }
  } else {
    watchRaiseSettleSamples = 0;
  }

  // Roughly 3 consecutive settled samples at ~28 Hz prevents a quick
  // bump or steering-wheel vibration from waking the screen.
  if (gestureMs >= WATCH_RAISE_MIN_GESTURE_MS &&
      watchRaiseSettleSamples >= 3) {
    USBSerial.print(
      "[WATCH] Raise-to-wake | angle=");
    USBSerial.print(
      watchRaisePeakAngleDeg,
      1);
    USBSerial.print(
      " deg | sensitivity=");
    USBSerial.println(
      watch_raise_sensitivity_label(
        watchRaiseSensitivity));

    watch_screen_wake();
    return;
  }
}

static void watch_display_service() {
  watch_motion_service();

  // Keep the display awake during a firmware write so status remains visible
  // and the watch cannot enter its normal timeout path mid-update.
  if (watchOtaUploadActive || watchFwInstallActive) {
    if (!watchScreenOn) {
      watch_screen_wake();
    }

    watchLastActivityMs =
      millis();
    return;
  }

  // While USB/VBUS is present, keep the watch awake. The charging screen
  // itself may have been intentionally dismissed with PWR for this cable
  // session, in which case normal HOME/pages remain usable.
  if (watchBatteryVbusPresent) {
    if (!watchScreenOn) {
      watch_screen_wake();
    }

    watchLastActivityMs =
      millis();
    return;
  }

  if (!watchScreenOn) {
    return;
  }

  if (watchScreenTimeoutSec == 0) {
    return;
  }

  if (watchKeepAwakeBf1 &&
      activePageId == PAGE_TPMS &&
      tpmsPageMode == TPMS_MODE_BF1_RADAR) {
    watchLastActivityMs = millis();
    return;
  }

  if ((millis() - watchLastActivityMs) >=
      (watchScreenTimeoutSec * 1000UL)) {
    watch_screen_off();
  }
}

static const char *watch_boot_button_page_label(
    SideButtonPage page) {
  switch (page) {
    case SIDE_BUTTON_VITALS:  return "VITALS";
    case SIDE_BUTTON_ENGINE:  return "ENGINE";
    case SIDE_BUTTON_TPMS:    return "TPMS";
    case SIDE_BUTTON_SESSION: return "SESSION";
    case SIDE_BUTTON_HOME:
    default:                  return "HOME";
  }
}

static PageId watch_boot_button_target_page(
    SideButtonPage page) {
  switch (page) {
    case SIDE_BUTTON_VITALS:  return PAGE_VITALS;
    case SIDE_BUTTON_ENGINE:  return PAGE_ENGINE;
    case SIDE_BUTTON_TPMS:    return PAGE_TPMS;
    case SIDE_BUTTON_SESSION: return PAGE_SESSION;
    case SIDE_BUTTON_HOME:
    default:                  return PAGE_HOME;
  }
}

static void watch_boot_button_service() {
  bool readingHigh =
    (digitalRead(WATCH_BOOT_BUTTON_PIN) != LOW);

  uint32_t now = millis();

  if (readingHigh != watchBootButtonLastReadingHigh) {
    watchBootButtonLastReadingHigh = readingHigh;
    watchBootButtonLastChangeMs = now;
  }

  if ((now - watchBootButtonLastChangeMs) <
      WATCH_BOOT_DEBOUNCE_MS) {
    return;
  }

  if (readingHigh == watchBootButtonStableHigh) {
    return;
  }

  watchBootButtonStableHigh = readingHigh;

  if (!watchBootButtonStableHigh) {
    watchBootButtonPressStartedMs = now;
    return;
  }

  uint32_t pressMs =
    now - watchBootButtonPressStartedMs;

  if (pressMs < WATCH_BOOT_DEBOUNCE_MS ||
      pressMs > WATCH_BOOT_MAX_SHORT_PRESS_MS) {
    return;
  }

  // Don't change pages behind the Wi-Fi password editor.
  if (wifiPasswordOverlay) {
    return;
  }

  if (!watchScreenOn) {
    // BOOT wake is wake-only: return to exactly the page that was
    // visible before sleep. Do not activate the configured shortcut.
    watch_screen_wake();
    return;
  }

  watch_note_activity();

  // GPIO0 is the physical BOOT button.
  // While awake it runs the user-selected shortcut from General Settings.
  // While asleep it remains wake-only so an accidental wake does not
  // immediately navigate away from the page the tech was reviewing.
  build_page(
    watch_boot_button_target_page(
      watchBootButtonPage));
}


static bool watch_axp_read_reg(
    uint8_t reg,
    uint8_t &value) {
  Wire.beginTransmission(
    WATCH_AXP2101_ADDR);
  Wire.write(reg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  if (Wire.requestFrom(
        (int)WATCH_AXP2101_ADDR,
        1) != 1) {
    return false;
  }

  value =
    (uint8_t)Wire.read();

  return true;
}

static bool watch_axp_write_reg(
    uint8_t reg,
    uint8_t value) {
  Wire.beginTransmission(
    WATCH_AXP2101_ADDR);
  Wire.write(reg);
  Wire.write(value);

  return Wire.endTransmission() == 0;
}

static bool watch_axp_update_bits(
    uint8_t reg,
    uint8_t clearMask,
    uint8_t setMask) {
  uint8_t value = 0;

  if (!watch_axp_read_reg(
        reg,
        value)) {
    return false;
  }

  value &= (uint8_t)~clearMask;
  value |= setMask;

  return watch_axp_write_reg(
    reg,
    value);
}

static bool watch_apply_charge_profile() {
  bool ok = true;

  // Make sure cell-battery charging remains enabled.
  // REG18 bit1 = Cell Battery charge enable.
  ok &=
    watch_axp_update_bits(
      WATCH_AXP2101_CHARGER_CTRL,
      0x02,
      0x02);

  // REG62[4:0] = constant-current charge limit.
  // 00100b = 100mA.
  ok &=
    watch_axp_update_bits(
      WATCH_AXP2101_CHARGE_CURRENT,
      0x1F,
      WATCH_AXP2101_CHARGE_CURRENT_CODE);

  // REG64[2:0] = constant-voltage target.
  // 011b = 4.20V.
  ok &=
    watch_axp_update_bits(
      WATCH_AXP2101_CHARGE_VOLTAGE,
      0x07,
      WATCH_AXP2101_CHARGE_VOLTAGE_CODE);

  if (!ok) {
    USBSerial.println(
      "[WATCH] AXP2101 charge-profile write FAILED");
    return false;
  }

  uint8_t chargerCtrl = 0;
  uint8_t currentReg = 0;
  uint8_t voltageReg = 0;

  bool verifyOk =
    watch_axp_read_reg(
      WATCH_AXP2101_CHARGER_CTRL,
      chargerCtrl)
    &&
    watch_axp_read_reg(
      WATCH_AXP2101_CHARGE_CURRENT,
      currentReg)
    &&
    watch_axp_read_reg(
      WATCH_AXP2101_CHARGE_VOLTAGE,
      voltageReg);

  verifyOk =
    verifyOk
    &&
    ((chargerCtrl & 0x02) != 0)
    &&
    ((currentReg & 0x1F) ==
      WATCH_AXP2101_CHARGE_CURRENT_CODE)
    &&
    ((voltageReg & 0x07) ==
      WATCH_AXP2101_CHARGE_VOLTAGE_CODE);

  if (!verifyOk) {
    USBSerial.println(
      "[WATCH] AXP2101 charge-profile verify FAILED");
    return false;
  }

  USBSerial.print(
    "[WATCH] Battery profile: ");
  USBSerial.print(
    WATCH_BATTERY_CAPACITY_MAH);
  USBSerial.print(
    "mAh | charge=");
  USBSerial.print(
    WATCH_CHARGE_CURRENT_MA);
  USBSerial.print(
    "mA | CV=");
  USBSerial.print(
    WATCH_CHARGE_VOLTAGE_MV);
  USBSerial.println(
    "mV");

  return true;
}

static lv_color_t watch_battery_color(
    int pct,
    bool charging) {
  if (charging) {
    return C_GREEN;
  }

  if (pct >= 0 && pct <= 20) {
    return C_RED;
  }

  if (pct >= 0 && pct <= 40) {
    return C_AMBER;
  }

  return C_TEXT;
}

static void watch_battery_header_render() {
  if (!batteryHeaderContainer ||
      !batteryHeaderPercentLabel ||
      !batteryHeaderOutline ||
      !batteryHeaderFill ||
      !batteryHeaderTip) {
    return;
  }

  char pctText[8];

  if (!watchBatteryConnected ||
      watchBatteryPct < 0 ||
      watchBatteryPct > 100) {
    snprintf(
      pctText,
      sizeof(pctText),
      "--");
  } else {
    snprintf(
      pctText,
      sizeof(pctText),
      "%d%%",
      watchBatteryPct);
  }

  lv_label_set_text(
    batteryHeaderPercentLabel,
    pctText);

  lv_color_t batteryColor =
    watch_battery_color(
      watchBatteryPct,
      watchBatteryCharging);

  lv_obj_set_style_text_color(
    batteryHeaderPercentLabel,
    watchBatteryVbusPresent
      ? C_GREEN
      : batteryColor,
    0);

  lv_obj_set_style_border_color(
    batteryHeaderOutline,
    watchBatteryVbusPresent
      ? C_GREEN
      : batteryColor,
    0);

  lv_obj_set_style_bg_color(
    batteryHeaderTip,
    watchBatteryVbusPresent
      ? C_GREEN
      : batteryColor,
    0);

  int fillPct = 0;

  if (watchBatteryCharging) {
    // Four-step fill sweep while the charger is actively charging.
    static const uint8_t animPct[4] = {
      20, 45, 70, 100
    };

    fillPct =
      animPct[
        watchBatteryAnimStep & 0x03];
  } else if (watchBatteryConnected &&
             watchBatteryPct >= 0 &&
             watchBatteryPct <= 100) {
    fillPct =
      watchBatteryPct;
  }

  // The percentage now lives inside a wider battery outline.
  // Keep a small internal margin so the fill never touches the border.
  int fillWidth =
    (38 * fillPct) / 100;

  if (fillPct > 0 &&
      fillWidth < 2) {
    fillWidth = 2;
  }

  if (fillWidth > 38) {
    fillWidth = 38;
  }

  lv_obj_set_width(
    batteryHeaderFill,
    fillWidth);

  lv_obj_set_style_bg_color(
    batteryHeaderFill,
    watchBatteryVbusPresent
      ? C_GREEN
      : batteryColor,
    0);

  // Use a translucent fill so the centered percentage remains readable
  // across both the filled and unfilled portions of the icon.
  lv_obj_set_style_opa(
    batteryHeaderFill,
    fillWidth > 0
      ? LV_OPA_40
      : LV_OPA_TRANSP,
    0);

  // Keep the percentage above the animated fill.
  lv_obj_move_foreground(
    batteryHeaderPercentLabel);
}


