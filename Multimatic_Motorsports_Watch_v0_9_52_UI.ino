static void build_settings_root(lv_obj_t *parent) {
  add_page_header(
    parent,
    "// SETTINGS",
    "CONNECTIVITY & WATCH");
  add_red_divider(parent);

  make_section_label(parent, "CONNECTIONS");

  char wifiSub[48];
  if (WiFi.status() == WL_CONNECTED) {
    snprintf(
      wifiSub,
      sizeof(wifiSub),
      "Connected: %s",
      WiFi.SSID().c_str());
  } else {
    snprintf(
      wifiSub,
      sizeof(wifiSub),
      "%s",
      wifiSavedSsid.length() > 0
        ? "Saved network / offline"
        : "Select a wireless network");
  }

  settings_category_tile(
    parent,
    LV_SYMBOL_WIFI,
    "WI-FI",
    wifiSub,
    SETTINGS_SECTION_WIFI,
    C_BLUE);

  settings_category_tile(
    parent,
    LV_SYMBOL_BLUETOOTH,
    "BLUETOOTH",
    settingsBleSelectedMac.length() > 0
      ? "Gateway / peer selected"
      : "Scan and select a device",
    SETTINGS_SECTION_BLUETOOTH,
    C_BLUE);

  make_section_label(parent, "WATCH");

  char generalSub[64];
  snprintf(
    generalSub,
    sizeof(generalSub),
    "%u%% brightness  /  %s shutoff",
    watchBrightnessPct,
    watch_timeout_label(watchScreenTimeoutSec));

  settings_category_tile(
    parent,
    LV_SYMBOL_SETTINGS,
    "GENERAL",
    generalSub,
    SETTINGS_SECTION_GENERAL,
    C_RED);

  char batterySub[80];
  watch_battery_format_settings_subtitle(
    batterySub,
    sizeof(batterySub));

  settings_category_tile(
    parent,
    "B",
    "BATTERY",
    batterySub,
    SETTINGS_SECTION_BATTERY,
    watch_battery_color(
      watchBatteryPct,
      watchBatteryCharging));

  char clockSub[64];
  char clockDate[20];
  char clockTime[12];
  watch_time_format_current(
    clockDate,
    sizeof(clockDate),
    clockTime,
    sizeof(clockTime));
  snprintf(
    clockSub,
    sizeof(clockSub),
    "%s  /  %s",
    clockDate,
    clockTime);

  settings_category_tile(
    parent,
    "T",
    "TIME & DATE",
    clockSub,
    SETTINGS_SECTION_TIME_DATE,
    C_AMBER);

  make_section_label(
    parent,
    "MAINTENANCE");

  char firmwareSub[80];

  if (watchOtaSessionEnabled &&
      watchOtaServerRunning) {
    snprintf(
      firmwareSub,
      sizeof(firmwareSub),
      "OTA ready  /  %s",
      WiFi.localIP().toString().c_str());
  } else if (
      watchOtaSessionEnabled) {
    snprintf(
      firmwareSub,
      sizeof(firmwareSub),
      "OTA armed / waiting for Wi-Fi");
  } else {
    snprintf(
      firmwareSub,
      sizeof(firmwareSub),
      "%s  /  local Wi-Fi update",
      WATCH_FIRMWARE_VERSION);
  }

  settings_category_tile(
    parent,
    "F",
    "FIRMWARE UPDATE",
    firmwareSub,
    SETTINGS_SECTION_FIRMWARE,
    C_GREEN);

  add_bottom_nav(parent, PAGE_SETTINGS);
}

