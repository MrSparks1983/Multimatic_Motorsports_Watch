// -------------------- ONBOARD SPEAKER / ES8311 --------------------
//
// Waveshare ESP32-S3-Touch-AMOLED-2.06 audio pinout:
//   I2S BCLK  = GPIO41
//   I2S WS    = GPIO45
//   I2S DOUT  = GPIO40
//   I2S MCLK  = GPIO16
//   Speaker PA enable = GPIO46
//   ES8311 I2C address = 0x18
//
// This intentionally enables speaker playback only. The ES7210 microphones
// are not initialized, so the watch does not reserve or use the microphone
// input path yet.
//
// The codec and I2S output are initialized at boot, but the external speaker
// amplifier is left muted/off until watch_audio_output_enable(true) is called.
// That gives future alerts immediate access to the speaker without leaving the
// power amplifier active while the watch is silent.

static const uint8_t WATCH_ES8311_ADDR =
  0x18;

static const int WATCH_AUDIO_BCLK_PIN =
  41;
static const int WATCH_AUDIO_WS_PIN =
  45;
static const int WATCH_AUDIO_DOUT_PIN =
  40;
static const int WATCH_AUDIO_MCLK_PIN =
  16;
static const int WATCH_AUDIO_PA_PIN =
  46;

static const uint32_t WATCH_AUDIO_SAMPLE_RATE =
  16000UL;
static const uint8_t WATCH_AUDIO_DEFAULT_VOLUME =
  70;

static I2SClass watchAudioI2S;
static bool watchAudioReady = false;
static bool watchAudioOutputEnabled = false;

static bool watch_es8311_write(
    uint8_t reg,
    uint8_t value) {
  Wire.beginTransmission(
    WATCH_ES8311_ADDR);
  Wire.write(reg);
  Wire.write(value);

  return Wire.endTransmission(
           true) == 0;
}

static bool watch_es8311_read(
    uint8_t reg,
    uint8_t &value) {
  Wire.beginTransmission(
    WATCH_ES8311_ADDR);
  Wire.write(reg);

  if (Wire.endTransmission(
        false) != 0) {
    return false;
  }

  if (Wire.requestFrom(
        WATCH_ES8311_ADDR,
        (uint8_t)1) != 1) {
    return false;
  }

  value =
    (uint8_t)Wire.read();

  return true;
}

static bool watch_es8311_set_mute(
    bool muted) {
  uint8_t reg31 = 0;

  if (!watch_es8311_read(
        0x31,
        reg31)) {
    return false;
  }

  if (muted) {
    reg31 |= 0x60;
  } else {
    reg31 &= (uint8_t)~0x60;
  }

  return watch_es8311_write(
    0x31,
    reg31);
}

static bool watch_es8311_set_volume(
    uint8_t volume) {
  if (volume > 100) {
    volume = 100;
  }

  uint8_t reg32 = 0;

  if (volume > 0) {
    reg32 =
      (uint8_t)(
        ((uint16_t)volume * 256U) /
        100U -
        1U);
  }

  return watch_es8311_write(
    0x32,
    reg32);
}

static bool watch_es8311_init_speaker() {
  uint8_t reg = 0;

  // Reset and power-on sequence from the official ES8311 driver.
  if (!watch_es8311_write(0x00, 0x1F)) return false;
  delay(2);
  if (!watch_es8311_write(0x00, 0x00)) return false;
  delay(2);
  if (!watch_es8311_write(0x00, 0x80)) return false;
  delay(5);

  // Clock source: MCLK pin, normal polarity, all clocks enabled.
  if (!watch_es8311_write(0x01, 0x3F)) return false;

  // 16 kHz audio with 4.096 MHz MCLK (sample rate * 256).
  // Coefficients match Waveshare/Espressif's ES8311 driver table.
  if (!watch_es8311_read(0x02, reg)) return false;
  reg &= 0x07;
  if (!watch_es8311_write(0x02, reg)) return false;
  if (!watch_es8311_write(0x03, 0x10)) return false;
  if (!watch_es8311_write(0x04, 0x10)) return false;
  if (!watch_es8311_write(0x05, 0x00)) return false;

  if (!watch_es8311_read(0x06, reg)) return false;
  reg &= 0xC0;
  reg |= 0x03;
  if (!watch_es8311_write(0x06, reg)) return false;

  if (!watch_es8311_read(0x07, reg)) return false;
  reg &= 0xC0;
  if (!watch_es8311_write(0x07, reg)) return false;
  if (!watch_es8311_write(0x08, 0xFF)) return false;

  // Slave I2S, 16-bit input/output serial format.
  if (!watch_es8311_read(0x00, reg)) return false;
  reg &= 0xBF;
  if (!watch_es8311_write(0x00, reg)) return false;
  if (!watch_es8311_write(0x09, 0x0C)) return false;
  if (!watch_es8311_write(0x0A, 0x0C)) return false;

  // Power the analog/DAC/output path.
  if (!watch_es8311_write(0x0D, 0x01)) return false;
  if (!watch_es8311_write(0x0E, 0x02)) return false;
  if (!watch_es8311_write(0x12, 0x00)) return false;
  if (!watch_es8311_write(0x13, 0x10)) return false;
  if (!watch_es8311_write(0x1C, 0x6A)) return false;
  if (!watch_es8311_write(0x37, 0x08)) return false;

  if (!watch_es8311_set_volume(
        WATCH_AUDIO_DEFAULT_VOLUME)) {
    return false;
  }

  // Start muted. The PA is enabled only while future audio is playing.
  if (!watch_es8311_set_mute(
        true)) {
    return false;
  }

  return true;
}

static void watch_audio_output_enable(
    bool enabled) {
  if (!watchAudioReady) {
    digitalWrite(
      WATCH_AUDIO_PA_PIN,
      LOW);
    watchAudioOutputEnabled =
      false;
    return;
  }

  if (enabled) {
    // Unmute the codec before bringing up the speaker amplifier.
    if (!watch_es8311_set_mute(
          false)) {
      USBSerial.println(
        "[WATCH] ES8311 unmute failed");
      digitalWrite(
        WATCH_AUDIO_PA_PIN,
        LOW);
      watchAudioOutputEnabled =
        false;
      return;
    }

    delay(2);
    digitalWrite(
      WATCH_AUDIO_PA_PIN,
      HIGH);
    watchAudioOutputEnabled =
      true;
  } else {
    digitalWrite(
      WATCH_AUDIO_PA_PIN,
      LOW);
    watch_es8311_set_mute(
      true);
    watchAudioOutputEnabled =
      false;
  }
}

static void watch_audio_init() {
  watchAudioReady = false;
  watchAudioOutputEnabled = false;

  pinMode(
    WATCH_AUDIO_PA_PIN,
    OUTPUT);
  digitalWrite(
    WATCH_AUDIO_PA_PIN,
    LOW);

  // Use the exact I2S output pins from Waveshare's official 08_ES8311
  // Arduino example. DIN is intentionally -1 because microphone capture
  // is not being enabled in this firmware.
  watchAudioI2S.setPins(
    WATCH_AUDIO_BCLK_PIN,
    WATCH_AUDIO_WS_PIN,
    WATCH_AUDIO_DOUT_PIN,
    -1,
    WATCH_AUDIO_MCLK_PIN);

  if (!watchAudioI2S.begin(
        I2S_MODE_STD,
        WATCH_AUDIO_SAMPLE_RATE,
        I2S_DATA_BIT_WIDTH_16BIT,
        I2S_SLOT_MODE_STEREO,
        I2S_STD_SLOT_BOTH)) {
    USBSerial.println(
      "[WATCH] Speaker I2S initialization failed");
    return;
  }

  if (!watch_es8311_init_speaker()) {
    USBSerial.println(
      "[WATCH] ES8311 speaker codec initialization failed");
    watchAudioI2S.end();
    return;
  }

  watchAudioReady = true;

  // Speaker subsystem is initialized and ready, but remains silent until
  // a future alert explicitly enables the power amplifier.
  watch_audio_output_enable(
    false);

  USBSerial.println(
    "[WATCH] ES8311 speaker ready (silent / PA standby)");
}


