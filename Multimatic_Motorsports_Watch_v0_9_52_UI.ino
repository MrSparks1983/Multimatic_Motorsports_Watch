// -------------------- CREW HEADER NOTIFICATION --------------------

static void update_crew_header_notification() {
  if (!crewHeaderButton || !crewHeaderBadge || !crewHeaderBadgeText) return;

  if (crewUnreadCount > 0) {
    char countText[6];
    snprintf(countText, sizeof(countText), "%d", crewUnreadCount);

    lv_obj_clear_flag(crewHeaderBadge, LV_OBJ_FLAG_HIDDEN);
    lv_label_set_text(crewHeaderBadgeText, countText);
    lv_obj_set_style_text_color(crewHeaderButton, C_TEXT, 0);
  } else {
    lv_obj_add_flag(crewHeaderBadge, LV_OBJ_FLAG_HIDDEN);
    lv_obj_set_style_text_color(crewHeaderButton, C_MUTED, 0);
  }
}

static void crew_ui_set_unread(int count) {
  crewUnreadCount = count < 0 ? 0 : count;
  update_crew_header_notification();
}

static void crew_ui_increment_unread() {
  if (crewUnreadCount < 99) crewUnreadCount++;
  update_crew_header_notification();
}

static void crew_header_event_cb(lv_event_t *e) {
  LV_UNUSED(e);
  crewUnreadCount = 0;
  update_crew_header_notification();
  build_page(PAGE_CREW);
}


// -------------------- BLE STATUS UI --------------------

static int ble_rssi_to_percent(int rssiDbm) {
  // Useful display mapping for a small status indicator:
  // <= -100 dBm = 0%, >= -50 dBm = 100%.
  if (rssiDbm <= -100) return 0;
  if (rssiDbm >= -50) return 100;
  return (rssiDbm + 100) * 2;
}

static lv_color_t ble_signal_color(int rssiDbm) {
  // Requested thresholds:
  // green = good, yellow = fair, red = poor.
  if (rssiDbm >= -65) return C_GREEN;
  if (rssiDbm >= -80) return C_AMBER;
  return C_RED;
}

static void update_ble_status_ui() {
  if (!bleStatusLabel) return;

  lv_label_set_text(
    bleStatusLabel,
    LV_SYMBOL_BLUETOOTH);

  // Requested header behavior:
  // grey = inactive / not connected
  // blue = actively connected
  switch (bleUiState) {
    case BLE_UI_CONNECTED:
      lv_obj_set_style_text_color(
        bleStatusLabel,
        C_BLUE,
        0);
      break;

    case BLE_UI_PAIRING:
      lv_obj_set_style_text_color(
        bleStatusLabel,
        bleFlashOn
          ? lv_color_hex(0x747D8B)
          : lv_color_hex(0x404750),
        0);
      break;

    case BLE_UI_SELECTED:
    case BLE_UI_DISCONNECTED:
    default:
      lv_obj_set_style_text_color(
        bleStatusLabel,
        lv_color_hex(0x596576),
        0);
      break;
  }

  if (bleSignalLabel) {
    lv_obj_add_flag(
      bleSignalLabel,
      LV_OBJ_FLAG_HIDDEN);
  }
}

static void update_wifi_header_ui() {
  if (!wifiHeaderIcon) return;

  lv_label_set_text(
    wifiHeaderIcon,
    LV_SYMBOL_WIFI);

  lv_obj_set_style_text_color(
    wifiHeaderIcon,
    WiFi.status() == WL_CONNECTED
      ? C_GREEN
      : lv_color_hex(0x596576),
    0);
}

// These are the calls the real BLE subsystem can use later.
static void ble_ui_set_pairing() {
  bleUiState = BLE_UI_PAIRING;
  bleFlashOn = true;
  blePairingStartedMs = millis();
  update_ble_status_ui();
}

static void ble_ui_set_selected() {
  bleUiState = BLE_UI_SELECTED;
  update_ble_status_ui();
}

static void ble_ui_set_connected(int rssiDbm) {
  bleUiState = BLE_UI_CONNECTED;
  bleUiRssiDbm = rssiDbm;
  update_ble_status_ui();
}

static void ble_ui_set_rssi(int rssiDbm) {
  bleUiRssiDbm = rssiDbm;
  if (bleUiState == BLE_UI_CONNECTED) update_ble_status_ui();
}

static void ble_ui_set_disconnected() {
  bleUiState = BLE_UI_DISCONNECTED;
  update_ble_status_ui();
}

static void ble_status_timer_cb(lv_timer_t *timer) {
  LV_UNUSED(timer);

  static unsigned long lastFlashMs = 0;

  if (bleUiState == BLE_UI_PAIRING) {
    if (millis() - lastFlashMs >= 400) {
      lastFlashMs = millis();
      bleFlashOn = !bleFlashOn;
      update_ble_status_ui();
    }

  }
}


// -------------------- HELPERS --------------------

static void set_pad(lv_obj_t *obj, int all) {
  lv_obj_set_style_pad_all(obj, all, 0);
}

static void style_transparent(lv_obj_t *obj) {
  lv_obj_set_style_bg_opa(obj, LV_OPA_TRANSP, 0);
  lv_obj_set_style_border_width(obj, 0, 0);
}

static lv_obj_t *make_label(lv_obj_t *parent,
                            const char *text,
                            int fontSize,
                            lv_color_t color) {
  lv_obj_t *label = lv_label_create(parent);
  lv_label_set_text(label, text);
  lv_obj_set_style_text_color(label, color, 0);

  if (fontSize >= 28) {
    lv_obj_set_style_text_font(label, &lv_font_montserrat_28, 0);
  } else if (fontSize >= 24) {
    lv_obj_set_style_text_font(label, &lv_font_montserrat_24, 0);
  } else if (fontSize >= 20) {
    lv_obj_set_style_text_font(label, &lv_font_montserrat_20, 0);
  } else if (fontSize >= 18) {
    lv_obj_set_style_text_font(label, &lv_font_montserrat_18, 0);
  } else if (fontSize >= 16) {
    lv_obj_set_style_text_font(label, &lv_font_montserrat_16, 0);
  } else if (fontSize >= 14) {
    lv_obj_set_style_text_font(label, &lv_font_montserrat_14, 0);
  } else if (fontSize >= 13) {
    // LVGL does not provide Montserrat 13 in this build.
    // Round important 13px requests UP to 14px instead of down to 12px.
    lv_obj_set_style_text_font(label, &lv_font_montserrat_14, 0);
  } else {
    lv_obj_set_style_text_font(label, &lv_font_montserrat_12, 0);
  }

  return label;
}

static lv_obj_t *make_card(lv_obj_t *parent, int height = LV_SIZE_CONTENT) {
  lv_obj_t *card = lv_obj_create(parent);
  lv_obj_set_width(card, LV_PCT(100));
  if (height != LV_SIZE_CONTENT) lv_obj_set_height(card, height);

  lv_obj_set_style_bg_color(card, C_CARD, 0);
  lv_obj_set_style_bg_opa(card, LV_OPA_COVER, 0);
  lv_obj_set_style_border_color(card, C_BORDER, 0);
  lv_obj_set_style_border_width(card, 1, 0);
  lv_obj_set_style_radius(card, 16, 0);
  set_pad(card, 12);

  // Cards are presentation containers, not independent scroll areas.
  // Vertical swipes anywhere on a card should move the containing page.
  lv_obj_clear_flag(card, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_set_scrollbar_mode(card, LV_SCROLLBAR_MODE_OFF);

  return card;
}

static lv_obj_t *make_section_label(lv_obj_t *parent, const char *text) {
  lv_obj_t *label = make_label(parent, text, 14, C_MUTED);
  lv_obj_set_style_pad_top(label, 10, 0);
  lv_obj_set_style_pad_bottom(label, 2, 0);
  return label;
}

static lv_obj_t *make_vital_card(lv_obj_t *parent,
                                 const char *name,
                                 const char *value,
                                 const char *unit,
                                 lv_color_t valueColor = lv_color_white()) {
  lv_obj_t *card = make_card(parent, 112);

  lv_obj_set_layout(card, LV_LAYOUT_FLEX);
  lv_obj_set_flex_flow(card, LV_FLEX_FLOW_COLUMN);
  lv_obj_set_flex_align(card,
                        LV_FLEX_ALIGN_START,
                        LV_FLEX_ALIGN_START,
                        LV_FLEX_ALIGN_START);

  lv_obj_t *nameLabel = make_label(card, name, 14, C_MUTED);
  lv_obj_set_style_text_letter_space(nameLabel, 1, 0);

  lv_obj_t *row = lv_obj_create(card);
  style_transparent(row);
  lv_obj_set_width(row, LV_PCT(100));
  lv_obj_set_height(row, 42);
  set_pad(row, 0);
  lv_obj_set_layout(row, LV_LAYOUT_FLEX);
  lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);
  lv_obj_set_flex_align(row,
                        LV_FLEX_ALIGN_START,
                        LV_FLEX_ALIGN_END,
                        LV_FLEX_ALIGN_CENTER);
  lv_obj_clear_flag(row, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_set_scrollbar_mode(row, LV_SCROLLBAR_MODE_OFF);

  make_label(row, value, 28, valueColor);
  make_label(row, unit, 14, C_MUTED);

  return card;
}

static lv_obj_t *make_two_col_grid(lv_obj_t *parent) {
  static int32_t col_dsc[] = { LV_GRID_FR(1), LV_GRID_FR(1), LV_GRID_TEMPLATE_LAST };
  static int32_t row_dsc[] = {
    LV_GRID_CONTENT, LV_GRID_CONTENT, LV_GRID_CONTENT,
    LV_GRID_CONTENT, LV_GRID_CONTENT, LV_GRID_CONTENT,
    LV_GRID_TEMPLATE_LAST
  };

  lv_obj_t *grid = lv_obj_create(parent);
  style_transparent(grid);
  lv_obj_set_width(grid, LV_PCT(100));
  lv_obj_set_height(grid, LV_SIZE_CONTENT);
  set_pad(grid, 0);
  lv_obj_set_style_pad_column(grid, 8, 0);
  lv_obj_set_style_pad_row(grid, 8, 0);
  lv_obj_set_grid_dsc_array(grid, col_dsc, row_dsc);

  // The outer page owns scrolling; grid containers stay fixed.
  lv_obj_clear_flag(grid, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_set_scrollbar_mode(grid, LV_SCROLLBAR_MODE_OFF);

  return grid;
}

static void add_grid_item(lv_obj_t *grid,
                          lv_obj_t *item,
