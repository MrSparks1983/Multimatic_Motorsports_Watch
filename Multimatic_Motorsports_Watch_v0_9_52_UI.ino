static void header_quick_panel_toggle() {
  if (headerQuickPanel) {
    header_quick_panel_hide();
  } else {
    header_quick_panel_show();
  }
}

static void header_pull_handle_event_cb(
    lv_event_t *e) {
  LV_UNUSED(e);

  watch_note_activity();
  header_quick_panel_toggle();
}

static void header_pull_gesture_cb(
    lv_event_t *e) {
  LV_UNUSED(e);

  lv_indev_t *indev =
    lv_indev_active();

  if (!indev) {
    return;
  }

  lv_dir_t dir =
    lv_indev_get_gesture_dir(
      indev);

  if (dir == LV_DIR_BOTTOM) {
    watch_note_activity();
    header_quick_panel_show();
    lv_indev_wait_release(
      indev);
  }
}

// -------------------- HEADER PAGE CONTROLS --------------------

static void update_header_home_for_page(PageId page) {
  LV_UNUSED(page);

  // PWR is HOME and Settings lives in the header pull-down, so the header
  // uses the same spacing on every page.
  if (statusTime) {
    lv_obj_align(
      statusTime,
      LV_ALIGN_LEFT_MID,
      12,
      0);
  }
}

// -------------------- PAGE MANAGEMENT --------------------

static void build_page(PageId page) {
  if (!pageBody) return;

  // Navigation closes the header pull-down.
  header_quick_panel_hide();

  // The radar animation owns child-object pointers. Stop its timer before
  // cleaning/rebuilding pageBody so it can never touch deleted LVGL objects.
  bf1_stop_radar_animation();

  activePageId = page;
  update_header_home_for_page(page);
  update_fixed_bottom_nav(page);

  lv_obj_clean(pageBody);
  lv_obj_scroll_to_y(pageBody, 0, LV_ANIM_OFF);

  if (page == PAGE_HOME) {
    lv_obj_clear_flag(pageBody, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_scrollbar_mode(pageBody, LV_SCROLLBAR_MODE_OFF);

    // Home does not need the extra bottom clearance used by scrollable
    // sub-pages, so reclaim that space for the four main tiles.
    lv_obj_set_style_pad_top(pageBody, 4, 0);
    lv_obj_set_style_pad_bottom(pageBody, 4, 0);
    lv_obj_set_style_pad_row(pageBody, 8, 0);
  } else {
    lv_obj_add_flag(pageBody, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_scroll_dir(pageBody, LV_DIR_VER);
    lv_obj_set_scrollbar_mode(pageBody, LV_SCROLLBAR_MODE_AUTO);

    // Restore normal sub-page spacing. Extra bottom padding ensures the
    // final content can scroll completely above the fixed bottom nav.
    lv_obj_set_style_pad_top(pageBody, 8, 0);
    lv_obj_set_style_pad_bottom(pageBody, 82, 0);
    lv_obj_set_style_pad_row(pageBody, 8, 0);
  }

  switch (page) {
    case PAGE_HOME:
      build_home(pageBody);
      break;
    case PAGE_ENGINE:
      build_engine(pageBody);
      break;
    case PAGE_TPMS:
      build_tpms(pageBody);
      break;
    case PAGE_SESSION:
      build_session(pageBody);
      break;
    case PAGE_CREW:
      crewUnreadCount = 0;
      update_crew_header_notification();
      build_crew(pageBody);
      break;
    case PAGE_SETTINGS:
      build_settings(pageBody);
      break;
    case PAGE_VITALS:
      build_vitals(pageBody);
      break;
    default:
      build_home(pageBody);
      break;
  }

  // Fixed navigation lives outside pageBody and never participates in page
  // scrolling. Keep it above ordinary sub-page content.
  if (fixedBottomNav &&
      page != PAGE_HOME) {
    lv_obj_move_foreground(
      fixedBottomNav);
  }

  // If charging standby is active, keep it above both pageBody and fixed nav.
  if (watchChargingScreen &&
      !watchChargingScreenDismissed) {
    lv_obj_move_foreground(
      watchChargingScreen);
  }

  // Fixed header stays above everything.
  if (headerStatusBar) {
    lv_obj_move_foreground(
      headerStatusBar);
  }
}

