void my_touchpad_read(lv_indev_t *indev, lv_indev_data_t *data) {
  LV_UNUSED(indev);

  int32_t touchX =
    FT3168->IIC_Read_Device_Value(
      FT3168->Arduino_IIC_Touch::Value_Information::TOUCH_COORDINATE_X
    );

  int32_t touchY =
    FT3168->IIC_Read_Device_Value(
      FT3168->Arduino_IIC_Touch::Value_Information::TOUCH_COORDINATE_Y
    );

  bool touchInterrupt =
    (FT3168->IIC_Interrupt_Flag == true);

  if (touchInterrupt) {
    FT3168->IIC_Interrupt_Flag = false;
  }

  // SCREEN-OFF TOUCH:
  // Wake the display only. Never pass this physical press to LVGL.
  if (!watchScreenOn) {
    if (touchInterrupt) {
      watch_screen_wake();
    }

    data->state = LV_INDEV_STATE_REL;
    return;
  }

  // WAKE GUARD:
  // The FT3168 can issue another interrupt while the same finger is still
  // on the glass. Ignore every press during the guard period so a wake tap
  // cannot become a VITALS/HOME/etc. click on the next LVGL read cycle.
  if (watchWakeTouchGuard) {
    data->state = LV_INDEV_STATE_REL;

    if ((millis() - watchWakeTouchGuardStartedMs) >=
        WATCH_WAKE_TOUCH_GUARD_MS) {
      watchWakeTouchGuard = false;
    }

    return;
  }

  if (touchInterrupt) {
    watch_note_activity();
    data->state = LV_INDEV_STATE_PR;

    // Keep FT3168 coordinates inside the 410x502 panel bounds.
    if (touchX < 0) touchX = 0;
    if (touchX > LCD_WIDTH - 1) touchX = LCD_WIDTH - 1;
    if (touchY < 0) touchY = 0;
    if (touchY > LCD_HEIGHT - 1) touchY = LCD_HEIGHT - 1;

    data->point.x = touchX;
    data->point.y = touchY;
  } else {
    data->state = LV_INDEV_STATE_REL;
  }
}

void rounder_event_cb(lv_event_t *e) {
  lv_area_t *area = (lv_area_t *)lv_event_get_param(e);

  uint16_t x1 = area->x1;
  uint16_t x2 = area->x2;
  uint16_t y1 = area->y1;
  uint16_t y2 = area->y2;

  area->x1 = (x1 >> 1) << 1;
  area->y1 = (y1 >> 1) << 1;
  area->x2 = ((x2 >> 1) << 1) + 1;
  area->y2 = ((y2 >> 1) << 1) + 1;
}


