static uint16_t settings_timeout_index_from_seconds(
    uint32_t seconds) {
  switch (seconds) {
    case 15:  return 0;
    case 30:  return 1;
    case 60:  return 2;
    case 120: return 3;
    case 300: return 4;
    case 0:   return 5;
    default:  return 1;
  }
}

static uint32_t settings_timeout_seconds_from_index(
    uint16_t index) {
  switch (index) {
    case 0:  return 15;
    case 1:  return 30;
    case 2:  return 60;
    case 3:  return 120;
    case 4:  return 300;
    case 5:  return 0;
    default: return 30;
  }
}

