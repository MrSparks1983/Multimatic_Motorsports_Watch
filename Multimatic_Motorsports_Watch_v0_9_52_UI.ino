static void header_panel_gesture_cb(
    lv_event_t *e) {
  LV_UNUSED(e);

  lv_indev_t *indev =
    lv_indev_active();

  if (!indev) {
    return;
  }

  lv_dir_t dir =
    lv_indev_get_gesture_dir(
      indev);

  if (dir == LV_DIR_TOP) {
    header_quick_panel_hide();
