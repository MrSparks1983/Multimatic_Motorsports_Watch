      watch_time_manual_dropdown(
        manual,
        "AM / PM",
        ampm,
        204,
        90,
        92,
        currentTm.tm_hour >= 12 ? 1 : 0);
  }

  lv_obj_t *manualHint =
    make_label(
      manual,
      "Applying manual time disables Auto Wi-Fi Sync.",
      10,
      C_MUTED);
  lv_obj_set_pos(
    manualHint,
    0,
    177);

  lv_obj_t *apply =
    lv_button_create(
