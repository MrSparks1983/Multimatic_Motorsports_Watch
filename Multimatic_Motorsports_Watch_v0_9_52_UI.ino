static void settings_time_manual_apply_cb(lv_event_t *e) {
  LV_UNUSED(e);

  if (!timeYearDropdown ||
      !timeMonthDropdown ||
      !timeDayDropdown ||
      !timeHourDropdown ||
      !timeMinuteDropdown ||
      (!watchTime24Hour && !timeAmPmDropdown)) {
    return;
  }

  int year =
    2024 +
    (int)lv_dropdown_get_selected(
      timeYearDropdown);

  int month =
    1 +
    (int)lv_dropdown_get_selected(
      timeMonthDropdown);

  int day =
    1 +
    (int)lv_dropdown_get_selected(
      timeDayDropdown);

  int hour = 0;

  if (watchTime24Hour) {
    hour =
      (int)lv_dropdown_get_selected(
        timeHourDropdown);
  } else {
    int hour12 =
      1 +
      (int)lv_dropdown_get_selected(
        timeHourDropdown);

    bool pm =
      lv_dropdown_get_selected(
        timeAmPmDropdown) == 1;

    hour =
      hour12 % 12;

    if (pm) {
      hour += 12;
    }
  }

  int minute =
    (int)lv_dropdown_get_selected(
      timeMinuteDropdown);

  if (day > watch_time_days_in_month(year, month)) {
    settingsStatusLine =
      "Invalid day for selected month";
    return;
  }

  struct tm manualTm;
  memset(&manualTm, 0, sizeof(manualTm));
  manualTm.tm_year = year - 1900;
  manualTm.tm_mon = month - 1;
  manualTm.tm_mday = day;
  manualTm.tm_hour = hour;
  manualTm.tm_min = minute;
  manualTm.tm_sec = 0;
  manualTm.tm_isdst = -1;

  if (!watch_time_set_system_local(manualTm)) {
    settingsStatusLine =
      "Manual date/time rejected";
    return;
  }

  time_t now = time(nullptr);
  struct tm localTm;
  localtime_r(&now, &localTm);
  watch_rtc_write_local(localTm);
  watchRtcReady = true;

  // Manual Apply intentionally disables automatic overwrite until the user
  // re-enables Auto Wi-Fi Sync.
  watchTimeAutoSync = false;
  watchTimeNtpPending = false;

  if (connectivityPrefsReady) {
    connectivityPrefs.putBool(
      "timeauto",
      false);
  }

  watch_time_header_update();
  settingsStatusLine =
    "Manual date/time saved to RTC";
  watch_note_activity();

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}

