static uint8_t bf1_cipher_hash8(uint8_t x, const uint8_t *key) {
  return key[x & 0x0F] ^ key[16 + (x >> 4)];
}

static uint8_t bf1_cipher_xor(const uint8_t *buffer, size_t len) {
  uint8_t acc = 0;
  for (size_t i = 0; i < len; i++) {
    acc ^= buffer[i];
  }
  return acc;
}

static bool bf1_cipher_decode(const uint8_t *inBuffer,
                              size_t len,
                              const uint8_t *key,
                              uint8_t *outBuffer) {
  if (!inBuffer || !key || !outBuffer || len == 0 || len > 13) {
    return false;
  }

  uint8_t b = bf1_cipher_xor(inBuffer, len);

  for (int num2 = 0; num2 < (int)len; num2++) {
    int num3 = (int)len - 1 - num2;

    b ^= inBuffer[num3];

    outBuffer[num3] =
      inBuffer[num3]
      ^ bf1_cipher_hash8((uint8_t)(b ^ num3), key);

    b ^= outBuffer[num3];
  }

  return true;
}

static bool bf1_parse_type73(const uint8_t *cipherText,
                             size_t cipherLen,
                             Bf1LiveData &data) {
  if (!cipherText || cipherLen == 0 || cipherLen > 13) {
    return false;
  }

  uint8_t plainText[13] = {0};

  if (!bf1_cipher_decode(
        cipherText,
        cipherLen,
        BF1_KEY_32,
        plainText)) {
    return false;
  }

  const uint8_t *a = plainText;

  // The proven BF1 packets provide these fields within the first 8 bytes.
  if (cipherLen < 8) {
    return false;
  }

  data.sequence = a[0] >> 2;

  data.batteryPct =
    ((((a[1] & 0x03) << 6) | (a[2] >> 2)) / 2.56f);

  data.tempC =
    ((((a[4] & 0x03) << 6) | (a[5] >> 2)) - 40);

  data.rawWord67 =
    ((a[6] & 0x1F) << 8) | a[7];

  int32_t diff =
    (int32_t)data.rawWord67 - 5315;

  if (diff >= 1024 && diff < 1400) {
    diff -= 1024;
  }

  if (diff < 0) {
    diff = 0;
  }

  data.pressurePsi = diff * 0.0707037f;
  data.pressureMbar = diff * 4.8748f;

  // Basic sanity checks keep random/corrupt advertisements out of the UI.
  if (data.batteryPct < 0.0f || data.batteryPct > 100.5f) return false;
  if (data.tempC < -60 || data.tempC > 180) return false;
  if (data.pressurePsi < 0.0f || data.pressurePsi > 150.0f) return false;

  return true;
}

class WatchBf1AdvertisedCallbacks : public BLEAdvertisedDeviceCallbacks {
public:
  void onResult(BLEAdvertisedDevice advertisedDevice) override {
    int rssi = advertisedDevice.getRSSI();

    // When Settings is performing a BLE discovery pass, collect nearby
    // devices before applying the BF1-specific Type-73 filter.
    if (settingsBleScanActive) {
      String mac = advertisedDevice.getAddress().toString();
      mac.toUpperCase();

      String name = "";
      if (advertisedDevice.haveName()) {
        name = advertisedDevice.getName();
      }
      if (name.length() == 0) {
        name = "BLE DEVICE";
      }

      int existing = -1;
      for (int i = 0; i < settingsBleCount; i++) {
        if (settingsBleMac[i] == mac) {
          existing = i;
          break;
        }
      }

      if (existing >= 0) {
        if (rssi > settingsBleRssi[existing]) {
          settingsBleRssi[existing] = rssi;
          settingsBleName[existing] = name;
        }
      } else if (settingsBleCount < SETTINGS_BLE_MAX) {
        int idx = settingsBleCount++;
        settingsBleName[idx] = name;
        settingsBleMac[idx] = mac;
        settingsBleRssi[idx] = rssi;
      }
    }

    if (rssi < BF1_MIN_RSSI) {
      return;
    }

    if (!advertisedDevice.haveManufacturerData()) {
      return;
    }

    String manufacturerData =
      advertisedDevice.getManufacturerData();

    size_t len = manufacturerData.length();

    // Company ID (2), Type (1), plus encrypted payload.
    if (len < 11) {
      return;
    }

    const uint8_t *raw =
      reinterpret_cast<const uint8_t *>(
        manufacturerData.c_str());

    uint16_t companyId =
      raw[0] | ((uint16_t)raw[1] << 8);

    if (companyId != 2237 || raw[2] != 73) {
      return;
    }

    Bf1LiveData decoded = {};

    if (!bf1_parse_type73(
          &raw[3],
          len - 3,
          decoded)) {
      return;
    }

    String mac =
      advertisedDevice.getAddress().toString();
    mac.toUpperCase();

    decoded.valid = true;
    decoded.rssi = rssi;
    decoded.addressType =
      advertisedDevice.getAddressType();
    decoded.lastSeenMs = millis();

    snprintf(
      decoded.mac,
      sizeof(decoded.mac),
      "%s",
      mac.c_str());

    portENTER_CRITICAL(&bf1DataMux);

    if (!bf1PassFound || rssi > bf1PassHighestRssi) {
      bf1PassBest = decoded;
      bf1PassHighestRssi = rssi;
      bf1PassFound = true;
    }

    portEXIT_CRITICAL(&bf1DataMux);
  }
};

static WatchBf1AdvertisedCallbacks bf1AdvertisedCallbacks;

static void bf1_scan_complete_cb(BLEScanResults results) {
  LV_UNUSED(results);

  if (settingsBleScanActive) {
    settingsBleScanActive = false;
    settingsBleScanComplete = true;
    return;
  }

  bf1ScanPassComplete = true;
}

static bool bf1_ble_init() {
  if (bf1BleInitialized) {
    return true;
  }

  USBSerial.println("[BF1] Initializing BLE scanner");

  BLEDevice::init("");

  bf1BleScan = BLEDevice::getScan();

  if (!bf1BleScan) {
    USBSerial.println("[BF1] ERROR: BLE scanner unavailable");
    return false;
  }

  // true = allow duplicate results so repeated BF1 advertisements are seen.
  bf1BleScan->setAdvertisedDeviceCallbacks(
    &bf1AdvertisedCallbacks,
    true);

  bf1BleScan->setActiveScan(true);
  bf1BleScan->setInterval(100);
  bf1BleScan->setWindow(99);

  bf1BleInitialized = true;

  USBSerial.println("[BF1] BLE scanner ready");
  return true;
}

static void bf1_stop_scan() {
  if (bf1BleScan && bf1BleScan->isScanning()) {
    bf1BleScan->stop();
  }

  bf1ScanPassRunning = false;
  bf1ScanPassComplete = false;
}

static void bf1_start_scan_pass() {
  if (!bf1BleInitialized || !bf1BleScan) {
    return;
  }

  if (bf1BleScan->isScanning()) {
    return;
  }

  portENTER_CRITICAL(&bf1DataMux);
  memset(&bf1PassBest, 0, sizeof(bf1PassBest));
  bf1PassFound = false;
  bf1PassHighestRssi = BF1_MIN_RSSI - 1;
  portEXIT_CRITICAL(&bf1DataMux);

  bf1ScanPassComplete = false;

  // Arduino-ESP32 BLE duration is in seconds.
  bool started =
    bf1BleScan->start(
      1,
      bf1_scan_complete_cb,
      false);

  bf1ScanPassRunning = started;

  if (!started) {
    USBSerial.println("[BF1] Scan pass failed to start");
  }
}

static bool bf1_get_live_snapshot(Bf1LiveData &out) {
  bool have = false;

  portENTER_CRITICAL(&bf1DataMux);

  if (bf1HasLastValid) {
    out = bf1LastValid;
    have = true;
  }

  portEXIT_CRITICAL(&bf1DataMux);

  if (!have) {
    return false;
  }

  if ((millis() - out.lastSeenMs) > BF1_SENSOR_TIMEOUT) {
    return false;
  }

  return true;
}


static void bf1_page_scroll_cb(lv_event_t *e) {
  LV_UNUSED(e);

  // Ignore scroll events caused by our own refresh/restore sequence.
  // This is the key fix for the old snap-back: build_page() scrolls to
  // zero internally, and that programmatic move used to overwrite the
  // saved user scroll position with 0.
  if (bf1ProgrammaticScroll) {
    return;
  }

  if (activePageId == PAGE_TPMS &&
      tpmsPageMode == TPMS_MODE_BF1_RADAR &&
      pageBody) {
    bf1SavedScrollY = lv_obj_get_scroll_y(pageBody);
    if (bf1SavedScrollY < 0) bf1SavedScrollY = 0;
    bf1LastScrollInteractionMs = millis();
  }
}

static void bf1_refresh_page_preserve_scroll() {
  if (!pageBody) return;

  // Do not rebuild while the user is actively dragging/scrolling.
  if ((millis() - bf1LastScrollInteractionMs) < 1400UL) {
    return;
  }

  // IMPORTANT: keep the position in a LOCAL variable. The page rebuild
  // itself can generate LVGL scroll events, so relying on the global saved
  // value is unsafe even with a guard.
  int32_t restoreY = lv_obj_get_scroll_y(pageBody);
  if (restoreY < 0) restoreY = 0;

  bf1ProgrammaticScroll = true;

  build_page(PAGE_TPMS);

  lv_obj_update_layout(pageBody);

  int32_t maxY = lv_obj_get_scroll_bottom(pageBody);
  int32_t currentY = lv_obj_get_scroll_y(pageBody);
  if (currentY < 0) currentY = 0;

  // After rebuilding at the top, scroll_bottom is effectively the current
  // maximum vertical range. Clamp in case SEARCHING -> FOUND changed height.
  if (restoreY > maxY) restoreY = maxY;
  if (restoreY < 0) restoreY = 0;

  lv_obj_scroll_to_y(pageBody, restoreY, LV_ANIM_OFF);
  bf1SavedScrollY = restoreY;

  bf1ProgrammaticScroll = false;
}

static void bf1_service_live_scan() {
  bool radarActive =
    (activePageId == PAGE_TPMS
     && tpmsPageMode == TPMS_MODE_BF1_RADAR);

  if (!radarActive) {
    if (bf1ScanPassRunning ||
        (bf1BleScan && bf1BleScan->isScanning())) {
      bf1_stop_scan();
    }
    return;
  }

  if (!bf1BleInitialized) {
    if (!bf1_ble_init()) {
      return;
    }
  }

  if (bf1ScanPassComplete) {
    bf1ScanPassComplete = false;
    bf1ScanPassRunning = false;

    Bf1LiveData passData = {};
    bool found = false;

    portENTER_CRITICAL(&bf1DataMux);

    if (bf1PassFound) {
      passData = bf1PassBest;
      found = true;

      bf1LastValid = passData;
      bf1HasLastValid = true;
      bf1ValidPacketCount++;
    }

    portEXIT_CRITICAL(&bf1DataMux);

    if (bf1BleScan) {
      bf1BleScan->clearResults();
    }

    if (found) {
      USBSerial.printf(
        "[BF1] %s | %.1f psi | %d C | %.0f%% | %d dBm | seq %u\n",
        passData.mac,
        passData.pressurePsi,
        passData.tempC,
        passData.batteryPct,
        passData.rssi,
        passData.sequence);
    }

    // Immediately begin the next one-second pass.
    bf1_start_scan_pass();
  }
  else if (!bf1ScanPassRunning &&
           bf1BleScan &&
           !bf1BleScan->isScanning()) {
    bf1_start_scan_pass();
  }

  // Refresh the live radar once per second, but preserve the current
  // scroll position and never rebuild while the user is interacting.
  if ((millis() - bf1LastUiRefreshMs) >= 1000) {
    bf1LastUiRefreshMs = millis();

    if (activePageId == PAGE_TPMS &&
        tpmsPageMode == TPMS_MODE_BF1_RADAR) {
      bf1_refresh_page_preserve_scroll();
    }
  }
}

static lv_color_t tpms_pressure_color(float psi) {
  if (psi <= 0.1f) return C_BLUE;
  if (psi < 26.0f) return C_RED;
  if (psi > 38.0f) return C_AMBER;
  return C_TEXT;
}

static const char *tpms_pressure_status(float psi) {
  if (psi <= 0.1f) return "ZERO";
  if (psi < 26.0f) return "LOW";
  if (psi > 38.0f) return "HIGH";
  return "NORMAL";
}

static lv_color_t tpms_pressure_status_color(float psi) {
  if (psi <= 0.1f) return C_BLUE;
  if (psi < 26.0f) return C_RED;
  if (psi > 38.0f) return C_AMBER;
  return C_GREEN;
}

static lv_color_t tpms_rssi_color(int rssi) {
  if (rssi >= -65) return C_GREEN;
  if (rssi >= -80) return C_AMBER;
  return C_RED;
}

static lv_color_t tpms_battery_color(int pct) {
  // Match TPMS Pro battery bands.
  if (pct >= 61) return C_GREEN;
  if (pct >= 21) return C_AMBER;
  return C_RED;
}


static const float TPMS_CAN_TARGET_PSI = 32.0f;

static lv_color_t tpms_temp_color(int tempC) {
  if (tempC >= 105) return C_RED;
  if (tempC >= 90) return C_AMBER;
  return C_TEXT;
}

static float tpms_delta_from_target(float psi) {
  return psi - TPMS_CAN_TARGET_PSI;
}

static const char *tpms_wheel_state(
    float psi,
    int tempC) {
  if (psi <= 0.1f) return "ZERO";
  if (psi < 26.0f) return "LOW";
  if (psi > 38.0f) return "HIGH";
  if (tempC >= 105) return "HOT";
  if (tempC >= 90) return "WARM";
  return "NORMAL";
}

static lv_color_t tpms_wheel_state_color(
    float psi,
    int tempC) {
  if (psi <= 0.1f) return C_BLUE;
  if (psi < 26.0f) return C_RED;
  if (psi > 38.0f) return C_AMBER;
  if (tempC >= 105) return C_RED;
  if (tempC >= 90) return C_AMBER;
  return C_GREEN;
}

static bool tpms_can_has_critical() {
  for (int i = 0; i < 4; ++i) {
    const TpmsUiSensor &s = canTpmsDemo[i];

    if (s.psi <= 0.1f ||
        s.psi < 26.0f ||
        s.tempC >= 105) {
      return true;
    }
  }

  return false;
}

static bool tpms_can_has_caution() {
  if (tpms_can_has_critical()) {
    return false;
  }

  for (int i = 0; i < 4; ++i) {
    const TpmsUiSensor &s = canTpmsDemo[i];

    if (s.psi > 38.0f ||
        s.tempC >= 90) {
      return true;
    }
  }

  return false;
}

