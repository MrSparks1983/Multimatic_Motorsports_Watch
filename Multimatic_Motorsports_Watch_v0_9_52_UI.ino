// -------------------- ENGINE PAGE --------------------
//
// Dedicated powertrain-health page.
// VITALS remains the driver's at-a-glance page; ENGINE goes deeper into
// pressures, temperatures, intake/fueling and driveline health.
//
// Values are still demo/CAN placeholders until the telemetry gateway is wired.

static lv_obj_t *engineStatusValue = nullptr;
static lv_obj_t *engineRpmValue = nullptr;
static lv_obj_t *engineThrottleValue = nullptr;
static lv_obj_t *engineBoostValue = nullptr;
static lv_obj_t *engineRpmBar = nullptr;

static lv_obj_t *engineOilPressValue = nullptr;
static lv_obj_t *engineFuelPressValue = nullptr;
static lv_obj_t *engineTransInValue = nullptr;
static lv_obj_t *engineTransOutValue = nullptr;

static lv_obj_t *engineCoolantValue = nullptr;
static lv_obj_t *engineOilTempValue = nullptr;
static lv_obj_t *engineTransTempValue = nullptr;
static lv_obj_t *engineIntakeTempValue = nullptr;

static lv_obj_t *engineMapValue = nullptr;
static lv_obj_t *engineBaroValue = nullptr;
static lv_obj_t *engineLambdaValue = nullptr;
static lv_obj_t *engineBatteryValue = nullptr;

static lv_color_t engine_temp_color(
    float value,
    float amberAt,
    float redAt) {
  if (value >= redAt) return C_RED;
  if (value >= amberAt) return C_AMBER;
  return C_TEXT;
}

static lv_color_t engine_low_pressure_color(
    float value,
    float redBelow,
    float amberBelow) {
  if (value <= redBelow) return C_RED;
  if (value <= amberBelow) return C_AMBER;
  return C_TEXT;
}

static lv_obj_t *make_engine_metric_card(
    lv_obj_t *parent,
    const char *title,
    const char *value,
    const char *unit,
    lv_obj_t **valueOut) {
  lv_obj_t *card =
    make_card(parent, 94);

  lv_obj_set_style_pad_all(
    card,
    10,
    0);

  lv_obj_t *name =
    make_label(
      card,
      title,
      12,
      C_MUTED);
  lv_obj_align(
    name,
    LV_ALIGN_TOP_LEFT,
    0,
    0);

  lv_obj_t *val =
    make_label(
      card,
      value,
      20,
      C_TEXT);
  lv_obj_align(
    val,
    LV_ALIGN_BOTTOM_LEFT,
    0,
    -2);

  lv_obj_t *unitLabel =
    make_label(
      card,
      unit,
      12,
      C_MUTED);
  lv_obj_align_to(
    unitLabel,
    val,
    LV_ALIGN_OUT_RIGHT_BOTTOM,
    6,
    -2);

  if (valueOut) {
    *valueOut = val;
  }

  return card;
}

static void engine_update_ui() {
  if (activePageId != PAGE_ENGINE) return;
  if (!engineRpmValue) return;

  char buf[24];

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.rpm);
  lv_label_set_text(
    engineRpmValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f%%",
    vehicle.throttle);
  lv_label_set_text(
    engineThrottleValue,
    buf);

  float boostPsi =
    vehicle.mapPsi - vehicle.baroPsi;

  snprintf(
    buf,
    sizeof(buf),
    "%+.1f",
    boostPsi);
  lv_label_set_text(
    engineBoostValue,
    buf);

  int rpmBar =
    (int)roundf(vehicle.rpm);
  if (rpmBar < 0) rpmBar = 0;
  if (rpmBar > 8500) rpmBar = 8500;

  lv_bar_set_value(
    engineRpmBar,
    rpmBar,
    LV_ANIM_OFF);

  lv_color_t rpmColor = C_GREEN;
  if (vehicle.rpm >= 7800.0f) {
    rpmColor = C_RED;
  } else if (vehicle.rpm >= 7000.0f) {
    rpmColor = C_AMBER;
  }

  lv_obj_set_style_bg_color(
    engineRpmBar,
    rpmColor,
    LV_PART_INDICATOR);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.oilPressure);
  lv_label_set_text(
    engineOilPressValue,
    buf);
  lv_obj_set_style_text_color(
    engineOilPressValue,
    engine_low_pressure_color(
      vehicle.oilPressure,
      25.0f,
      40.0f),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.fuelPressure);
  lv_label_set_text(
    engineFuelPressValue,
    buf);
  lv_obj_set_style_text_color(
    engineFuelPressValue,
    engine_low_pressure_color(
      vehicle.fuelPressure,
      40.0f,
      50.0f),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.transIn);
  lv_label_set_text(
    engineTransInValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.transOut);
  lv_label_set_text(
    engineTransOutValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.coolantC);
  lv_label_set_text(
    engineCoolantValue,
    buf);
  lv_obj_set_style_text_color(
    engineCoolantValue,
    engine_temp_color(
      vehicle.coolantC,
      105.0f,
      115.0f),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.oilTempC);
  lv_label_set_text(
    engineOilTempValue,
    buf);
  lv_obj_set_style_text_color(
    engineOilTempValue,
    engine_temp_color(
      vehicle.oilTempC,
      125.0f,
      140.0f),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.transTempC);
  lv_label_set_text(
    engineTransTempValue,
    buf);
  lv_obj_set_style_text_color(
    engineTransTempValue,
    engine_temp_color(
      vehicle.transTempC,
      110.0f,
      125.0f),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.intakeAirC);
  lv_label_set_text(
    engineIntakeTempValue,
    buf);
  lv_obj_set_style_text_color(
    engineIntakeTempValue,
    engine_temp_color(
      vehicle.intakeAirC,
      60.0f,
      80.0f),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.1f",
    vehicle.mapPsi);
  lv_label_set_text(
    engineMapValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%.1f",
    vehicle.baroPsi);
  lv_label_set_text(
    engineBaroValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%.2f",
    vehicle.lambda);
  lv_label_set_text(
    engineLambdaValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%.1f",
    vehicle.batteryV);
  lv_label_set_text(
    engineBatteryValue,
    buf);

  lv_color_t batteryColor = C_TEXT;
  if (vehicle.batteryV < 11.5f) {
    batteryColor = C_RED;
  } else if (vehicle.batteryV < 12.2f) {
    batteryColor = C_AMBER;
  }

  lv_obj_set_style_text_color(
    engineBatteryValue,
    batteryColor,
    0);

  bool critical =
    vehicle.oilPressure <= 25.0f ||
    vehicle.fuelPressure <= 40.0f ||
    vehicle.coolantC >= 115.0f ||
    vehicle.oilTempC >= 140.0f ||
    vehicle.transTempC >= 125.0f ||
    vehicle.intakeAirC >= 80.0f ||
    vehicle.batteryV < 11.5f;

  bool caution =
    !critical &&
    (vehicle.oilPressure <= 40.0f ||
     vehicle.fuelPressure <= 50.0f ||
     vehicle.coolantC >= 105.0f ||
     vehicle.oilTempC >= 125.0f ||
     vehicle.transTempC >= 110.0f ||
     vehicle.intakeAirC >= 60.0f ||
     vehicle.batteryV < 12.2f);

  if (critical) {
    lv_label_set_text(
      engineStatusValue,
      "CRITICAL");
    lv_obj_set_style_text_color(
      engineStatusValue,
      C_RED,
      0);
  } else if (caution) {
    lv_label_set_text(
      engineStatusValue,
      "CAUTION");
    lv_obj_set_style_text_color(
      engineStatusValue,
      C_AMBER,
      0);
  } else {
    lv_label_set_text(
      engineStatusValue,
      "NORMAL");
    lv_obj_set_style_text_color(
      engineStatusValue,
      C_GREEN,
      0);
  }
}

