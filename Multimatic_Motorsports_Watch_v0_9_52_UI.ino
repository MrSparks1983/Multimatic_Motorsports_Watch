static int bf1_rssi_radius(int rssi) {
  // This is proximity-only, not direction finding.
  // -30 dBm = near center, -60 dBm = outer accepted edge.
  if (rssi > -30) rssi = -30;
  if (rssi < BF1_MIN_RSSI) rssi = BF1_MIN_RSSI;

  int weakness = (-rssi) - 30;  // 0..30
  return 22 + (weakness * 58 / 30);
}


static void bf1_stop_radar_animation() {
  if (bf1RadarAnimTimer) {
    lv_timer_delete(bf1RadarAnimTimer);
    bf1RadarAnimTimer = nullptr;
  }

  for (int i = 0; i < 7; i++) {
    bf1RadarCometDots[i] = nullptr;
  }
}

static void bf1_radar_animation_cb(lv_timer_t *timer) {
  LV_UNUSED(timer);

  if (activePageId != PAGE_TPMS ||
      tpmsPageMode != TPMS_MODE_BF1_RADAR) {
    return;
  }

  // One complete radar revolution every 1200 ms.
  const float TWO_PI_F = 6.28318530718f;
  const float HEAD_OFFSET = -1.57079632679f; // start at 12 o'clock
  float phase =
    (float)(millis() % 1200UL) / 1200.0f;

  float headAngle =
    HEAD_OFFSET + phase * TWO_PI_F;

  const float radius = 80.0f;
  const float tailSpacing = 0.115f; // ~6.6 degrees

  for (int i = 0; i < 7; i++) {
    lv_obj_t *dot = bf1RadarCometDots[i];
    if (!dot) continue;

    float angle =
      headAngle - ((float)i * tailSpacing);

    int size = 10 - i;
    if (size < 4) size = 4;

    int x =
      159 + (int)(cosf(angle) * radius) - size / 2;
    int y =
      115 + (int)(sinf(angle) * radius) - size / 2;

    lv_obj_set_pos(dot, x, y);
  }
}

static void bf1_start_radar_animation(lv_obj_t *radar) {
  bf1_stop_radar_animation();

  static const lv_opa_t cometOpa[7] = {
    LV_OPA_COVER,
    LV_OPA_90,
    LV_OPA_80,
    LV_OPA_60,
    LV_OPA_50,
    LV_OPA_30,
    LV_OPA_20
  };

  for (int i = 0; i < 7; i++) {
    int size = 10 - i;
    if (size < 4) size = 4;

    lv_obj_t *dot = lv_obj_create(radar);
    bf1RadarCometDots[i] = dot;

    lv_obj_set_size(dot, size, size);
    lv_obj_set_style_radius(dot, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(dot, C_TEXT, 0);
    lv_obj_set_style_bg_opa(dot, cometOpa[i], 0);
    lv_obj_set_style_border_width(dot, 0, 0);
    lv_obj_set_style_shadow_width(dot, 0, 0);
    lv_obj_clear_flag(dot, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_clear_flag(dot, LV_OBJ_FLAG_CLICKABLE);
  }

  // Position immediately, then update at ~30 FPS.
  bf1_radar_animation_cb(nullptr);
  bf1RadarAnimTimer =
    lv_timer_create(bf1_radar_animation_cb, 33, nullptr);
}

static void build_bf1_radar_mode(lv_obj_t *parent) {
  Bf1LiveData s = {};
  bool haveSensor = bf1_get_live_snapshot(s);

  lv_obj_t *status = make_card(parent, 52);

  const char *scanText =
    haveSensor ? "BF1 FOUND" : "SCANNING";

  lv_obj_t *scan =
    make_label(
      status,
      scanText,
      13,
      haveSensor ? C_GREEN : C_TEXT);
  lv_obj_align(scan, LV_ALIGN_LEFT_MID, 0, 0);

  char packetText[24];
  snprintf(
    packetText,
    sizeof(packetText),
    "PKT %lu",
    (unsigned long)bf1ValidPacketCount);

  lv_obj_t *ble =
    make_label(status, packetText, 14, C_BLUE);
  lv_obj_align(ble, LV_ALIGN_RIGHT_MID, 0, 0);

  lv_obj_t *radar = lv_obj_create(parent);
  lv_obj_set_width(radar, LV_PCT(100));
  lv_obj_set_height(radar, 230);
  lv_obj_set_style_radius(radar, 20, 0);
  lv_obj_set_style_bg_color(radar, lv_color_hex(0x03070B), 0);
  lv_obj_set_style_border_color(
    radar,
    haveSensor ? tpms_pressure_status_color(s.pressurePsi) : lv_color_hex(0x3A4655),
    0);
  lv_obj_set_style_border_width(radar, haveSensor ? 2 : 1, 0);
  lv_obj_set_style_shadow_width(radar, 0, 0);
  lv_obj_clear_flag(radar, LV_OBJ_FLAG_SCROLLABLE);

  make_radar_ring(radar, 184, 2, C_TEXT, LV_OPA_80);
  make_radar_ring(radar, 128, 1, lv_color_hex(0x596576), LV_OPA_70);
  make_radar_ring(radar, 72, 1, lv_color_hex(0x596576), LV_OPA_70);

  lv_obj_t *h = lv_obj_create(radar);
  lv_obj_set_size(h, 174, 1);
  lv_obj_set_style_bg_color(h, lv_color_hex(0x46515E), 0);
  lv_obj_set_style_bg_opa(h, LV_OPA_COVER, 0);
  lv_obj_set_style_border_width(h, 0, 0);
  lv_obj_clear_flag(h, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_clear_flag(h, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_center(h);

  lv_obj_t *v = lv_obj_create(radar);
  lv_obj_set_size(v, 1, 174);
  lv_obj_set_style_bg_color(v, lv_color_hex(0x46515E), 0);
  lv_obj_set_style_bg_opa(v, LV_OPA_COVER, 0);
  lv_obj_set_style_border_width(v, 0, 0);
  lv_obj_clear_flag(v, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_clear_flag(v, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_center(v);

  // Smooth timer-driven comet scan animation.
  // This is a visual scan cue only; a single BLE antenna cannot determine
  // sensor direction.
  bf1_start_radar_animation(radar);

  if (haveSensor) {
    // Plot proximity by RSSI at a fixed bearing.
    // This DOES NOT imply real direction; the watch has one BLE antenna.
    int radius = bf1_rssi_radius(s.rssi);
    int targetX = 159 + (radius * 707 / 1000); // ~45 degrees
    int targetY = 115 - (radius * 707 / 1000);

    lv_obj_t *target = lv_obj_create(radar);
    lv_obj_set_size(target, 18, 18);
    lv_obj_set_pos(target, targetX - 9, targetY - 9);
    lv_obj_set_style_radius(target, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(target, tpms_rssi_color(s.rssi), 0);
    lv_obj_set_style_border_color(target, C_TEXT, 0);
    lv_obj_set_style_border_width(target, 2, 0);
    lv_obj_set_style_shadow_width(target, 0, 0);
    lv_obj_clear_flag(target, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_clear_flag(target, LV_OBJ_FLAG_CLICKABLE);

    char pressureText[18];
    snprintf(
      pressureText,
      sizeof(pressureText),
      "%.1f psi",
      s.pressurePsi);

    lv_obj_t *pressure =
      make_label(
        radar,
        pressureText,
        26,
        tpms_pressure_color(s.pressurePsi));
    lv_obj_align(pressure, LV_ALIGN_CENTER, 0, -1);

    lv_obj_t *state =
      make_label(
        radar,
        tpms_pressure_status(s.pressurePsi),
        11,
        tpms_pressure_status_color(s.pressurePsi));
    lv_obj_align(state, LV_ALIGN_CENTER, 0, 28);

  } else {
    lv_obj_t *search =
      make_label(
        radar,
        "SEARCHING BF1...",
        17,
        C_TEXT);
    lv_obj_align(search, LV_ALIGN_CENTER, 0, -3);

    lv_obj_t *threshold =
      make_label(
        radar,
        "Type-73  /  >= -60 dBm",
        11,
        C_MUTED);
    lv_obj_align(threshold, LV_ALIGN_CENTER, 0, 26);
  }

  lv_obj_t *result = make_card(parent, 190);

  if (haveSensor) {
    uint32_t ageSec =
      (millis() - s.lastSeenMs) / 1000UL;

    char tempText[16];
    char battText[16];
    char rssiText[18];
    char seqText[16];
    char ageText[18];

    snprintf(tempText, sizeof(tempText), "%d C", s.tempC);
    snprintf(battText, sizeof(battText), "%.0f%%", s.batteryPct);
    snprintf(rssiText, sizeof(rssiText), "%d dBm", s.rssi);
    snprintf(seqText, sizeof(seqText), "%u", s.sequence);
    snprintf(ageText, sizeof(ageText), "%lu s", (unsigned long)ageSec);

    lv_obj_t *idTitle =
      make_label(result, "SENSOR", 12, C_MUTED);
    lv_obj_align(idTitle, LV_ALIGN_TOP_LEFT, 0, 0);

    lv_obj_t *id =
      make_label(result, s.mac, 14, C_TEXT);
    lv_obj_align(id, LV_ALIGN_TOP_LEFT, 0, 20);

    lv_obj_t *temp =
      make_label(result, tempText, 16, C_TEXT);
    lv_obj_align(temp, LV_ALIGN_LEFT_MID, 0, 10);

    lv_obj_t *batt =
      make_label(
        result,
        battText,
        16,
        tpms_battery_color((int)s.batteryPct));
    lv_obj_align(batt, LV_ALIGN_CENTER, 0, 10);

    lv_obj_t *rssi =
      make_label(
        result,
        rssiText,
        16,
        tpms_rssi_color(s.rssi));
    lv_obj_align(rssi, LV_ALIGN_RIGHT_MID, 0, 10);

    lv_obj_t *seqLabel =
      make_label(result, "SEQ", 12, C_MUTED);
    lv_obj_align(seqLabel, LV_ALIGN_BOTTOM_LEFT, 0, -18);

    lv_obj_t *seq =
      make_label(result, seqText, 14, C_TEXT);
    lv_obj_align(seq, LV_ALIGN_BOTTOM_LEFT, 30, -18);

    lv_obj_t *ageLabel =
      make_label(result, "LAST", 12, C_MUTED);
    lv_obj_align(ageLabel, LV_ALIGN_BOTTOM_RIGHT, -42, -18);

    lv_obj_t *age =
      make_label(result, ageText, 14, C_GREEN);
    lv_obj_align(age, LV_ALIGN_BOTTOM_RIGHT, 0, -18);

    lv_obj_t *fw =
      make_label(result, "FW --", 12, C_MUTED);
    lv_obj_align(fw, LV_ALIGN_BOTTOM_LEFT, 0, 2);

    lv_obj_t *src =
      make_label(result, "LIVE TYPE-73", 12, C_BLUE);
    lv_obj_align(src, LV_ALIGN_BOTTOM_RIGHT, 0, 2);

  } else {
    lv_obj_t *title =
      make_label(result, "NO VALID BF1 PACKET YET", 14, C_TEXT);
    lv_obj_set_width(title, LV_PCT(100));
    lv_obj_set_style_text_align(title, LV_TEXT_ALIGN_CENTER, 0);
    lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 10);

    lv_obj_t *help =
      make_label(
        result,
        "Move an active BF1 sensor close to the watch.\n"
        "Only valid company 2237 / Type-73 packets\n"
        "above the -60 dBm filter are accepted.",
        11,
        C_MUTED);
    lv_obj_set_width(help, LV_PCT(100));
    lv_obj_set_style_text_align(help, LV_TEXT_ALIGN_CENTER, 0);
    lv_obj_align(help, LV_ALIGN_CENTER, 0, 16);
  }
}

static void build_tpms(lv_obj_t *parent) {
  add_page_header(parent, "// TPMS", "Vehicle + live BF1");
  add_top_nav_controls(parent);
  add_red_divider(parent);

  add_tpms_mode_selector(parent);

  if (tpmsPageMode == TPMS_MODE_CAN) {
    build_can_tpms_mode(parent);
  } else {
    build_bf1_radar_mode(parent);
  }

  add_bottom_nav(parent, PAGE_TPMS);
}

// -------------------- SESSION PAGE --------------------
//
// Technician-only pit review.
// No live driver timing is shown. Intended workflow:
// car enters pit -> gateway transfers completed run -> tech reviews stored data.

static lv_obj_t *make_session_review_metric(
    lv_obj_t *parent,
    const char *title,
    const char *value,
    const char *unit,
    lv_color_t valueColor) {
  lv_obj_t *card =
    make_card(parent, 88);

  lv_obj_set_style_pad_all(
    card,
    10,
    0);

  lv_obj_t *name =
    make_label(
      card,
      title,
      11,
      C_MUTED);
  lv_obj_align(
    name,
    LV_ALIGN_TOP_LEFT,
    0,
    0);

  lv_obj_t *val =
    make_label(
      card,
      value,
      18,
      valueColor);
  lv_obj_align(
    val,
    LV_ALIGN_BOTTOM_LEFT,
    0,
    -2);

  if (unit && unit[0] != '\0') {
    lv_obj_t *unitLabel =
      make_label(
        card,
        unit,
        10,
        C_MUTED);
    lv_obj_align_to(
      unitLabel,
      val,
      LV_ALIGN_OUT_RIGHT_BOTTOM,
      5,
      -2);
  }

  return card;
}

