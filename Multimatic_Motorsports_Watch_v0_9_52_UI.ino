static void watch_ota_progress_update(
    int pct,
    const char *status) {
  if (!watchOtaProgressOverlay) return;

  if (pct < 0) pct = 0;
  if (pct > 100) pct = 100;

  if (watchOtaProgressBar) {
    lv_bar_set_value(
      watchOtaProgressBar,
      pct,
      LV_ANIM_OFF);
  }

  if (watchOtaProgressPercent) {
    char pctText[10];
    snprintf(
      pctText,
      sizeof(pctText),
      "%d%%",
      pct);
    lv_label_set_text(
      watchOtaProgressPercent,
      pctText);
  }

  if (watchOtaProgressStatus &&
      status) {
    lv_label_set_text(
      watchOtaProgressStatus,
      status);
  }

  watch_note_activity();

  uint32_t now =
    millis();

  bool meaningfulPctChange =
    abs(
      pct -
      watchOtaProgressLastRenderedPct) >= 2;

  bool renderDue =
    (now -
     watchOtaProgressLastRenderMs) >=
      120UL;

  if (pct == 0 ||
      pct >= 100 ||
      meaningfulPctChange ||
      renderDue) {
    watchOtaProgressLastRenderedPct =
      pct;

    watch_ota_progress_render_now(
      pct == 0 ||
      pct >= 100);
  }
}

static void watch_ota_progress_finish(
    bool success,
    const char *status) {
  if (!watchOtaProgressOverlay) {
    watch_ota_progress_show(
      "FIRMWARE UPDATE",
      status ? status : "");
  }

  watch_ota_progress_update(
    success ? 100 : 0,
    status ? status
           : (success
                ? "Update complete."
                : "Update failed."));

  if (watchOtaProgressTitle) {
    lv_label_set_text(
      watchOtaProgressTitle,
      success
        ? "UPDATE COMPLETE"
        : "UPDATE FAILED");
    lv_obj_set_style_text_color(
      watchOtaProgressTitle,
      success ? C_GREEN : C_RED,
      0);
  }

  watch_ota_progress_render_now(
    true);
}


// -------------------- FIRMWARE HTTP / HTTPS TRANSPORT --------------------
//
// Manifest and firmware BIN URLs support both http:// and https://.
// HTTPS uses WiFiClientSecure. Certificate validation is disabled in this
// build so public, self-signed, and internal HTTPS servers all work.
// Transport is encrypted, but server identity is not certificate-verified.
// Optional manifest MD5 verification remains supported.

static bool watch_fw_url_is_http(
    const String &url) {
  return url.startsWith(
    "http://");
}

static bool watch_fw_url_is_https(
    const String &url) {
  return url.startsWith(
    "https://");
}

static bool watch_fw_url_supported(
    const String &url) {
  return
    watch_fw_url_is_http(url) ||
    watch_fw_url_is_https(url);
}

static bool watch_fw_http_begin(
    HTTPClient &http,
    WiFiClient &plainClient,
    WiFiClientSecure &secureClient,
    const String &url) {
  if (watch_fw_url_is_https(url)) {
    secureClient.setInsecure();

    return http.begin(
      secureClient,
      url);
  }

  if (watch_fw_url_is_http(url)) {
    return http.begin(
      plainClient,
      url);
  }

  return false;
}


// -------------------- OTA IMAGE VERIFICATION --------------------
//
// The watch embeds WATCH_FIRMWARE_VERSION as a plain string in every build.
// Before rebooting into an OTA image, scan the written app partition for the
// version promised by the manifest or encoded in the manual-upload filename.
// This prevents a stale/renamed .bin from being accepted and then rebooting
// right back into what appears to be the same firmware.

static String watch_fw_version_from_filename(
    const String &filename) {
  int start =
    filename.indexOf("_v");

  if (start < 0) {
    start =
      filename.indexOf("_V");
  }

  if (start < 0) {
    return "";
  }

  // Skip the underscore so the returned string begins with v/V.
  start += 1;

  String version = "";

  for (int i = start;
       i < filename.length();
       ++i) {
    char c =
      filename.charAt(i);

    if ((c >= '0' && c <= '9') ||
        c == 'v' ||
        c == 'V' ||
        c == '_' ||
        c == '.') {
      version += c;
    } else {
      break;
    }
  }

  version.replace(
    '_',
    '.');

  if (version.length() < 6) {
    return "";
  }

  if (version.charAt(0) == 'V') {
    version.setCharAt(
      0,
      'v');
  }

  return version;
}

static bool watch_partition_contains_ascii(
    const esp_partition_t *partition,
    size_t bytesToScan,
    const String &needle) {
  if (!partition ||
      needle.length() == 0) {
    return false;
  }

  if (bytesToScan == 0 ||
      bytesToScan > partition->size) {
    bytesToScan =
      partition->size;
  }

  const size_t chunkSize =
    1024;

  const size_t needleLen =
    needle.length();

  if (needleLen >= chunkSize) {
    return false;
  }

  uint8_t buffer[chunkSize + 64];
  size_t carry = 0;
  size_t offset = 0;

  while (offset < bytesToScan) {
    size_t toRead =
      bytesToScan -
      offset;

    if (toRead > chunkSize) {
      toRead =
        chunkSize;
    }

    esp_err_t err =
      esp_partition_read(
        partition,
        offset,
        buffer + carry,
        toRead);

    if (err != ESP_OK) {
      USBSerial.print(
        "[WATCH] OTA verify partition read error: ");
      USBSerial.println(
        (int)err);
      return false;
    }

    size_t available =
      carry +
      toRead;

    for (size_t i = 0;
         i + needleLen <= available;
         ++i) {
      bool match = true;

      for (size_t j = 0;
           j < needleLen;
           ++j) {
        if (buffer[i + j] !=
            (uint8_t)needle.charAt(j)) {
          match = false;
          break;
        }
      }

      if (match) {
        return true;
      }
    }

    if (needleLen > 1) {
      carry =
        needleLen - 1;

      if (carry > available) {
        carry =
          available;
      }

      memmove(
        buffer,
        buffer + available - carry,
        carry);
    } else {
      carry = 0;
    }

    offset +=
      toRead;
  }

  return false;
}

static bool watch_ota_activate_target(
    const esp_partition_t *targetPartition) {
  if (!targetPartition) {
    return false;
  }

  const esp_partition_t *bootPartition =
    esp_ota_get_boot_partition();

  if (bootPartition &&
      bootPartition->address ==
        targetPartition->address) {
    return true;
  }

  esp_err_t err =
    esp_ota_set_boot_partition(
      targetPartition);

  if (err != ESP_OK) {
    USBSerial.print(
      "[WATCH] OTA activate error: ");
    USBSerial.println(
      (int)err);
    return false;
  }

  bootPartition =
    esp_ota_get_boot_partition();

  return bootPartition &&
         bootPartition->address ==
           targetPartition->address;
}

static void watch_ota_restore_running_partition(
    const esp_partition_t *runningPartition) {
  if (!runningPartition) {
    return;
  }

  esp_err_t err =
    esp_ota_set_boot_partition(
      runningPartition);

  USBSerial.print(
    "[WATCH] OTA restore running partition: ");
  USBSerial.println(
    err == ESP_OK
      ? "OK"
      : "FAILED");
}


// Confirm a freshly booted OTA image so bootloader rollback cannot silently
// return to the previous firmware after the first restart. This is harmless
// when rollback support is disabled or the image is already valid.
static void watch_ota_confirm_running_app() {
  const esp_partition_t *running =
    esp_ota_get_running_partition();

  if (!running) {
    USBSerial.println(
      "[WATCH] OTA boot verify: running partition unavailable");
    return;
  }

  esp_ota_img_states_t state;
  esp_err_t stateErr =
    esp_ota_get_state_partition(
      running,
      &state);

  USBSerial.print(
    "[WATCH] Running partition: ");
  USBSerial.print(running->label);
  USBSerial.print(" @ 0x");
  USBSerial.print(running->address, HEX);

  if (stateErr == ESP_OK) {
    USBSerial.print(" | OTA state=");
    USBSerial.println((int)state);

    if (state == ESP_OTA_IMG_PENDING_VERIFY) {
      esp_err_t validErr =
        esp_ota_mark_app_valid_cancel_rollback();

      USBSerial.print(
        "[WATCH] OTA first-boot validation: ");
      USBSerial.println(
        validErr == ESP_OK
          ? "CONFIRMED"
          : "FAILED");
    }
  } else {
    USBSerial.println(
      " | OTA state unavailable");
  }
}

// -------------------- FIRMWARE FEED / UPDATE NOTIFICATION --------------------
//
// Manifest format:
// VERSION=v0.9.58
// BIN_URL=https://server/Multimatic_Motorsports_Watch_v0_9_57_UI.ino.bin
// NOTES=Short release note shown to the wearer
// MD5=0123456789abcdef0123456789abcdef
//
// Manifest and BIN URLs may use HTTP or HTTPS. Direct authenticated browser
// upload remains the admin override and does not require wearer confirmation.

static int watch_fw_compare_versions(const String &a, const String &b) {
  int am = 0, an = 0, ap = 0;
  int bm = 0, bn = 0, bp = 0;
  const char *as = a.c_str();
  const char *bs = b.c_str();

  if (*as == 'v' || *as == 'V') as++;
  if (*bs == 'v' || *bs == 'V') bs++;

  sscanf(as, "%d.%d.%d", &am, &an, &ap);
  sscanf(bs, "%d.%d.%d", &bm, &bn, &bp);

  if (am != bm) return am > bm ? 1 : -1;
  if (an != bn) return an > bn ? 1 : -1;
  if (ap != bp) return ap > bp ? 1 : -1;
  return 0;
}

static String watch_fw_manifest_value(const String &manifest,
                                      const char *key) {
  String prefix = String(key) + "=";
  int start = 0;

  while (start < manifest.length()) {
    int end = manifest.indexOf('\n', start);
    if (end < 0) end = manifest.length();

    String line = manifest.substring(start, end);
    line.trim();

    if (line.startsWith(prefix)) {
      String value = line.substring(prefix.length());
      value.trim();
      return value;
    }

    start = end + 1;
  }

  return "";
}

