static void watch_charging_screen_render() {
  if (!watchChargingScreen ||
      !watchChargingBatteryFill ||
      !watchChargingPercentLabel ||
      !watchChargingStateLabel) {
    return;
  }

  lv_color_t batteryColor =
    watchBatteryCharging
      ? C_AMBER
      : C_BLUE;

  if (watchBatteryPct >= 95) {
    batteryColor =
      C_GREEN;
  }

  char pctText[8];

  if (watchBatteryPct >= 0 &&
      watchBatteryPct <= 100) {
    snprintf(
      pctText,
      sizeof(pctText),
      "%d%%",
      watchBatteryPct);
  } else {
    snprintf(
      pctText,
      sizeof(pctText),
      "--%%");
  }

  lv_label_set_text(
    watchChargingPercentLabel,
    pctText);
  lv_obj_set_style_text_color(
    watchChargingPercentLabel,
    batteryColor,
    0);

  if (watchBatteryCharging) {
    lv_label_set_text(
      watchChargingStateLabel,
      "CHARGING");

    if (watchChargingSubLabel) {
      lv_label_set_text(
        watchChargingSubLabel,
        "Battery charging");
    }
  } else if (watchBatteryPct >= 95) {
    lv_label_set_text(
      watchChargingStateLabel,
      "CHARGED");

    if (watchChargingSubLabel) {
      lv_label_set_text(
        watchChargingSubLabel,
        "Charge complete");
    }
  } else {
    lv_label_set_text(
      watchChargingStateLabel,
      "USB POWER");

    if (watchChargingSubLabel) {
      lv_label_set_text(
        watchChargingSubLabel,
        "External USB connected");
    }
  }

  lv_obj_set_style_bg_color(
    watchChargingStateLabel,
    batteryColor,
    0);
  lv_obj_set_style_text_color(
    watchChargingStateLabel,
    C_BG,
    0);

  // Animate the battery only while actively charging.
  int displayFillPct = 0;

  if (watchBatteryCharging) {
    static const uint8_t animPct[8] = {
      10, 22, 36, 50, 64, 78, 90, 100
    };

    displayFillPct =
      animPct[
        watchBatteryAnimStep & 0x07];
  } else if (watchBatteryPct >= 0 &&
             watchBatteryPct <= 100) {
    displayFillPct =
      watchBatteryPct;
  }

  int fillWidth =
    (136 * displayFillPct) / 100;

  if (displayFillPct > 0 &&
      fillWidth < 6) {
    fillWidth = 6;
  }

  if (fillWidth > 136) {
    fillWidth = 136;
  }

  lv_obj_set_width(
    watchChargingBatteryFill,
    fillWidth);

  lv_obj_set_style_bg_color(
    watchChargingBatteryFill,
    batteryColor,
    0);
}

static void watch_charging_screen_sync() {
  if (!rootScreen) {
    return;
  }

  if (watchBatteryVbusPresent) {
    // New cable/USB-power session: automatically show charging standby.
    if (!watchChargingVbusWasPresent) {
      watchChargingVbusWasPresent = true;
      watchChargingScreenDismissed = false;
    }

    // PWR can dismiss charging standby without unplugging the cable.
    if (watchChargingScreenDismissed) {
      if (watchChargingScreen) {
        watch_charging_screen_hide();
      }
      return;
    }

    if (!watchChargingScreen) {
      watch_charging_screen_create();
    }

    watchChargingScreenVisible = true;
    watchLastActivityMs = millis();

    if (!watchScreenOn) {
      watch_screen_wake();
    }

    watch_charging_screen_render();

    // Charging screen must always stay above pageBody and the fixed bottom
    // navigation, including during boot-time Home construction/rebuilds.
    if (watchChargingScreen) {
      lv_obj_move_foreground(
        watchChargingScreen);
    }

    if (headerStatusBar) {
      lv_obj_move_foreground(
        headerStatusBar);
    }
  } else {
    // Cable removed: return to normal UI and re-arm for the next plug-in.
    watchChargingVbusWasPresent = false;
    watchChargingScreenDismissed = false;

    if (watchChargingScreen) {
      watch_charging_screen_hide();
    }
  }
}


static void watch_battery_eta_update() {
  // Do not learn discharge rate while on USB or actively charging.
  if (!watchBatteryConnected ||
      watchBatteryPct < 0 ||
      watchBatteryPct > 100 ||
      watchBatteryVbusPresent ||
      watchBatteryCharging) {
    watchBatteryEtaAnchorPct = -1;
    watchBatteryEtaAnchorMs = 0;
    return;
  }

  uint32_t now = millis();

  if (watchBatteryEtaAnchorPct < 0) {
    watchBatteryEtaAnchorPct = watchBatteryPct;
    watchBatteryEtaAnchorMs = now;
    return;
  }

  // Gauge bounce upward: restart the observation window rather than treating
  // it as negative consumption.
  if (watchBatteryPct >
      watchBatteryEtaAnchorPct) {
    watchBatteryEtaAnchorPct = watchBatteryPct;
    watchBatteryEtaAnchorMs = now;
    return;
  }

  int pctDrop =
    watchBatteryEtaAnchorPct -
    watchBatteryPct;

  uint32_t elapsedMs =
    now -
    watchBatteryEtaAnchorMs;

  if (pctDrop < 1 ||
      elapsedMs <
        WATCH_BATTERY_ETA_MIN_WINDOW_MS) {
    return;
  }

  float measuredRate =
    ((float)pctDrop *
     3600000.0f) /
    (float)elapsedMs;

  // Reject implausible gauge jumps but allow a broad range for Wi-Fi/BLE,
  // AMOLED-on, BF1 scan, and other high-load watch states.
  if (measuredRate >= 0.2f &&
      measuredRate <= 40.0f) {
    if (watchBatteryEtaValid) {
      watchBatteryDischargePctPerHour =
        (watchBatteryDischargePctPerHour *
         0.70f) +
        (measuredRate * 0.30f);
    } else {
      watchBatteryDischargePctPerHour =
        measuredRate;
      watchBatteryEtaValid = true;
    }
  }

  watchBatteryEtaAnchorPct =
    watchBatteryPct;
  watchBatteryEtaAnchorMs =
    now;
}

static void watch_battery_format_eta(
    char *out,
    size_t outSize) {
  if (!out || outSize == 0) {
    return;
  }

  if (!watchBatteryConnected ||
      watchBatteryPct < 0 ||
      watchBatteryPct > 100) {
    snprintf(
      out,
      outSize,
      "Unavailable");
    return;
  }

  if (watchBatteryVbusPresent ||
      watchBatteryCharging) {
    snprintf(
      out,
      outSize,
      "Charging / USB power");
    return;
  }

  if (!watchBatteryEtaValid ||
      watchBatteryDischargePctPerHour <= 0.0f) {
    snprintf(
      out,
      outSize,
      "Learning...");
    return;
  }

  float hoursRemaining =
    (float)watchBatteryPct /
    watchBatteryDischargePctPerHour;

  if (hoursRemaining > 99.0f) {
    snprintf(
      out,
      outSize,
      "99h+ remaining");
    return;
  }

  int totalMinutes =
    (int)(
      hoursRemaining *
      60.0f +
      0.5f);

  int hours =
    totalMinutes / 60;

  int minutes =
    totalMinutes % 60;

  if (hours > 0) {
    snprintf(
      out,
      outSize,
      "~%dh %02dm remaining",
      hours,
      minutes);
  } else {
    snprintf(
      out,
      outSize,
      "~%dm remaining",
      minutes);
  }
}

static void watch_battery_format_settings_subtitle(
    char *out,
    size_t outSize) {
  if (!out || outSize == 0) {
    return;
  }

  char eta[32];
  watch_battery_format_eta(
    eta,
    sizeof(eta));

  if (watchBatteryPct >= 0 &&
      watchBatteryPct <= 100) {
    snprintf(
      out,
      outSize,
      "%d%%  /  %s",
      watchBatteryPct,
      eta);
  } else {
    snprintf(
      out,
      outSize,
      "Battery status unavailable");
  }
}

static void watch_battery_poll_pmic() {
  if (!watchPwrButtonReady) {
    return;
  }

  uint8_t status1 = 0;
  uint8_t status2 = 0;
  uint8_t pct = 0;

  if (!watch_axp_read_reg(
        WATCH_AXP2101_STATUS1,
        status1)) {
    return;
  }

  if (!watch_axp_read_reg(
        WATCH_AXP2101_STATUS2,
        status2)) {
    return;
  }

  watchBatteryConnected =
    (status1 & 0x08) != 0;

  // XPowersLib semantics:
  // STATUS1 bit 5 = VBUS good
  // STATUS2 bit 3 = VBUS direction flag, VBUS input when clear.
  watchBatteryVbusPresent =
    ((status1 & 0x20) != 0) &&
    ((status2 & 0x08) == 0);

  // XPowersLib isCharging(): STATUS2[7:5] == 001.
  watchBatteryCharging =
    ((status2 >> 5) & 0x07) == 0x01;

  if (watchBatteryConnected &&
      watch_axp_read_reg(
        WATCH_AXP2101_BAT_PERCENT,
        pct) &&
      pct <= 100) {
    watchBatteryPct =
      (int)pct;
  } else {
    watchBatteryPct =
      -1;
  }

  watch_battery_eta_update();
  watch_battery_header_render();
  watch_charging_screen_sync();
}

static void watch_battery_service() {
  uint32_t now =
    millis();

  if (watchPwrButtonReady &&
      (watchBatteryLastPollMs == 0 ||
       (now - watchBatteryLastPollMs) >=
         WATCH_BATTERY_POLL_MS)) {
    watchBatteryLastPollMs =
      now;

    watch_battery_poll_pmic();
  }

  if (watchBatteryCharging &&
      (now - watchBatteryLastAnimMs) >=
        WATCH_BATTERY_ANIM_MS) {
    watchBatteryLastAnimMs =
      now;

    watchBatteryAnimStep =
      (watchBatteryAnimStep + 1) & 0x07;

    watch_battery_header_render();
    watch_charging_screen_render();
  }
}

static void watch_pmu_shutdown() {
  USBSerial.println(
    "[WATCH] PWR held 2s -> PMIC SHUTDOWN");

  // Blank the AMOLED before cutting the PMIC rails.
  gfx->fillScreen(
    RGB565_BLACK);
  gfx->displayOff();

  delay(80);

  // AXP2101 software power-off: REG10H bit 0.
  uint8_t common = 0;

  if (watch_axp_read_reg(
        WATCH_AXP2101_COMMON_CONFIG,
        common)) {
    watch_axp_write_reg(
      WATCH_AXP2101_COMMON_CONFIG,
      common | 0x01);
  }

  // If shutdown does not occur for any reason, stay inert.
  while (true) {
    delay(1000);
  }
}

