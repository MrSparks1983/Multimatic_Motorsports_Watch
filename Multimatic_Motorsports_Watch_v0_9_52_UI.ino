// ============================================================
// LIVE BF1 TYPE-73 BLE
// ============================================================
// This section reuses the proven Multimatic TPMS Pro Type-73
// manufacturer-data filter and decoder.
//
// Company ID = 2237 (0x08BD, little endian in manufacturer data)
// Type byte  = 73
// One-second active BLE scan passes
// Strongest valid BF1 packet in each pass wins
// Sensor data is held for 60 seconds between valid packets.
// ============================================================

#define BF1_MIN_RSSI       -60
#define BF1_SENSOR_TIMEOUT 60000UL

static const uint8_t BF1_KEY_32[32] = {
  66, 109, 28, 51, 254, 209, 160, 143,
  21, 58, 75, 100, 169, 134, 247, 216,
  66, 236, 49, 159, 164, 10, 215, 121,
  161, 15, 210, 124, 71, 233, 52, 154
};


static BLEScan *bf1BleScan = nullptr;
static bool bf1BleInitialized = false;
static bool bf1ScanPassRunning = false;
static volatile bool bf1ScanPassComplete = false;

static portMUX_TYPE bf1DataMux = portMUX_INITIALIZER_UNLOCKED;

static Bf1LiveData bf1PassBest = {};
static bool bf1PassFound = false;
static int bf1PassHighestRssi = BF1_MIN_RSSI - 1;

static Bf1LiveData bf1LastValid = {};
static bool bf1HasLastValid = false;

static uint32_t bf1LastUiRefreshMs = 0;
static uint32_t bf1ValidPacketCount = 0;

// Prevent live BF1 refreshes from fighting the user's vertical scrolling.
static uint32_t bf1LastScrollInteractionMs = 0;
static int32_t bf1SavedScrollY = 0;
static bool bf1ProgrammaticScroll = false;

// Smooth BF1 radar comet animation.
// 33 ms ~= 30 FPS, 1200 ms per revolution to match the fast scan feel
// of the handheld TPMS tool.
static lv_timer_t *bf1RadarAnimTimer = nullptr;
