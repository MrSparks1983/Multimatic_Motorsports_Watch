static void wifi_network_select_cb(lv_event_t *e) {
  int index =
    (int)(intptr_t)lv_event_get_user_data(e);

  if (index < 0 || index >= wifiScanCount) return;

  // Open networks connect immediately. Secured networks use the on-screen
  // keyboard/password dialog.
  if (wifiScanAuth[index] == WIFI_AUTH_OPEN) {
    wifi_connect_selected(
      wifiScanSsid[index],
      "",
      true);

    if (activePageId == PAGE_SETTINGS) {
      build_page(PAGE_SETTINGS);
    }
  } else {
    wifi_open_password_overlay(index);
  }
}

static void wifi_scan_execute(void *data) {
  LV_UNUSED(data);

  wifiScanCount = 0;

  int found =
    WiFi.scanNetworks(
      false,   // synchronous
      true     // show hidden
    );

  if (found > 0) {
    int limit =
      found < SETTINGS_WIFI_MAX
        ? found
        : SETTINGS_WIFI_MAX;

    for (int i = 0; i < limit; i++) {
      wifiScanSsid[i] = WiFi.SSID(i);
      if (wifiScanSsid[i].length() == 0) {
        wifiScanSsid[i] = "<HIDDEN>";
      }

      wifiScanRssi[i] = WiFi.RSSI(i);
      wifiScanAuth[i] = WiFi.encryptionType(i);
      wifiScanCount++;
    }
  }

  WiFi.scanDelete();
  wifiScanInProgress = false;

  if (found < 0) {
    settingsStatusLine = "Wi-Fi scan failed";
  } else {
    settingsStatusLine =
      String(wifiScanCount) + " Wi-Fi networks shown";
  }

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}

static void wifi_scan_cb(lv_event_t *e) {
  LV_UNUSED(e);

  if (wifiScanInProgress) return;

  wifiScanInProgress = true;
  settingsStatusLine = "Scanning Wi-Fi...";

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }

  // Let LVGL draw the SCANNING state before the synchronous radio scan.
  lv_async_call(wifi_scan_execute, nullptr);
}

static void settings_ble_select_cb(lv_event_t *e) {
  int index =
    (int)(intptr_t)lv_event_get_user_data(e);

  if (index < 0 || index >= settingsBleCount) return;

  settingsBleSelectedName =
    settingsBleName[index];
  settingsBleSelectedMac =
    settingsBleMac[index];

  if (connectivityPrefsReady) {
    connectivityPrefs.putString(
      "ble_name",
      settingsBleSelectedName);
    connectivityPrefs.putString(
      "ble_mac",
      settingsBleSelectedMac);
  }

  ble_ui_set_selected();

  settingsStatusLine =
    "BLE target saved: "
    + settingsBleSelectedName;

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}

static void settings_ble_forget_cb(lv_event_t *e) {
  LV_UNUSED(e);

  settingsBleSelectedName = "";
  settingsBleSelectedMac = "";

  if (connectivityPrefsReady) {
    connectivityPrefs.remove("ble_name");
    connectivityPrefs.remove("ble_mac");
  }

  ble_ui_set_disconnected();
  settingsStatusLine = "BLE target removed";

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}

static void settings_ble_scan_cb(lv_event_t *e) {
  LV_UNUSED(e);

  if (settingsBleScanActive) return;

  if (!bf1_ble_init() || !bf1BleScan) {
    settingsStatusLine = "BLE scanner unavailable";
    ble_ui_set_disconnected();

    if (activePageId == PAGE_SETTINGS) {
      build_page(PAGE_SETTINGS);
    }
    return;
  }

  if (bf1BleScan->isScanning()) {
    bf1BleScan->stop();
    delay(20);
  }

  settingsBleCount = 0;
  for (int i = 0; i < SETTINGS_BLE_MAX; i++) {
    settingsBleName[i] = "";
    settingsBleMac[i] = "";
    settingsBleRssi[i] = -127;
  }

  settingsBleScanComplete = false;
  settingsBleScanActive = true;
  settingsStatusLine = "Scanning BLE devices...";
  ble_ui_set_pairing();

  bool started =
    bf1BleScan->start(
      4,
      bf1_scan_complete_cb,
      false);

  if (!started) {
    settingsBleScanActive = false;
    settingsStatusLine = "BLE scan failed";

    if (settingsBleSelectedMac.length() > 0) {
      ble_ui_set_selected();
    } else {
      ble_ui_set_disconnected();
    }
  }

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}

