// -------------------- CREW QUICK MESSAGE --------------------

static void close_crew_quick_popup() {
  if (crewQuickOverlay) {
    lv_obj_delete(crewQuickOverlay);
    crewQuickOverlay = nullptr;
  }
}

static void crew_quick_cancel_cb(lv_event_t *e) {
  LV_UNUSED(e);
  close_crew_quick_popup();
}

static void crew_quick_send_cb(lv_event_t *e) {
  const char *msg = (const char *)lv_event_get_user_data(e);
  if (!msg) return;

  snprintf(crewLastQuickMessage, sizeof(crewLastQuickMessage), "%s", msg);
  crewHasQuickMessage = true;

  close_crew_quick_popup();

  // Rebuild Crew so the newly selected message appears immediately.
  build_page(PAGE_CREW);
}

static lv_obj_t *make_quick_message_button(lv_obj_t *parent,
                                           const char *text,
                                           lv_event_cb_t cb,
                                           void *userData = nullptr) {
  lv_obj_t *btn = lv_button_create(parent);
  lv_obj_set_width(btn, LV_PCT(100));
  lv_obj_set_height(btn, 46);
  lv_obj_set_style_radius(btn, 13, 0);
  lv_obj_set_style_bg_color(btn, lv_color_hex(0x101820), 0);
  lv_obj_set_style_border_color(btn, C_BORDER, 0);
  lv_obj_set_style_border_width(btn, 1, 0);
  lv_obj_set_style_shadow_width(btn, 0, 0);
  lv_obj_set_ext_click_area(btn, 4);

  lv_obj_set_style_bg_color(btn, C_RED, LV_STATE_PRESSED);
  lv_obj_set_style_border_color(btn, C_TEXT, LV_STATE_PRESSED);

  lv_obj_add_event_cb(btn, cb, LV_EVENT_CLICKED, userData);

  lv_obj_t *lbl = make_label(btn, text, 13, C_TEXT);
  lv_obj_clear_flag(lbl, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_center(lbl);
  return btn;
}

