static bool watch_fw_check_now() {
  if (WiFi.status() != WL_CONNECTED) {
    watchFwLastCheckMessage = "Update check requires Wi-Fi";
    return false;
  }

  if (watchFwFeedUrl.length() == 0) {
    watchFwLastCheckMessage = "Update feed not configured";
    return false;
  }

  if (!watch_fw_url_supported(
        watchFwFeedUrl)) {
    watchFwLastCheckMessage =
      "Feed URL must use HTTP or HTTPS";
    return false;
  }

  USBSerial.print("[WATCH] Firmware check (");
  USBSerial.print(
    watch_fw_url_is_https(
      watchFwFeedUrl)
      ? "HTTPS"
      : "HTTP");
  USBSerial.print("): ");
  USBSerial.println(watchFwFeedUrl);

  WiFiClient plainClient;
  WiFiClientSecure secureClient;
  HTTPClient http;

  if (!watch_fw_http_begin(
        http,
        plainClient,
        secureClient,
        watchFwFeedUrl)) {
    watchFwLastCheckMessage =
      "Could not open HTTP/HTTPS update feed";
    return false;
  }

  http.setConnectTimeout(5000);
  http.setTimeout(7000);

  int code = http.GET();

  if (code != HTTP_CODE_OK) {
    watchFwLastCheckMessage = "Update feed response " + String(code);
    http.end();
    return false;
  }

  String manifest = http.getString();
  http.end();

  String version = watch_fw_manifest_value(manifest, "VERSION");
  String binUrl = watch_fw_manifest_value(manifest, "BIN_URL");
  String notes = watch_fw_manifest_value(manifest, "NOTES");
  String md5 = watch_fw_manifest_value(manifest, "MD5");

  if (version.length() == 0 || binUrl.length() == 0) {
    watchFwLastCheckMessage = "Invalid firmware manifest";
    return false;
  }

  if (!watch_fw_url_supported(
        binUrl)) {
    watchFwLastCheckMessage =
      "Firmware BIN URL must use HTTP or HTTPS";
    return false;
  }

  watchFwAvailableVersion = version;
  watchFwAvailableBinUrl = binUrl;
  watchFwAvailableNotes = notes;
  watchFwAvailableMd5 = md5;

  if (watch_fw_compare_versions(
        version,
        WATCH_FIRMWARE_VERSION) > 0) {
    watchFwUpdateAvailable = true;
    watchFwLastCheckMessage =
      "New firmware available: " + version;

    USBSerial.print("[WATCH] New firmware available: ");
    USBSerial.println(version);
    return true;
  }

  watchFwUpdateAvailable = false;
  watchFwLastCheckMessage = "Firmware is up to date";
  return true;
}

static void watch_fw_install_from_feed() {
  if (watchFwInstallActive ||
      watchFwAvailableBinUrl.length() == 0) {
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    watchFwLastCheckMessage =
      "Install failed: Wi-Fi disconnected";
    watchFwInstallRequested = false;
    return;
  }

  if (!watchBatteryVbusPresent &&
      (!watchBatteryConnected || watchBatteryPct < 50)) {
    watchFwLastCheckMessage =
      "Install blocked: connect USB or charge above 50%";
    watchFwInstallRequested = false;
    return;
  }

  watchFwInstallRequested = false;
  watchFwInstallActive = true;

  if (watchOtaServerRunning) {
    watchOtaServer.stop();
    watchOtaServerRunning = false;
  }

  watch_ota_progress_show(
    "FIRMWARE UPDATE",
    "Connecting to firmware server...");

  watch_ota_progress_update(
    1,
    "Downloading firmware...");

  USBSerial.print(
    "[WATCH] Firmware download (");
  USBSerial.print(
    watch_fw_url_is_https(
      watchFwAvailableBinUrl)
      ? "HTTPS"
      : "HTTP");
  USBSerial.print(
    "): ");
  USBSerial.println(
    watchFwAvailableBinUrl);

  WiFiClient plainClient;
  WiFiClientSecure secureClient;
  HTTPClient http;

  if (!watch_fw_http_begin(
        http,
        plainClient,
        secureClient,
        watchFwAvailableBinUrl)) {
    watchFwLastCheckMessage =
      "Install failed: could not open HTTP/HTTPS firmware URL";
    watch_ota_progress_finish(
      false,
      "Could not open firmware URL.");
    watchFwInstallActive = false;
    return;
  }

  http.setConnectTimeout(6000);
  http.setTimeout(12000);
  http.setFollowRedirects(
    HTTPC_STRICT_FOLLOW_REDIRECTS);

  int code = http.GET();

  if (code != HTTP_CODE_OK) {
    watchFwLastCheckMessage =
      "Install failed: firmware HTTP " + String(code);
    watch_ota_progress_finish(
      false,
      "Firmware server returned an error.");
    http.end();
    watchFwInstallActive = false;
    return;
  }

  int total = http.getSize();
  size_t updateSize =
    total > 0 ? (size_t)total : UPDATE_SIZE_UNKNOWN;

  const esp_partition_t *runningPartition =
    esp_ota_get_running_partition();

  const esp_partition_t *targetPartition =
    esp_ota_get_next_update_partition(
      nullptr);

  if (!targetPartition ||
      !runningPartition ||
      targetPartition->address ==
        runningPartition->address) {
    watchFwLastCheckMessage =
      "Install failed: invalid OTA partition layout";
    watch_ota_progress_finish(
      false,
      "No valid inactive OTA partition is available.");
    http.end();
    watchFwInstallActive = false;
    return;
  }

  USBSerial.print(
    "[WATCH] OTA target partition: ");
  USBSerial.print(
    targetPartition->label);
  USBSerial.print(
    " @ 0x");
  USBSerial.println(
    targetPartition->address,
    HEX);

  if (!Update.begin(updateSize)) {
    watchFwLastCheckMessage = "Install failed: Update.begin";
    watch_ota_progress_finish(
      false,
      "Could not prepare OTA partition.");
    Update.printError(USBSerial);
    http.end();
    watchFwInstallActive = false;
    return;
  }

  if (watchFwAvailableMd5.length() == 32) {
    Update.setMD5(watchFwAvailableMd5.c_str());
  }

  NetworkClient *stream = http.getStreamPtr();
  size_t writtenTotal = 0;
  uint32_t lastDataMs = millis();

  while (total < 0 ||
         writtenTotal < (size_t)total) {
    size_t available =
      stream->available();

    if (available > 0) {
      size_t toRead =
        available;

      if (toRead > sizeof(watchFwDownloadBuffer)) {
        toRead =
          sizeof(watchFwDownloadBuffer);
      }

      if (total > 0) {
        size_t remaining =
          (size_t)total -
          writtenTotal;

        if (toRead > remaining) {
          toRead =
            remaining;
        }
      }

      int got =
        stream->readBytes(
          watchFwDownloadBuffer,
          toRead);

      if (got > 0) {
        size_t written =
          Update.write(
            watchFwDownloadBuffer,
            (size_t)got);

        if (written !=
            (size_t)got) {
          watchFwLastCheckMessage =
            "Install failed while writing";
          watch_ota_progress_finish(
            false,
            "Firmware write failed.");
          Update.printError(
            USBSerial);
          Update.abort();
          http.end();
          watchFwInstallActive =
            false;
          return;
        }

        writtenTotal +=
          written;
        lastDataMs =
          millis();

        if (total > 0) {
          int pct =
            (int)(
              (writtenTotal *
               100UL) /
              (size_t)total);

          if (pct > 99 &&
              writtenTotal <
                (size_t)total) {
            pct = 99;
          }

          char status[70];
          snprintf(
            status,
            sizeof(status),
            "Downloading firmware... %lu / %lu KB",
            (unsigned long)(
              writtenTotal /
              1024UL),
            (unsigned long)(
              (size_t)total /
              1024UL));

          watch_ota_progress_update(
            pct,
            status);
        } else {
          int activityPct =
            5 +
            (int)(
              (writtenTotal /
               (64UL * 1024UL)) %
              86UL);

          watch_ota_progress_update(
            activityPct,
            "Downloading and writing firmware...");
        }

        // Yield after every flash/network chunk. A fast local server can keep
        // this loop continuously busy long enough to starve the Arduino task.
        delay(1);
      }
    } else {
      // For known-length files, a closed connection before every byte arrives
      // is an error. v0.9.51 used Update.end(true), which could accept a
      // truncated download and then reboot back into the previous firmware.
      if (total > 0 &&
          !http.connected() &&
          writtenTotal <
            (size_t)total) {
        watchFwLastCheckMessage =
          "Install failed: incomplete download";
        watch_ota_progress_finish(
          false,
          "Firmware download ended early. Current firmware retained.");
        Update.abort();
        http.end();
        watchFwInstallActive =
          false;
        return;
      }

      // Unknown-length responses finish when the connection is closed and all
      // buffered bytes have been consumed.
      if (total < 0 &&
          !http.connected() &&
          stream->available() == 0) {
        break;
      }

      if (millis() -
            lastDataMs >
          12000UL) {
        watchFwLastCheckMessage =
          "Install failed: download timeout";
        watch_ota_progress_finish(
          false,
          "Firmware download timed out.");
        Update.abort();
        http.end();
        watchFwInstallActive =
          false;
        return;
      }

      delay(1);
    }
  }

  // A known Content-Length must match exactly before activation.
  if (total > 0 &&
      writtenTotal !=
        (size_t)total) {
    watchFwLastCheckMessage =
      "Install failed: incomplete firmware";
    watch_ota_progress_finish(
      false,
      "Incomplete firmware image. Current firmware retained.");
    Update.abort();
    http.end();
    watchFwInstallActive =
      false;
    return;
  }

  http.end();

  bool updateEnded =
    total > 0
      ? Update.end(false)
      : Update.end(true);

  if (!updateEnded ||
      Update.hasError()) {
    watchFwLastCheckMessage =
      "Install failed - current firmware retained";
    watch_ota_progress_finish(
      false,
      "Firmware validation failed. Current firmware retained.");
    Update.printError(
      USBSerial);
    watchFwInstallActive =
      false;
    return;
  }

  // Verify the downloaded image itself contains the exact VERSION promised
  // by the manifest. If the URL points at a stale or renamed .bin, do not
  // reboot into it even though the ESP image is otherwise structurally valid.
  if (watchFwAvailableVersion.length() > 0 &&
      !watch_partition_contains_ascii(
        targetPartition,
        writtenTotal,
        watchFwAvailableVersion)) {
    watchFwLastCheckMessage =
      "Install failed: BIN version mismatch";

    watch_ota_restore_running_partition(
      runningPartition);

    watch_ota_progress_finish(
      false,
      "Firmware file does not match manifest VERSION.");

    USBSerial.print(
      "[WATCH] OTA BIN does not contain expected version: ");
    USBSerial.println(
      watchFwAvailableVersion);

    watchFwInstallActive =
      false;
    return;
  }

  // Arduino Update normally activates its target partition in Update.end().
  // Verify that result before rebooting; if necessary, request it explicitly.
  const esp_partition_t *bootPartition =
    esp_ota_get_boot_partition();

  bool bootMatchesTarget =
    bootPartition &&
    targetPartition &&
    bootPartition->address ==
      targetPartition->address;

  if (!bootMatchesTarget) {
    USBSerial.println(
      "[WATCH] OTA boot partition not switched by Update.end(); setting explicitly.");

    if (!watch_ota_activate_target(
          targetPartition)) {
      watchFwLastCheckMessage =
        "Install failed: could not activate firmware";

      watch_ota_restore_running_partition(
        runningPartition);

      watch_ota_progress_finish(
        false,
        "Firmware downloaded but could not be activated.");

      watchFwInstallActive =
        false;
      return;
    }

    bootPartition =
      esp_ota_get_boot_partition();

    bootMatchesTarget =
      bootPartition &&
      bootPartition->address ==
        targetPartition->address;
  }

  if (!bootMatchesTarget) {
    watchFwLastCheckMessage =
      "Install failed: boot partition unchanged";
    watch_ota_progress_finish(
      false,
      "Firmware was not selected for next boot.");
    watchFwInstallActive =
      false;
    return;
  }

  USBSerial.print(
    "[WATCH] OTA ready. Next boot partition: ");
  USBSerial.print(
    bootPartition->label);
  USBSerial.print(
    " @ 0x");
  USBSerial.println(
    bootPartition->address,
    HEX);

  watchFwLastCheckMessage =
    "Firmware installed - rebooting";

  watch_ota_progress_finish(
    true,
    "Firmware verified and activated. Rebooting...");

  // Do not restart from inside the synchronous feed installer. Defer the
  // restart to watch_ota_service(), after the UI/network call stack unwinds.
  watchFwInstallActive = false;
  watchOtaRebootPending = true;
  watchOtaRebootAtMs = millis() + 1500UL;
}

static void watch_fw_update_service() {
  wl_status_t wifiState = WiFi.status();
  uint32_t now = millis();

  if (wifiState != watchFwLastWifiState) {
    watchFwLastWifiState = wifiState;

    if (wifiState == WL_CONNECTED) {
      watchFwWifiConnectedSinceMs = now;
    } else {
      watchFwWifiConnectedSinceMs = 0;
    }
  }

  if (watchFwInstallRequested && !watchFwInstallActive) {
    watch_fw_install_from_feed();
    return;
  }

  if (watchFwInstallActive) return;

  bool firstConnectedCheck =
    wifiState == WL_CONNECTED &&
    watchFwFeedUrl.length() > 0 &&
    watchFwLastCheckMs == 0 &&
    watchFwWifiConnectedSinceMs > 0 &&
    (now - watchFwWifiConnectedSinceMs) >=
      WATCH_FW_FIRST_CHECK_DELAY_MS;

  bool periodicCheck =
    wifiState == WL_CONNECTED &&
    watchFwFeedUrl.length() > 0 &&
    watchFwLastCheckMs > 0 &&
    (now - watchFwLastCheckMs) >=
      WATCH_FW_AUTO_CHECK_INTERVAL_MS;

  if (watchFwManualCheckRequested ||
      firstConnectedCheck ||
      periodicCheck) {
    watchFwManualCheckRequested = false;
    watchFwLastCheckMs = now;
    bool checkOk =
      watch_fw_check_now();

    if (activePageId == PAGE_SETTINGS &&
        settingsSection == SETTINGS_SECTION_FIRMWARE) {
      build_page(PAGE_SETTINGS);
    }

    if (checkOk &&
        watchFwUpdateAvailable) {
      // Manual/settings result gets a second explicit presentation path.
      // Even if the modal cannot appear right now, DOWNLOAD & INSTALL remains
      // visible on the Firmware Update page.
      watch_fw_notice_show();
    }
  }

  if (watchFwUpdateAvailable) {
    watch_fw_notice_show();
  }
}

static void settings_fw_install_cb(lv_event_t *e) {
  LV_UNUSED(e);

  if (!watchFwUpdateAvailable ||
      watchFwAvailableBinUrl.length() == 0) {
    settingsStatusLine =
      "No downloadable firmware is available";
    watch_note_activity();
    build_page(PAGE_SETTINGS);
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    settingsStatusLine =
      "Connect Wi-Fi before installing";
    watch_note_activity();
    build_page(PAGE_SETTINGS);
    return;
  }

  if (!watchBatteryVbusPresent &&
      (!watchBatteryConnected ||
       watchBatteryPct < 50)) {
    settingsStatusLine =
      "Install requires USB power or battery >=50%";
    watch_note_activity();
    build_page(PAGE_SETTINGS);
    return;
  }

  // A manual install from Firmware Settings is explicit wearer approval.
  watchFwNoticeDismissedVersion = "";
  watch_fw_notice_hide();

  settingsStatusLine =
    "Starting firmware download...";

  watchFwInstallRequested = true;
  watch_note_activity();
}

static void settings_fw_check_cb(lv_event_t *e) {
  LV_UNUSED(e);

  if (watchFwFeedUrl.length() == 0) {
    settingsStatusLine =
      "Configure update feed from admin browser";
  } else if (WiFi.status() != WL_CONNECTED) {
    settingsStatusLine =
      "Connect Wi-Fi before checking";
  } else {
    settingsStatusLine = "Checking firmware feed...";

    // Manual check overrides a previous LATER dismissal for the same version.
    // This guarantees the install prompt can be presented again.
    watchFwNoticeDismissedVersion = "";
    watch_fw_notice_hide();

    watchFwManualCheckRequested = true;
  }

  watch_note_activity();
}

// -------------------- SECURE WI-FI WEB OTA --------------------
//
// Workflow:
// 1. Watch and computer join the same Wi-Fi.
// 2. OTA is available automatically unless disabled in Settings.
// 3. Browser opens the watch IP and authenticates as admin.
// 4. Browser uploads the Arduino-exported firmware .bin.
// 5. ESP32 writes the inactive OTA app partition and reboots on success.
//
// Security:
// - Fixed HTTP Basic Authentication password.
// - User can manually disable the OTA server in Settings.
// - Same-origin POST check for browser update/configuration forms.

static bool watch_ota_authenticate() {
  if (watchOtaServer.authenticate(
        WATCH_OTA_USERNAME,
        WATCH_OTA_PASSWORD)) {
    return true;
  }

  watchOtaServer.requestAuthentication();
  return false;
}

static bool watch_ota_origin_ok() {
  String origin =
    watchOtaServer.header(
      String(WATCH_OTA_HEADERS[0]));

  String host =
    watchOtaServer.header(
      String(WATCH_OTA_HEADERS[1]));

  // Browsers submit the firmware form from the page served by the watch.
  // If a client supplies an Origin, require it to match this watch exactly.
  if (origin.length() == 0) {
    return true;
  }

  String expectedOrigin =
    String("http://") + host;

  return origin == expectedOrigin;
}

static String watch_ota_url() {
  if (WiFi.status() != WL_CONNECTED) {
    return "";
  }

  return
    String("http://") +
    WiFi.localIP().toString() +
    "/";
}

static void watch_ota_handle_root() {
  if (!watch_ota_authenticate()) {
    return;
  }

  String html;
  html.reserve(3600);

  html +=
    "<!doctype html><html><head>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<title>Multimatic Pro Watch OTA</title>"
    "<style>"
    "body{background:#05080c;color:#f2f4f6;font-family:Arial,sans-serif;margin:0;padding:24px;}"
    ".card{max-width:620px;margin:30px auto;background:#0b121a;border:1px solid #3d4753;"
    "border-radius:18px;padding:24px;box-sizing:border-box;}"
    "h1{font-size:22px;margin:0 0 6px;color:#e31b23;}"
    "h2{font-size:15px;margin:0 0 24px;color:#fff;font-weight:500;}"
    ".meta{color:#9aa5b1;font-size:13px;line-height:1.7;margin-bottom:20px;}"
    ".warn{background:#15100a;border:1px solid #a86d18;border-radius:10px;padding:12px;"
    "color:#f2c36b;font-size:13px;margin-bottom:18px;}"
    "input[type=file],input[type=text]{width:100%;padding:14px;background:#111923;color:#fff;"
    "border:1px solid #46515f;border-radius:10px;box-sizing:border-box;}"
    "button{margin-top:16px;width:100%;padding:14px;border:0;border-radius:10px;"
    "background:#d71920;color:white;font-weight:700;font-size:15px;cursor:pointer;}"
    "button:hover{background:#ef252c;}"
    "</style></head><body><div class='card'>"
    "<h1>MULTIMATIC MOTORSPORTS</h1>"
    "<h2>// PRO WATCH &nbsp; FIRMWARE UPDATE</h2>";

  html +=
    "<div class='meta'>Current firmware: <b>" +
    String(WATCH_FIRMWARE_VERSION) +
    "</b><br>IP address: <b>" +
    WiFi.localIP().toString() +
    "</b><br>Update target: inactive OTA application partition"
    "<br>OTA policy: <b>always enabled unless disabled on watch</b>"
    "<br>Login: <b>admin</b></div>";

  html +=
    "<div class='warn'><b>ADMIN OVERRIDE:</b> Direct .bin upload installs immediately "
    "without requiring approval on the watch. Keep the watch powered and do not "
    "disconnect Wi-Fi while flashing.</div>"
    "<form method='POST' action='/update' enctype='multipart/form-data'>"
    "<input type='file' name='update' accept='.bin,application/octet-stream' required>"
    "<button type='submit'>ADMIN OVERRIDE - UPLOAD & INSTALL</button>"
    "</form>"
    "<hr style='border:0;border-top:1px solid #303945;margin:28px 0'>"
    "<h2>FIRMWARE NOTIFICATION FEED</h2>"
    "<div class='meta'>Set an HTTP or HTTPS manifest URL. The watch checks it after "
    "Wi-Fi connects and every 6 hours, then asks the wearer before installing.</div>"
    "<form method='POST' action='/feed'>"
    "<input type='text' name='url' placeholder='https://server/prowatch/manifest.txt' value='" +
    watchFwFeedUrl +
    "'>"
    "<button type='submit'>SAVE UPDATE FEED</button>"
    "</form></div></body></html>";

  watchOtaServer.sendHeader(
    "Connection",
    "close");

  watchOtaServer.send(
    200,
    "text/html",
    html);
}

static void watch_ota_handle_upload() {
  HTTPUpload &upload =
    watchOtaServer.upload();

  if (upload.status ==
      UPLOAD_FILE_START) {
    watchOtaUploadAuthenticated =
      watchOtaServer.authenticate(
        WATCH_OTA_USERNAME,
        WATCH_OTA_PASSWORD);

    watchOtaUploadSucceeded = false;
    watchOtaUploadFailed = false;

    if (!watchOtaUploadAuthenticated) {
      watchOtaLastMessage =
        "OTA authentication failed";
      return;
    }

    if (!watch_ota_origin_ok()) {
      watchOtaUploadAuthenticated = false;
      watchOtaUploadFailed = true;
      watchOtaLastMessage =
        "OTA blocked: origin mismatch";
      return;
    }

    watchOtaUploadActive = true;
    watchOtaLastMessage =
      "Receiving firmware...";

    watchOtaExpectedUploadBytes = 0;

    String contentLength =
      watchOtaServer.header(
        String(WATCH_OTA_HEADERS[2]));

    if (contentLength.length() > 0) {
      watchOtaExpectedUploadBytes =
        (size_t)strtoul(
          contentLength.c_str(),
          nullptr,
          10);
    }

    watch_ota_progress_show(
      "ADMIN FIRMWARE UPDATE",
      "Receiving firmware from browser...");

    watch_ota_progress_update(
      1,
      "Receiving firmware from browser...");

    USBSerial.print(
      "[WATCH] OTA upload start: ");
    USBSerial.println(
      upload.filename);

    watchOtaUploadRunningPartition =
      esp_ota_get_running_partition();

    watchOtaUploadTargetPartition =
      esp_ota_get_next_update_partition(
        nullptr);

    watchOtaUploadExpectedVersion =
      watch_fw_version_from_filename(
        upload.filename);

    USBSerial.print(
      "[WATCH] Manual OTA expected version: ");
    USBSerial.println(
      watchOtaUploadExpectedVersion.length() > 0
        ? watchOtaUploadExpectedVersion
        : String("(not encoded in filename)"));

    if (!watchOtaUploadRunningPartition ||
        !watchOtaUploadTargetPartition ||
        watchOtaUploadRunningPartition->address ==
          watchOtaUploadTargetPartition->address) {
      watchOtaUploadFailed = true;
      watchOtaUploadActive = false;
      watchOtaLastMessage =
        "OTA failed: invalid partition layout";

      watch_ota_progress_finish(
        false,
        "No valid inactive OTA partition is available.");

      return;
    }

    USBSerial.print(
      "[WATCH] Manual OTA target: ");
    USBSerial.print(
      watchOtaUploadTargetPartition->label);
    USBSerial.print(
      " @ 0x");
    USBSerial.println(
      watchOtaUploadTargetPartition->address,
      HEX);

    // Update.begin() without an explicit size uses the maximum OTA slot.
    if (!Update.begin()) {
      watchOtaUploadFailed = true;
      watchOtaUploadActive = false;
      watchOtaLastMessage =
        "OTA failed: Update.begin";

      watch_ota_progress_finish(
        false,
        "Could not prepare OTA partition.");

      Update.printError(
        USBSerial);
    }

  } else if (
      watchOtaUploadAuthenticated &&
      upload.status ==
        UPLOAD_FILE_WRITE) {

    if (!watchOtaUploadFailed) {
      size_t written =
        Update.write(
          upload.buf,
          upload.currentSize);

      if (written !=
          upload.currentSize) {
        watchOtaUploadFailed = true;
        watchOtaLastMessage =
          "OTA failed while writing";

        watch_ota_progress_finish(
          false,
          "Firmware write failed.");

        Update.printError(
          USBSerial);
      } else {
        int pct = 5;

        if (watchOtaExpectedUploadBytes > 0) {
          pct =
            (int)(
              (upload.totalSize * 100UL) /
              watchOtaExpectedUploadBytes);
          if (pct > 99) pct = 99;
        }

        char status[58];

        snprintf(
          status,
          sizeof(status),
          "Receiving firmware... %lu KB",
          (unsigned long)(
            upload.totalSize /
            1024UL));

        watch_ota_progress_update(
          pct,
          status);
      }
    }

  } else if (
      watchOtaUploadAuthenticated &&
      upload.status ==
        UPLOAD_FILE_END) {

    watchOtaUploadActive = false;

    bool manualEnded =
      !watchOtaUploadFailed &&
      Update.end(true) &&
      !Update.hasError();

    if (manualEnded &&
        watchOtaUploadExpectedVersion.length() > 0 &&
        !watch_partition_contains_ascii(
          watchOtaUploadTargetPartition,
          upload.totalSize,
          watchOtaUploadExpectedVersion)) {
      manualEnded = false;

      watchOtaLastMessage =
        "OTA failed: selected BIN version mismatch";

      watch_ota_restore_running_partition(
        watchOtaUploadRunningPartition);

      watch_ota_progress_finish(
        false,
        "Selected .bin does not contain the version in its filename.");

      USBSerial.print(
        "[WATCH] Manual OTA BIN does not contain expected version: ");
      USBSerial.println(
        watchOtaUploadExpectedVersion);
    }

    if (manualEnded &&
        !watch_ota_activate_target(
          watchOtaUploadTargetPartition)) {
      manualEnded = false;

      watchOtaLastMessage =
        "OTA failed: boot partition unchanged";

      watch_ota_restore_running_partition(
        watchOtaUploadRunningPartition);

      watch_ota_progress_finish(
        false,
        "Firmware written but could not be selected for next boot.");
    }

    if (manualEnded) {
      const esp_partition_t *nextBoot =
        esp_ota_get_boot_partition();

      watchOtaUploadSucceeded = true;
      watchOtaLastMessage =
        "OTA verified - rebooting";

      watch_ota_progress_finish(
        true,
        "Firmware version verified and activated. Rebooting...");

      USBSerial.print(
        "[WATCH] OTA success: ");
      USBSerial.print(
        (unsigned long)upload.totalSize);
      USBSerial.print(
        " bytes | next boot=");
      USBSerial.print(
        nextBoot
          ? nextBoot->label
          : "(null)");
      USBSerial.print(
        " | version=");
      USBSerial.println(
        watchOtaUploadExpectedVersion.length() > 0
          ? watchOtaUploadExpectedVersion
          : String("(unverified filename)"));
    } else {
      watchOtaUploadFailed = true;
      watchOtaUploadSucceeded = false;

      if (watchOtaLastMessage.length() == 0 ||
          watchOtaLastMessage ==
            "Receiving firmware...") {
        watchOtaLastMessage =
          "OTA failed - previous firmware retained";

        watch_ota_progress_finish(
          false,
          "Update failed. Previous firmware retained.");
      }

      Update.printError(
        USBSerial);
    }

  } else if (
      watchOtaUploadAuthenticated &&
      upload.status ==
        UPLOAD_FILE_ABORTED) {
    watchOtaUploadActive = false;
    watchOtaUploadFailed = true;
    watchOtaLastMessage =
      "OTA upload aborted";

    watch_ota_progress_finish(
      false,
      "Browser upload was aborted.");

    Update.abort();

    USBSerial.println(
      "[WATCH] OTA upload aborted");
  }
}

static void watch_ota_handle_update_complete() {
  if (!watchOtaUploadAuthenticated) {
    watchOtaServer.requestAuthentication();
    return;
  }

  watchOtaServer.sendHeader(
    "Connection",
    "close");

  if (watchOtaUploadSucceeded &&
      !Update.hasError()) {
    watchOtaServer.send(
      200,
      "text/html",
      "<html><body style='background:#05080c;color:white;font-family:Arial;padding:30px'>"
      "<h2 style='color:#e31b23'>UPDATE COMPLETE</h2>"
      "<p>Firmware version verified and activated. Pro Watch is rebooting...</p>"
      "</body></html>");

    watchOtaRebootPending = true;
    watchOtaRebootAtMs =
      millis() + 1500UL;
  } else {
    watchOtaServer.send(
      500,
      "text/plain",
      "Firmware update failed. Previous firmware remains active.");
  }
}


static void watch_ota_handle_feed_save() {
  if (!watch_ota_authenticate()) return;

  if (!watch_ota_origin_ok()) {
    watchOtaServer.send(403, "text/plain", "Origin mismatch");
    return;
  }

  String newUrl = watchOtaServer.arg("url");
  newUrl.trim();

  if (newUrl.length() > 0 &&
      !watch_fw_url_supported(
        newUrl)) {
    watchOtaServer.send(
      400,
      "text/plain",
      "Firmware update feed must use http:// or https://");
    return;
  }

  watchFwFeedUrl = newUrl;

  if (connectivityPrefsReady) {
    connectivityPrefs.putString("fwfeed", watchFwFeedUrl);
  }

  watchFwUpdateAvailable = false;
  watchFwAvailableVersion = "";
  watchFwAvailableBinUrl = "";
  watchFwAvailableNotes = "";
  watchFwAvailableMd5 = "";
  watchFwLastCheckMs = 0;
  watchFwNoticeDismissedVersion = "";
  watchFwManualCheckRequested =
    watchFwFeedUrl.length() > 0;

  watchOtaServer.sendHeader("Connection", "close");
  watchOtaServer.send(
    200,
    "text/html",
    "<html><body style='background:#05080c;color:white;font-family:Arial;padding:30px'>"
    "<h2 style='color:#e31b23'>UPDATE FEED SAVED</h2>"
    "<p>The watch will check the feed automatically while connected to Wi-Fi.</p>"
    "<p><a style='color:#56a8ff' href='/'>Return to Firmware Update</a></p>"
    "</body></html>");
}

static void watch_ota_configure_routes() {
  if (watchOtaRoutesConfigured) {
    return;
  }

  watchOtaServer.collectHeaders(
    WATCH_OTA_HEADERS,
    3);

  watchOtaServer.on(
    "/",
    HTTP_GET,
    watch_ota_handle_root);

  watchOtaServer.on(
    "/feed",
    HTTP_POST,
    watch_ota_handle_feed_save);

  watchOtaServer.on(
    "/update",
    HTTP_POST,
    watch_ota_handle_update_complete,
    watch_ota_handle_upload);

  watchOtaServer.onNotFound(
    []() {
      if (!watch_ota_authenticate()) {
        return;
      }

      watchOtaServer.send(
        404,
        "text/plain",
        "Not found");
    });

  watchOtaRoutesConfigured = true;
}


static void watch_ota_start_server_if_ready() {
  if (!watchOtaSessionEnabled ||
      watchOtaServerRunning ||
      WiFi.status() != WL_CONNECTED) {
    return;
  }

  watch_ota_configure_routes();

  watchOtaServer.begin();
  watchOtaServerRunning = true;

  watchOtaLastMessage =
    "OTA ready: " +
    watch_ota_url();

  USBSerial.print(
    "[WATCH] OTA server ready: ");
  USBSerial.println(
    watch_ota_url());

  USBSerial.println(
    "[WATCH] OTA login: admin / fixed password");
}

static void watch_ota_start_session() {
  watchOtaSessionEnabled = true;
  watchOtaUploadAuthenticated = false;
  watchOtaUploadActive = false;
  watchOtaUploadSucceeded = false;
  watchOtaUploadFailed = false;
  watchOtaRebootPending = false;

  if (connectivityPrefsReady) {
    connectivityPrefs.putBool(
      "otaenabled",
      true);
  }

  if (WiFi.status() == WL_CONNECTED) {
    watchOtaLastMessage =
      "OTA ready: " + watch_ota_url();
    watch_ota_start_server_if_ready();
  } else {
    watchOtaLastMessage =
      "OTA armed - waiting for Wi-Fi";
  }
}

static void watch_ota_stop_session() {
  watchOtaSessionEnabled = false;
  watchOtaUploadAuthenticated = false;
  watchOtaUploadActive = false;
  watchOtaUploadSucceeded = false;
  watchOtaUploadFailed = false;
  watchOtaRebootPending = false;

  if (watchOtaServerRunning) {
    watchOtaServer.stop();
    watchOtaServerRunning = false;
  }

  if (connectivityPrefsReady) {
    connectivityPrefs.putBool(
      "otaenabled",
      false);
  }

  watchOtaLastMessage =
    "OTA disabled";

  USBSerial.println(
    "[WATCH] OTA server disabled");
}

static void watch_ota_init() {
  // Enabled state was loaded from NVS. Default is ON.
  watchOtaServerRunning = false;
  watchOtaUploadAuthenticated = false;
  watchOtaUploadActive = false;
  watchOtaUploadSucceeded = false;
  watchOtaUploadFailed = false;
  watchOtaRebootPending = false;

  watchOtaLastMessage =
    watchOtaSessionEnabled
      ? "OTA armed - waiting for Wi-Fi"
      : "OTA disabled";

  watch_ota_configure_routes();
}

static void watch_ota_service() {
  if (watchOtaSessionEnabled) {
    if (WiFi.status() ==
        WL_CONNECTED) {
      watch_ota_start_server_if_ready();

      if (watchOtaServerRunning) {
        watchOtaServer.handleClient();
      }
    } else {
      // Keep the manually-enabled session armed, but close the listener
      // until the saved Wi-Fi connection returns.
      if (watchOtaServerRunning) {
        watchOtaServer.stop();
        watchOtaServerRunning = false;
      }

      watchOtaLastMessage =
        "OTA armed - waiting for Wi-Fi";
    }
  }

  if (watchOtaRebootPending &&
      (int32_t)(
        millis() -
        watchOtaRebootAtMs) >= 0) {
    USBSerial.println(
      "[WATCH] OTA reboot");

    delay(80);
    ESP.restart();
  }
}

static void settings_ota_enable_cb(
    lv_event_t *e) {
  LV_UNUSED(e);

  watch_ota_start_session();

  settingsStatusLine =
    watchOtaLastMessage;

  build_page(
    PAGE_SETTINGS);
}

static void settings_ota_disable_cb(
    lv_event_t *e) {
  LV_UNUSED(e);

  watch_ota_stop_session();

  settingsStatusLine =
    "OTA disabled";

  build_page(
    PAGE_SETTINGS);
}

// -------------------- SETTINGS / CONNECTIVITY PAGE --------------------

static const char *wifi_status_text() {
  wl_status_t st = WiFi.status();

  if (st == WL_CONNECTED) return "CONNECTED";
  if (wifiConnectInProgress) return "CONNECTING";
  if (wifiLastConnectFailed) return "FAILED";
  return "OFFLINE";
}

static lv_color_t wifi_status_color() {
  wl_status_t st = WiFi.status();

  if (st == WL_CONNECTED) return C_GREEN;
  if (wifiConnectInProgress) return C_AMBER;
  if (wifiLastConnectFailed) return C_RED;
  return C_MUTED;
}

static int wifi_rssi_percent(int rssi) {
  if (rssi <= -100) return 0;
  if (rssi >= -50) return 100;
  return (rssi + 100) * 2;
}


// -------------------- RTC / SYSTEM CLOCK --------------------

static uint8_t watch_time_bcd_to_dec(uint8_t value) {
  return (uint8_t)(((value >> 4) * 10) + (value & 0x0F));
}

static uint8_t watch_time_dec_to_bcd(uint8_t value) {
  return (uint8_t)(((value / 10) << 4) | (value % 10));
}

static bool watch_rtc_read_bytes(
    uint8_t reg,
    uint8_t *data,
    size_t len) {
  Wire.beginTransmission(WATCH_RTC_ADDR);
  Wire.write(reg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  size_t got =
    Wire.requestFrom(
      (int)WATCH_RTC_ADDR,
      (int)len);

  if (got != len) {
    while (Wire.available()) {
      Wire.read();
    }
    return false;
  }

  for (size_t i = 0; i < len; ++i) {
    data[i] = (uint8_t)Wire.read();
  }

  return true;
}

static bool watch_rtc_write_reg(
    uint8_t reg,
    uint8_t value) {
  Wire.beginTransmission(WATCH_RTC_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission() == 0;
}

static bool watch_rtc_read_local(struct tm &outTm) {
  uint8_t data[7] = {0};

  if (!watch_rtc_read_bytes(
        WATCH_RTC_SECONDS,
        data,
        sizeof(data))) {
    return false;
  }

  // PCF85063 seconds bit 7 is oscillator-stop. Reject untrusted RTC data.
  if ((data[0] & 0x80) != 0) {
    return false;
  }

  int second = watch_time_bcd_to_dec(data[0] & 0x7F);
  int minute = watch_time_bcd_to_dec(data[1] & 0x7F);
  int hour = watch_time_bcd_to_dec(data[2] & 0x3F);
  int day = watch_time_bcd_to_dec(data[3] & 0x3F);
  int month = watch_time_bcd_to_dec(data[5] & 0x1F);
  int year = 2000 + watch_time_bcd_to_dec(data[6]);

  if (year < 2024 || year > 2099 ||
      month < 1 || month > 12 ||
      day < 1 || day > 31 ||
      hour < 0 || hour > 23 ||
      minute < 0 || minute > 59 ||
      second < 0 || second > 59) {
    return false;
  }

  memset(&outTm, 0, sizeof(outTm));
  outTm.tm_year = year - 1900;
  outTm.tm_mon = month - 1;
  outTm.tm_mday = day;
  outTm.tm_hour = hour;
  outTm.tm_min = minute;
  outTm.tm_sec = second;
  outTm.tm_isdst = -1;

  return true;
}

static bool watch_rtc_write_local(const struct tm &localTm) {
  uint8_t payload[7];

  payload[0] = watch_time_dec_to_bcd((uint8_t)localTm.tm_sec);
  payload[1] = watch_time_dec_to_bcd((uint8_t)localTm.tm_min);
  payload[2] = watch_time_dec_to_bcd((uint8_t)localTm.tm_hour);
  payload[3] = watch_time_dec_to_bcd((uint8_t)localTm.tm_mday);
  payload[4] = watch_time_dec_to_bcd((uint8_t)localTm.tm_wday);
  payload[5] = watch_time_dec_to_bcd((uint8_t)(localTm.tm_mon + 1));
  payload[6] = watch_time_dec_to_bcd((uint8_t)((localTm.tm_year + 1900) % 100));

  Wire.beginTransmission(WATCH_RTC_ADDR);
  Wire.write(WATCH_RTC_SECONDS);
  Wire.write(payload, sizeof(payload));

  if (Wire.endTransmission() != 0) {
    return false;
  }

  uint8_t ctrl1 = 0;
  if (watch_rtc_read_bytes(
        WATCH_RTC_CTRL1,
        &ctrl1,
        1)) {
    // CTRL1 bit 5 is STOP. Ensure oscillator is running.
    watch_rtc_write_reg(
      WATCH_RTC_CTRL1,
      ctrl1 & (uint8_t)~0x20);
  }

  return true;
}

static bool watch_time_epoch_valid(time_t epoch) {
  return epoch >= (time_t)1704067200;  // 2024-01-01 UTC
}

static void watch_time_apply_timezone() {
  if (watchTimeZoneIndex >= WATCH_TIME_ZONE_COUNT) {
    watchTimeZoneIndex = 0;
  }

  setenv(
    "TZ",
    WATCH_TIME_ZONE_RULES[watchTimeZoneIndex],
    1);
  tzset();
}

static bool watch_time_set_system_local(struct tm localTm) {
  localTm.tm_isdst = -1;

  time_t epoch =
    mktime(&localTm);

  if (!watch_time_epoch_valid(epoch)) {
    return false;
  }

  struct timeval tv;
  tv.tv_sec = epoch;
  tv.tv_usec = 0;
  settimeofday(&tv, nullptr);

  return true;
}

static bool watch_time_write_rtc_from_system() {
  time_t now = time(nullptr);

  if (!watch_time_epoch_valid(now)) {
    return false;
  }

  struct tm localTm;
  localtime_r(&now, &localTm);

  bool ok =
    watch_rtc_write_local(localTm);

  if (ok) {
    watchRtcReady = true;
  }

  return ok;
}

static void watch_time_header_update() {
  if (!statusTime) {
    return;
  }

  time_t now = time(nullptr);

  if (!watch_time_epoch_valid(now)) {
    lv_label_set_text(
      statusTime,
      "--:--");
    return;
  }

  struct tm localTm;
  localtime_r(&now, &localTm);

  char buffer[12];

  if (watchTime24Hour) {
    snprintf(
      buffer,
      sizeof(buffer),
      "%02d:%02d",
      localTm.tm_hour,
      localTm.tm_min);
  } else {
    int hour12 =
      localTm.tm_hour % 12;

    if (hour12 == 0) {
      hour12 = 12;
    }

    snprintf(
      buffer,
      sizeof(buffer),
      "%d:%02d %s",
      hour12,
      localTm.tm_min,
      localTm.tm_hour >= 12 ? "PM" : "AM");
  }

  lv_label_set_text(
    statusTime,
    buffer);
}

static void watch_time_format_current(
    char *dateOut,
    size_t dateLen,
    char *timeOut,
    size_t timeLen) {
  time_t now = time(nullptr);

  if (!watch_time_epoch_valid(now)) {
    snprintf(dateOut, dateLen, "DATE NOT SET");
    snprintf(timeOut, timeLen, "--:--");
    return;
  }

  struct tm localTm;
  localtime_r(&now, &localTm);

  strftime(dateOut, dateLen, "%Y-%m-%d", &localTm);

  if (watchTime24Hour) {
    snprintf(
      timeOut,
      timeLen,
      "%02d:%02d:%02d",
      localTm.tm_hour,
      localTm.tm_min,
      localTm.tm_sec);
  } else {
    int hour12 =
      localTm.tm_hour % 12;

    if (hour12 == 0) {
      hour12 = 12;
    }

    snprintf(
      timeOut,
      timeLen,
      "%d:%02d:%02d %s",
      hour12,
      localTm.tm_min,
      localTm.tm_sec,
      localTm.tm_hour >= 12 ? "PM" : "AM");
  }
}

static int watch_time_days_in_month(int year, int month) {
  static const uint8_t days[] = {
    31, 28, 31, 30, 31, 30,
    31, 31, 30, 31, 30, 31
  };

  if (month < 1 || month > 12) {
    return 31;
  }

  int result = days[month - 1];

  bool leap =
    ((year % 4) == 0 && (year % 100) != 0) ||
    ((year % 400) == 0);

  if (month == 2 && leap) {
    result = 29;
  }

  return result;
}

static void watch_time_request_ntp() {
  if (WiFi.status() != WL_CONNECTED) {
    settingsStatusLine =
      "Time sync waiting for Wi-Fi";
    return;
  }

  watch_time_apply_timezone();

  configTzTime(
    WATCH_TIME_ZONE_RULES[watchTimeZoneIndex],
    "pool.ntp.org",
    "time.nist.gov");

  watchTimeNtpPending = true;
  watchTimeNtpRequestedMs = millis();
  watchTimeLastNtpAttemptMs = millis();
  settingsStatusLine = "Syncing time from Wi-Fi...";

  USBSerial.println(
    "[WATCH] NTP time sync requested");
}

static void watch_time_init() {
  watch_time_apply_timezone();

  struct tm rtcTm;
  watchRtcReady =
    watch_rtc_read_local(rtcTm);

  if (watchRtcReady) {
    watch_time_set_system_local(rtcTm);
    USBSerial.println(
      "[WATCH] PCF85063 RTC time loaded");
  } else {
    USBSerial.println(
      "[WATCH] PCF85063 RTC time unavailable / not set");
  }

  watchTimeLastHeaderUpdateMs = 0;
  watchTimeWifiWasConnected =
    WiFi.status() == WL_CONNECTED;

  if (watchTimeAutoSync &&
      watchTimeWifiWasConnected) {
    watch_time_request_ntp();
  }
}

static void watch_time_service() {
  uint32_t nowMs = millis();

  if (watchTimeLastHeaderUpdateMs == 0 ||
      (nowMs - watchTimeLastHeaderUpdateMs) >= 1000UL) {
    watchTimeLastHeaderUpdateMs = nowMs;
    watch_time_header_update();
  }

  bool wifiConnected =
    WiFi.status() == WL_CONNECTED;

  if (wifiConnected &&
      !watchTimeWifiWasConnected) {
    watchTimeWifiWasConnected = true;
    watchTimeNtpSyncedThisConnection = false;

    if (watchTimeAutoSync) {
      watch_time_request_ntp();
    }
  }

  if (!wifiConnected &&
      watchTimeWifiWasConnected) {
    watchTimeWifiWasConnected = false;
    watchTimeNtpPending = false;
    watchTimeNtpSyncedThisConnection = false;
  }

  if (watchTimeNtpPending) {
    uint32_t elapsed =
      nowMs - watchTimeNtpRequestedMs;

    // SNTP normally completes quickly. After a settling period, commit the
    // system time back to the hardware RTC so it survives power cycles.
    if (elapsed >= 5000UL &&
        watch_time_epoch_valid(time(nullptr))) {
      watch_time_write_rtc_from_system();
      watchTimeNtpPending = false;
      watchTimeNtpSyncedThisConnection = true;
      watchTimeLastNtpSyncEpoch = time(nullptr);
      settingsStatusLine = "Wi-Fi time sync complete";

      USBSerial.println(
        "[WATCH] NTP time committed to PCF85063");
    } else if (elapsed > 20000UL) {
      watchTimeNtpPending = false;
      settingsStatusLine = "Wi-Fi time sync timed out";
    }
  }

  // Periodic refresh while Wi-Fi remains available.
  if (watchTimeAutoSync &&
      wifiConnected &&
      !watchTimeNtpPending &&
      watchTimeNtpSyncedThisConnection &&
      watchTimeLastNtpSyncEpoch > 0) {
    time_t now = time(nullptr);

    if (watch_time_epoch_valid(now) &&
        (now - watchTimeLastNtpSyncEpoch) >= 21600) {
      watch_time_request_ntp();
    }
  }
}

static void connectivity_init() {
  if (!connectivityPrefsReady) {
    connectivityPrefsReady =
      connectivityPrefs.begin("prowatch", false);
  }

  if (connectivityPrefsReady) {
    wifiSavedSsid =
      connectivityPrefs.getString("wifi_ssid", "");
    wifiSavedPassword =
      connectivityPrefs.getString("wifi_pass", "");

    settingsBleSelectedName =
      connectivityPrefs.getString("ble_name", "");
    settingsBleSelectedMac =
      connectivityPrefs.getString("ble_mac", "");

    watchBrightnessPct =
      connectivityPrefs.getUChar("bright", 80);
    if (watchBrightnessPct < 10) watchBrightnessPct = 10;
    if (watchBrightnessPct > 100) watchBrightnessPct = 100;

    watchScreenTimeoutSec =
      connectivityPrefs.getUInt("timeout", 30);

    watchRaiseToWake =
      connectivityPrefs.getBool("raise", true);

    watchRaiseSensitivity =
      connectivityPrefs.getUChar("raisesens", 1);

    if (watchRaiseSensitivity > 2) {
      watchRaiseSensitivity = 1;
    }

    watchKeepAwakeBf1 =
      connectivityPrefs.getBool("bf1awake", true);

    watchTimeAutoSync =
      connectivityPrefs.getBool("timeauto", true);

    watchTime24Hour =
      connectivityPrefs.getBool("time24", true);

    watchTimeZoneIndex =
      connectivityPrefs.getUChar("timezone", 0);

    watchFwFeedUrl =
      connectivityPrefs.getString("fwfeed", "");

    watchOtaSessionEnabled =
      connectivityPrefs.getBool("otaenabled", true);

    if (watchTimeZoneIndex >= WATCH_TIME_ZONE_COUNT) {
      watchTimeZoneIndex = 0;
    }

    uint8_t savedBootPage =
      connectivityPrefs.getUChar(
        "bootpage2",
        (uint8_t)SIDE_BUTTON_HOME);

    if (savedBootPage > (uint8_t)SIDE_BUTTON_SESSION) {
      savedBootPage = (uint8_t)SIDE_BUTTON_HOME;
    }

    watchBootButtonPage =
      (SideButtonPage)savedBootPage;
  }

  gfx->setBrightness(
    (uint8_t)((watchBrightnessPct * 255UL) / 100UL));

  watchScreenOn = true;
  watchLastActivityMs = millis();

  WiFi.mode(WIFI_STA);
  WiFi.persistent(false);
  WiFi.setAutoReconnect(true);

  if (wifiSavedSsid.length() > 0) {
    wifiPendingSsid = wifiSavedSsid;
    wifiPendingPassword = wifiSavedPassword;
    wifiConnectInProgress = true;
    wifiPendingSave = false;
    wifiConnectStartedMs = millis();
    WiFi.begin(
      wifiSavedSsid.c_str(),
      wifiSavedPassword.c_str());
  }

  if (settingsBleSelectedMac.length() > 0) {
    ble_ui_set_selected();
  } else {
    ble_ui_set_disconnected();
  }

  wifiLastStatus = WiFi.status();
}

static void wifi_disconnect_cb(lv_event_t *e) {
  LV_UNUSED(e);

  WiFi.disconnect(true, false);
  wifiConnectInProgress = false;
  wifiPendingSave = false;
  wifiLastConnectFailed = false;
  settingsStatusLine = "Wi-Fi disconnected";
  update_wifi_header_ui();

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}

static void wifi_forget_cb(lv_event_t *e) {
  LV_UNUSED(e);

  WiFi.disconnect(true, true);

  wifiSavedSsid = "";
  wifiSavedPassword = "";
  wifiPendingSsid = "";
  wifiPendingPassword = "";
  wifiConnectInProgress = false;
  wifiPendingSave = false;
  wifiLastConnectFailed = false;

  if (connectivityPrefsReady) {
    connectivityPrefs.remove("wifi_ssid");
    connectivityPrefs.remove("wifi_pass");
  }

  settingsStatusLine = "Saved Wi-Fi removed";
  update_wifi_header_ui();

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}

static void wifi_password_close() {
  if (wifiPasswordOverlay) {
    lv_obj_delete(wifiPasswordOverlay);
    wifiPasswordOverlay = nullptr;
    wifiPasswordTextArea = nullptr;
    wifiKeyboardContainer = nullptr;
    wifiPasswordVisibilityLabel = nullptr;
    wifiPasswordVisible = true;
    wifiKeyboardShift = false;
    wifiKeyboardSymbols = false;
  }
}

static void wifi_password_cancel_cb(lv_event_t *e) {
  LV_UNUSED(e);
  wifi_password_close();
}

static void wifi_password_visibility_cb(lv_event_t *e) {
  LV_UNUSED(e);

  if (!wifiPasswordTextArea) return;

  wifiPasswordVisible = !wifiPasswordVisible;

  // Visible by default so the user can confirm what was typed.
  lv_textarea_set_password_mode(
    wifiPasswordTextArea,
    !wifiPasswordVisible);

  if (wifiPasswordVisibilityLabel) {
    lv_label_set_text(
      wifiPasswordVisibilityLabel,
      wifiPasswordVisible ? "HIDE" : "SHOW");
  }
}

static void wifi_connect_selected(const String &ssid,
                                  const String &password,
                                  bool saveOnSuccess) {
  if (ssid.length() == 0) return;

  wifiPendingSsid = ssid;
  wifiPendingPassword = password;
  wifiPendingSave = saveOnSuccess;
  wifiConnectInProgress = true;
  wifiLastConnectFailed = false;
  wifiConnectStartedMs = millis();

  WiFi.mode(WIFI_STA);
  WiFi.disconnect(false, false);
  delay(30);

  WiFi.begin(
    wifiPendingSsid.c_str(),
    wifiPendingPassword.c_str());

  settingsStatusLine =
    "Connecting to " + wifiPendingSsid;
}

static void wifi_password_connect_cb(lv_event_t *e) {
  LV_UNUSED(e);

  if (wifiSelectedNetworkIndex < 0 ||
      wifiSelectedNetworkIndex >= wifiScanCount) {
    wifi_password_close();
    return;
  }

  String password = "";
  if (wifiPasswordTextArea) {
    password =
      lv_textarea_get_text(wifiPasswordTextArea);
  }

  String ssid =
    wifiScanSsid[wifiSelectedNetworkIndex];

  wifi_password_close();
  wifi_connect_selected(ssid, password, true);

  if (activePageId == PAGE_SETTINGS) {
    build_page(PAGE_SETTINGS);
  }
}


// -------------------- CUSTOM WI-FI PASSWORD KEYBOARD --------------------
//
// Full-screen button-grid keyboard for the 410x502 AMOLED.
// Helpers are intentionally ordered explicitly to avoid Arduino's automatic
// prototype generator causing declaration-order problems.

static void wifi_keyboard_rebuild();

static void wifi_key_text_cb(lv_event_t *e) {
