static void style_home_card(lv_obj_t *card) {
  // Match the embedded artwork's black background so the icon panel and
  // the rest of the tile read as one continuous surface.
  lv_obj_set_style_bg_color(card, C_BG, 0);
  lv_obj_set_style_bg_opa(card, LV_OPA_COVER, 0);
  lv_obj_set_style_border_color(card, lv_color_hex(0x9BA8BE), 0);
  lv_obj_set_style_border_width(card, 1, 0);
  lv_obj_set_style_radius(card, 20, 0);
  lv_obj_set_style_shadow_width(card, 0, 0);
  lv_obj_set_style_pad_all(card, 12, 0);
}

static lv_obj_t *make_art_box(lv_obj_t *parent) {
  lv_obj_t *art = lv_obj_create(parent);
  style_transparent(art);
  lv_obj_set_size(art, 148, 116);
  lv_obj_align(art, LV_ALIGN_TOP_MID, 0, -2);
  return art;
}

static void add_home_card_text(lv_obj_t *tile,
                               const char *title) {
  lv_obj_t *t = make_label(tile, title, 19, C_TEXT);
  lv_obj_clear_flag(t, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_align(t, LV_ALIGN_BOTTOM_LEFT, 0, -6);

  lv_obj_t *arrow = make_label(tile, LV_SYMBOL_RIGHT, 22, C_RED);
  lv_obj_clear_flag(arrow, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_align(arrow, LV_ALIGN_BOTTOM_RIGHT, -1, -5);
}

static void build_bitmap_art(lv_obj_t *art, PageId page) {
  const lv_image_dsc_t *src = home_image_for_page(page);
  if (!src) return;

  lv_obj_set_style_radius(art, 14, 0);

  // IMPORTANT: the artwork must never steal the touch from the button below it.
  lv_obj_clear_flag(art, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_clear_flag(art, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_add_flag(art, LV_OBJ_FLAG_EVENT_BUBBLE);

  lv_obj_t *image = lv_image_create(art);
  lv_image_set_src(image, src);
  lv_obj_center(image);
  lv_obj_clear_flag(image, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_add_flag(image, LV_OBJ_FLAG_EVENT_BUBBLE);
}

static lv_obj_t *make_home_tile(lv_obj_t *parent,
                                const char *title,
                                PageId page) {
  lv_obj_t *tile = lv_button_create(parent);
  lv_obj_set_height(tile, 188);
  lv_obj_set_flex_grow(tile, 1);
  style_home_card(tile);

  // Full visual tile is the touch target.
  lv_obj_add_flag(tile, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_set_ext_click_area(tile, 3);
  lv_obj_set_style_border_color(tile, C_RED, LV_STATE_PRESSED);
  lv_obj_set_style_border_width(tile, 2, LV_STATE_PRESSED);
  lv_obj_set_style_bg_color(tile, lv_color_hex(0x111820), LV_STATE_PRESSED);

  lv_obj_add_event_cb(tile, nav_event_cb, LV_EVENT_CLICKED, (void *)(intptr_t)page);

  lv_obj_t *art = make_art_box(tile);

  build_bitmap_art(art, page);

  add_home_card_text(tile, title);
  return tile;
}

static void build_home(lv_obj_t *parent) {
  // The official Multimatic branding now lives on the startup splash.
  // Keep the operational Home desktop focused entirely on the four
  // primary motorsport functions.

  lv_obj_t *row1 = lv_obj_create(parent);
  style_transparent(row1);
  lv_obj_set_width(row1, LV_PCT(100));
  lv_obj_set_height(row1, 188);
  set_pad(row1, 0);
  lv_obj_set_style_pad_column(row1, 8, 0);
  lv_obj_set_layout(row1, LV_LAYOUT_FLEX);
  lv_obj_set_flex_flow(row1, LV_FLEX_FLOW_ROW);
  lv_obj_clear_flag(row1, LV_OBJ_FLAG_SCROLLABLE);

  make_home_tile(row1, "VITALS", PAGE_VITALS);
  make_home_tile(row1, "ENGINE", PAGE_ENGINE);

  lv_obj_t *row2 = lv_obj_create(parent);
  style_transparent(row2);
  lv_obj_set_width(row2, LV_PCT(100));
  lv_obj_set_height(row2, 188);
  set_pad(row2, 0);
  lv_obj_set_style_pad_column(row2, 8, 0);
  lv_obj_set_layout(row2, LV_LAYOUT_FLEX);
  lv_obj_set_flex_flow(row2, LV_FLEX_FLOW_ROW);
  lv_obj_clear_flag(row2, LV_OBJ_FLAG_SCROLLABLE);

  make_home_tile(row2, "TPMS", PAGE_TPMS);
  make_home_tile(row2, "SESSION", PAGE_SESSION);
}


// -------------------- VEHICLE VITALS PAGE --------------------
//
// Driver-critical, at-a-glance motorsports dashboard.
// This page is intentionally different from ENGINE:
// VITALS = what the driver needs immediately.
// ENGINE = deeper powertrain detail.
//
// Values remain demo/CAN placeholders until a telemetry gateway is connected.

static lv_obj_t *vitalsRpmValue = nullptr;
static lv_obj_t *vitalsSpeedValue = nullptr;
static lv_obj_t *vitalsGearValue = nullptr;
static lv_obj_t *vitalsSteerValue = nullptr;
static lv_obj_t *vitalsThrottleValue = nullptr;
static lv_obj_t *vitalsBrakeValue = nullptr;
static lv_obj_t *vitalsThrottleBar = nullptr;
static lv_obj_t *vitalsBrakeBar = nullptr;
static lv_obj_t *vitalsCoolantValue = nullptr;
static lv_obj_t *vitalsOilPressValue = nullptr;
static lv_obj_t *vitalsOilTempValue = nullptr;
static lv_obj_t *vitalsBatteryValue = nullptr;
static lv_obj_t *vitalsStatusValue = nullptr;
static lv_obj_t *vitalsShiftSegments[10] = {
  nullptr, nullptr, nullptr, nullptr, nullptr,
  nullptr, nullptr, nullptr, nullptr, nullptr
};

static lv_color_t vitals_coolant_color(float c) {
  if (c >= 115.0f) return C_RED;
  if (c >= 105.0f) return C_AMBER;
  return C_TEXT;
}

static lv_color_t vitals_oil_pressure_color(float psi) {
  if (psi <= 25.0f) return C_RED;
  if (psi <= 40.0f) return C_AMBER;
  return C_TEXT;
}

static lv_color_t vitals_oil_temp_color(float c) {
  if (c >= 140.0f) return C_RED;
  if (c >= 125.0f) return C_AMBER;
  return C_TEXT;
}

static lv_color_t vitals_battery_color(float v) {
  if (v < 11.5f) return C_RED;
  if (v < 12.2f) return C_AMBER;
  return C_TEXT;
}

static lv_obj_t *make_vitals_compact_metric(
    lv_obj_t *parent,
    const char *title,
    const char *value,
    const char *unit,
    lv_obj_t **valueOut) {
  lv_obj_t *card = make_card(parent, 82);
  lv_obj_set_style_pad_all(card, 10, 0);

  lv_obj_t *name =
    make_label(card, title, 12, C_MUTED);
  lv_obj_align(
    name,
    LV_ALIGN_TOP_LEFT,
    0,
    0);

  lv_obj_t *val =
    make_label(card, value, 20, C_TEXT);
  lv_obj_align(
    val,
    LV_ALIGN_BOTTOM_LEFT,
    0,
    -1);

  lv_obj_t *unitLabel =
    make_label(card, unit, 12, C_MUTED);
  lv_obj_align_to(
    unitLabel,
    val,
    LV_ALIGN_OUT_RIGHT_BOTTOM,
    6,
    -2);

  if (valueOut) {
    *valueOut = val;
  }

  return card;
}

static void vitals_update_ui() {
  if (activePageId != PAGE_VITALS) return;
  if (!vitalsRpmValue) return;

  char buf[24];

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.rpm);
  lv_label_set_text(
    vitalsRpmValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.speedKph);
  lv_label_set_text(
    vitalsSpeedValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%d",
    vehicle.gear);
  lv_label_set_text(
    vitalsGearValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%+.0f%c",
    vehicle.steeringDeg,
    0xB0);
  lv_label_set_text(
    vitalsSteerValue,
    buf);

  int throttle =
    (int)roundf(vehicle.throttle);
  if (throttle < 0) throttle = 0;
  if (throttle > 100) throttle = 100;

  int brake =
    (int)roundf(vehicle.brake);
  if (brake < 0) brake = 0;
  if (brake > 100) brake = 100;

  snprintf(
    buf,
    sizeof(buf),
    "%d%%",
    throttle);
  lv_label_set_text(
    vitalsThrottleValue,
    buf);

  snprintf(
    buf,
    sizeof(buf),
    "%d%%",
    brake);
  lv_label_set_text(
    vitalsBrakeValue,
    buf);

  lv_bar_set_value(
    vitalsThrottleBar,
    throttle,
    LV_ANIM_OFF);

  lv_bar_set_value(
    vitalsBrakeBar,
    brake,
    LV_ANIM_OFF);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.coolantC);
  lv_label_set_text(
    vitalsCoolantValue,
    buf);
  lv_obj_set_style_text_color(
    vitalsCoolantValue,
    vitals_coolant_color(
      vehicle.coolantC),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.oilPressure);
  lv_label_set_text(
    vitalsOilPressValue,
    buf);
  lv_obj_set_style_text_color(
    vitalsOilPressValue,
    vitals_oil_pressure_color(
      vehicle.oilPressure),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.0f",
    vehicle.oilTempC);
  lv_label_set_text(
    vitalsOilTempValue,
    buf);
  lv_obj_set_style_text_color(
    vitalsOilTempValue,
    vitals_oil_temp_color(
      vehicle.oilTempC),
    0);

  snprintf(
    buf,
    sizeof(buf),
    "%.1f",
    vehicle.batteryV);
  lv_label_set_text(
    vitalsBatteryValue,
    buf);
  lv_obj_set_style_text_color(
    vitalsBatteryValue,
    vitals_battery_color(
      vehicle.batteryV),
    0);

  bool critical =
    vehicle.coolantC >= 115.0f ||
    vehicle.oilPressure <= 25.0f ||
    vehicle.oilTempC >= 140.0f ||
    vehicle.batteryV < 11.5f;

  bool caution =
    !critical &&
    (vehicle.coolantC >= 105.0f ||
     vehicle.oilPressure <= 40.0f ||
     vehicle.oilTempC >= 125.0f ||
     vehicle.batteryV < 12.2f);

  if (critical) {
    lv_label_set_text(
      vitalsStatusValue,
      "CRITICAL");
    lv_obj_set_style_text_color(
      vitalsStatusValue,
      C_RED,
      0);
  } else if (caution) {
    lv_label_set_text(
      vitalsStatusValue,
      "CAUTION");
    lv_obj_set_style_text_color(
      vitalsStatusValue,
      C_AMBER,
      0);
  } else {
    lv_label_set_text(
      vitalsStatusValue,
      "NORMAL");
    lv_obj_set_style_text_color(
      vitalsStatusValue,
      C_GREEN,
      0);
  }

  // Segmented shift-light strip.
  // 5000 rpm begins the first segment; the final two segments are red.
  for (int i = 0; i < 10; ++i) {
    if (!vitalsShiftSegments[i]) continue;

    float threshold =
      5000.0f + (i * 340.0f);

    bool active =
      vehicle.rpm >= threshold;

    lv_color_t activeColor;

    if (i < 5) {
      activeColor = C_GREEN;
    } else if (i < 8) {
      activeColor = C_AMBER;
    } else {
      activeColor = C_RED;
    }

    lv_obj_set_style_bg_color(
      vitalsShiftSegments[i],
      active
        ? activeColor
        : lv_color_hex(0x18212B),
      0);

    lv_obj_set_style_border_color(
      vitalsShiftSegments[i],
      active
        ? activeColor
        : C_BORDER,
      0);
  }
}

