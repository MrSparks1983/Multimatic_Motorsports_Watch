// -------------------- STARTUP SPLASH --------------------
//
// Clean motorsports boot screen shown before the main UI:
//   MULTIMATIC MOTORSPORTS
//   // PRO WATCH
//   v0.8i
//
// This uses LVGL directly so it matches the AMOLED UI and does not depend
// on an external image file.

static void splash_render_frame() {
  lv_timer_handler();

#ifdef DIRECT_RENDER_MODE
#if defined(CANVAS) || defined(RGB_PANEL) || defined(DSI_PANEL)
  gfx->flush();
#else
  gfx->draw16bitRGBBitmap(
    0,
    0,
    (uint16_t *)disp_draw_buf,
    screenWidth,
    screenHeight
  );
#endif
#else
#ifdef CANVAS
  gfx->flush();
#endif
#endif
}

static float splash_ease_out(float t) {
  if (t < 0.0f) return 0.0f;
  if (t > 1.0f) return 1.0f;
  float inv = 1.0f - t;
  return 1.0f - inv * inv * inv;
}

static float splash_smoothstep(float t) {
  if (t < 0.0f) return 0.0f;
  if (t > 1.0f) return 1.0f;
  return t * t * (3.0f - 2.0f * t);
}

static void show_startup_splash() {
  lv_obj_t *screen = lv_screen_active();

  lv_obj_clean(screen);
  lv_obj_set_style_bg_color(
    screen,
    lv_color_hex(0x000000),
    0);
  lv_obj_set_style_bg_opa(
    screen,
    LV_OPA_COVER,
    0);
  lv_obj_set_scrollbar_mode(
    screen,
    LV_SCROLLBAR_MODE_OFF);

  init_multimatic_logo_descriptor();

  // Stage 1: only the official gear-man emblem appears, centered.
  lv_obj_t *gear =
    lv_image_create(screen);
  lv_image_set_src(
    gear,
    &img_multimatic_gear_man);
  lv_image_set_scale(
    gear,
    270);
  lv_image_set_antialias(
    gear,
    true);
  lv_obj_clear_flag(
    gear,
    LV_OBJ_FLAG_CLICKABLE);
  lv_obj_align(
    gear,
    LV_ALIGN_CENTER,
    0,
    -4);
  lv_obj_set_style_opa(
    gear,
    0,
    0);

  // Stage 2: the Multimatic Motorsports wordmark is revealed as the
  // gear-man slides into its final left-hand logo position.
  lv_obj_t *wordmark =
    lv_image_create(screen);
  lv_image_set_src(
    wordmark,
    &img_multimatic_wordmark);
  lv_image_set_scale(
    wordmark,
    238);
  lv_image_set_antialias(
    wordmark,
    true);
  lv_obj_clear_flag(
    wordmark,
    LV_OBJ_FLAG_CLICKABLE);
  lv_obj_align(
    wordmark,
    LV_ALIGN_CENTER,
    80,
    -4);
  lv_obj_set_style_opa(
    wordmark,
    0,
    0);

  lv_obj_t *watch =
    make_label(
      screen,
      "// PRO WATCH",
      20,
      lv_color_hex(0xF5F5F7));
  lv_obj_set_width(
    watch,
    350);
  lv_obj_set_style_text_align(
    watch,
    LV_TEXT_ALIGN_CENTER,
    0);
  lv_obj_align(
    watch,
    LV_ALIGN_CENTER,
    0,
    92);
  lv_obj_set_style_opa(
    watch,
    0,
    0);

  lv_obj_t *accent =
    lv_obj_create(screen);
  lv_obj_set_size(
    accent,
    4,
    4);
  lv_obj_set_style_bg_color(
    accent,
    lv_color_hex(0xE31B23),
    0);
  lv_obj_set_style_bg_opa(
    accent,
    LV_OPA_COVER,
    0);
  lv_obj_set_style_border_width(
    accent,
    0,
    0);
  lv_obj_set_style_radius(
    accent,
    2,
    0);
  lv_obj_clear_flag(
    accent,
    LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_clear_flag(
    accent,
    LV_OBJ_FLAG_CLICKABLE);
  lv_obj_align(
    accent,
    LV_ALIGN_CENTER,
    0,
    119);
  lv_obj_set_style_opa(
    accent,
    0,
    0);

  lv_obj_t *version =
    make_label(
      screen,
      "v0.9.58",
      14,
      lv_color_hex(0x98A0AF));
  lv_obj_set_width(
    version,
    350);
  lv_obj_set_style_text_align(
    version,
    LV_TEXT_ALIGN_CENTER,
    0);
  lv_obj_align(
    version,
    LV_ALIGN_CENTER,
    0,
    145);
  lv_obj_set_style_opa(
    version,
    0,
    0);

  // ----------------------------------------------------------
  // BOOT ANIMATION
  //
  // 0-500 ms    Gear man fades in centered
  // 500-1000 ms Gear man slides LEFT ONLY into aligned logo position
  // 650-1100 ms Multimatic Motorsports wordmark fades/slides in
  // 1050-1450ms // PRO WATCH fades in
  // 1250-1600ms Red accent expands from center
  // 1450-1750ms Version fades in
  // 1750-2300ms Hold completed splash
  // 2300-2550ms Entire splash fades out
  // ----------------------------------------------------------

  const uint32_t animStart = millis();
  const uint32_t totalMs = 2550UL;

  while ((millis() - animStart) < totalMs) {
    uint32_t elapsed =
      millis() - animStart;

    // 1) Gear man fades in while centered.
    float gearFade =
      splash_smoothstep(
        (float)elapsed / 500.0f);

    int gearX = 0;
    const int gearY = -4;

    // 2) Slide LEFT ONLY, leaving a deliberate gap to the wordmark.
    if (elapsed >= 500UL) {
      float slideT =
        splash_ease_out(
          ((float)elapsed - 500.0f)
          / 500.0f);

      gearX =
        (int)(-149.0f * slideT);
    }

    lv_obj_align(
      gear,
      LV_ALIGN_CENTER,
      gearX,
      gearY);

    lv_obj_set_style_opa(
      gear,
      (lv_opa_t)(255.0f * gearFade),
      0);

    // Wordmark follows the gear-man move and settles into place.
    float wordT =
      splash_smoothstep(
        ((float)elapsed - 650.0f)
        / 450.0f);

    int wordX =
      80
      - (int)(26.0f * splash_ease_out(
        ((float)elapsed - 650.0f)
        / 450.0f));

    lv_obj_align(
      wordmark,
      LV_ALIGN_CENTER,
      wordX,
      -4);

    lv_obj_set_style_opa(
      wordmark,
      (lv_opa_t)(255.0f * wordT),
      0);

    // Continue the existing product-name animation.
    float watchT =
      splash_smoothstep(
        ((float)elapsed - 1050.0f)
        / 400.0f);

    lv_obj_set_style_opa(
      watch,
      (lv_opa_t)(255.0f * watchT),
      0);

    float accentT =
      splash_ease_out(
        ((float)elapsed - 1250.0f)
        / 350.0f);

    int accentWidth =
      4 + (int)(120.0f * accentT);

    lv_obj_set_width(
      accent,
      accentWidth);

    lv_obj_set_style_opa(
      accent,
      (lv_opa_t)(255.0f * accentT),
      0);

    lv_obj_align(
      accent,
      LV_ALIGN_CENTER,
      0,
      119);

    float versionT =
      splash_smoothstep(
        ((float)elapsed - 1450.0f)
        / 300.0f);

    lv_obj_set_style_opa(
      version,
      (lv_opa_t)(255.0f * versionT),
      0);

    // Final fade-out.
    if (elapsed >= 2300UL) {
      float fadeT =
        ((float)elapsed - 2300.0f)
        / 250.0f;

      if (fadeT < 0.0f) fadeT = 0.0f;
      if (fadeT > 1.0f) fadeT = 1.0f;

      lv_opa_t finalOpacity =
        (lv_opa_t)(
          255.0f * (1.0f - fadeT));

      lv_obj_set_style_opa(
        gear,
        finalOpacity,
        0);

      lv_obj_set_style_opa(
        wordmark,
        finalOpacity,
        0);

      lv_obj_set_style_opa(
        watch,
        finalOpacity,
        0);

      lv_obj_set_style_opa(
        accent,
        finalOpacity,
        0);

      lv_obj_set_style_opa(
        version,
        finalOpacity,
        0);
    }

    splash_render_frame();
    delay(16);
  }

  lv_obj_clean(screen);
}

// One-shot startup refresh.
// The embedded bitmap images render correctly after LVGL has completed its
// first display cycle. Rebuilding HOME once shortly after startup makes the
// graphics appear immediately without requiring the user to enter a page
// and tap Home.
static void startup_home_refresh_cb(lv_timer_t *timer) {
  if (watchBatteryVbusPresent &&
      !watchChargingScreenDismissed) {
    watch_charging_screen_sync();
  } else {
    build_page(PAGE_HOME);
  }

  lv_timer_delete(timer);
}

// One-shot boot charging re-check. Some PMIC/VBUS status bits settle just
// after display/LVGL startup, so re-poll shortly after HOME is constructed.
static void startup_charge_sync_cb(lv_timer_t *timer) {
  watchBatteryLastPollMs = 0;
  watch_battery_poll_pmic();
  watch_charging_screen_sync();
  lv_timer_delete(timer);
}

