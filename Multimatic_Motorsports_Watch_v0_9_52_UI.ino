static lv_obj_t *settings_switch_row(lv_obj_t *parent,
                                     const char *symbol,
                                     const char *title,
                                     const char *subtitle,
                                     bool checked,
                                     lv_event_cb_t cb,
                                     bool enabled = true) {
  lv_obj_t *card = make_card(parent, 92);

  lv_obj_t *icon =
    make_label(card, symbol, 22, C_RED);
