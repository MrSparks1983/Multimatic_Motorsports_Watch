static void nav_event_cb(lv_event_t *e) {
  PageId page = (PageId)(intptr_t)lv_event_get_user_data(e);
  build_page(page);
}

static lv_obj_t *make_nav_button(lv_obj_t *parent,
                                 const char *title,
                                 PageId page,
                                 bool active = false) {
  lv_obj_t *btn = lv_button_create(parent);
  lv_obj_set_height(btn, 58);
  lv_obj_set_flex_grow(btn, 1);

  // Navigation buttons are fixed touch targets, not scroll containers.
  lv_obj_clear_flag(btn, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_set_scrollbar_mode(btn, LV_SCROLLBAR_MODE_OFF);

  lv_obj_set_style_bg_color(btn, active ? C_RED : C_CARD2, 0);
  lv_obj_set_style_border_color(btn, active ? C_RED : C_BORDER, 0);
  lv_obj_set_style_border_width(btn, 1, 0);
  lv_obj_set_style_radius(btn, 14, 0);
  lv_obj_set_style_shadow_width(btn, 0, 0);

  lv_obj_set_ext_click_area(btn, 3);
  lv_obj_set_style_border_color(btn, C_RED, LV_STATE_PRESSED);
  lv_obj_set_style_bg_color(btn, lv_color_hex(0x15151A), LV_STATE_PRESSED);

  lv_obj_add_event_cb(btn, nav_event_cb, LV_EVENT_CLICKED, (void *)(intptr_t)page);

  lv_obj_t *label = make_label(btn, title, 12, C_TEXT);
  lv_obj_clear_flag(label, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_center(label);

  return btn;
}

static void add_bottom_nav(
    lv_obj_t *parent,
    PageId activePage) {
  // Navigation is now a fixed root-level control created once by
  // create_fixed_bottom_nav(). Keep this helper as a no-op so all existing
  // page builders remain unchanged.
  LV_UNUSED(parent);
  LV_UNUSED(activePage);
}


static void fixed_bottom_nav_apply_state(
    PageId activePage) {
  static const PageId navPages[5] = {
    PAGE_VITALS,
    PAGE_ENGINE,
    PAGE_TPMS,
    PAGE_SESSION,
    PAGE_CREW
  };

  for (int i = 0; i < 5; ++i) {
    lv_obj_t *btn =
      fixedBottomNavButtons[i];

    if (!btn) continue;

    bool active =
      activePage == navPages[i];

    lv_obj_set_style_bg_color(
      btn,
      active
        ? C_RED
        : lv_color_hex(0x0D151E),
      0);

    lv_obj_set_style_border_color(
      btn,
      active
        ? C_RED
        : C_BORDER,
      0);

    lv_obj_set_style_border_width(
      btn,
      active ? 2 : 1,
      0);
  }
}

static lv_obj_t *make_fixed_bottom_nav_button(
    lv_obj_t *parent,
    const char *title,
    PageId page,
    int index) {
  lv_obj_t *btn =
    lv_button_create(parent);

  lv_obj_set_height(
    btn,
    44);

  lv_obj_set_flex_grow(
    btn,
    1);

  lv_obj_clear_flag(
    btn,
    LV_OBJ_FLAG_SCROLLABLE);

  lv_obj_set_scrollbar_mode(
    btn,
    LV_SCROLLBAR_MODE_OFF);

  lv_obj_set_style_bg_color(
    btn,
    lv_color_hex(0x0D151E),
    0);

  lv_obj_set_style_border_color(
    btn,
    C_BORDER,
    0);

  lv_obj_set_style_border_width(
    btn,
    1,
    0);

  lv_obj_set_style_radius(
    btn,
    10,
    0);

  lv_obj_set_style_shadow_width(
    btn,
    0,
    0);

  lv_obj_set_style_pad_all(
    btn,
    0,
    0);

  lv_obj_set_style_bg_color(
    btn,
    C_RED,
    LV_STATE_PRESSED);

  lv_obj_set_style_border_color(
    btn,
    C_TEXT,
    LV_STATE_PRESSED);

  lv_obj_set_ext_click_area(
    btn,
    2);

  lv_obj_add_event_cb(
    btn,
    nav_event_cb,
    LV_EVENT_CLICKED,
    (void *)(intptr_t)page);

  lv_obj_t *label =
    make_label(
      btn,
      title,
      10,
      C_TEXT);

  lv_obj_clear_flag(
    label,
    LV_OBJ_FLAG_CLICKABLE);

  lv_obj_clear_flag(
    label,
    LV_OBJ_FLAG_SCROLLABLE);

  lv_obj_center(
    label);

  if (index >= 0 &&
      index < 5) {
    fixedBottomNavButtons[index] =
      btn;
  }

  return btn;
}

static void create_fixed_bottom_nav() {
  if (!rootScreen ||
      fixedBottomNav) {
    return;
  }

  fixedBottomNav =
    lv_obj_create(
      rootScreen);

  // Rounded AMOLED safe area. Keep the fixed navigation away from the
  // physical left/right and lower rounded corners.
  lv_obj_set_pos(
    fixedBottomNav,
    24,
    LCD_HEIGHT - 64);

  lv_obj_set_size(
    fixedBottomNav,
    LCD_WIDTH - 48,
    52);

  lv_obj_set_style_bg_color(
    fixedBottomNav,
    lv_color_hex(0x070D13),
    0);

  lv_obj_set_style_bg_opa(
    fixedBottomNav,
    LV_OPA_COVER,
    0);

  lv_obj_set_style_border_color(
    fixedBottomNav,
    lv_color_hex(0x343F4D),
    0);

  lv_obj_set_style_border_width(
    fixedBottomNav,
    1,
    0);

  lv_obj_set_style_radius(
    fixedBottomNav,
    14,
    0);

  lv_obj_set_style_shadow_width(
    fixedBottomNav,
    0,
    0);

  lv_obj_set_style_pad_left(
    fixedBottomNav,
    3,
    0);

  lv_obj_set_style_pad_right(
    fixedBottomNav,
    3,
    0);

  lv_obj_set_style_pad_top(
    fixedBottomNav,
    3,
    0);

  lv_obj_set_style_pad_bottom(
    fixedBottomNav,
    3,
    0);

  lv_obj_set_style_pad_column(
    fixedBottomNav,
    3,
    0);

  lv_obj_set_layout(
    fixedBottomNav,
    LV_LAYOUT_FLEX);

  lv_obj_set_flex_flow(
    fixedBottomNav,
    LV_FLEX_FLOW_ROW);

  lv_obj_set_flex_align(
    fixedBottomNav,
    LV_FLEX_ALIGN_SPACE_BETWEEN,
    LV_FLEX_ALIGN_CENTER,
    LV_FLEX_ALIGN_CENTER);

  // The fixed navigation container itself must never become a scroll target.
  lv_obj_clear_flag(
    fixedBottomNav,
    LV_OBJ_FLAG_SCROLLABLE);

  lv_obj_set_scrollbar_mode(
    fixedBottomNav,
    LV_SCROLLBAR_MODE_OFF);

  make_fixed_bottom_nav_button(
    fixedBottomNav,
    "VITALS",
    PAGE_VITALS,
    0);

  make_fixed_bottom_nav_button(
    fixedBottomNav,
    "ENGINE",
    PAGE_ENGINE,
    1);

  make_fixed_bottom_nav_button(
    fixedBottomNav,
    "TPMS",
    PAGE_TPMS,
    2);

  make_fixed_bottom_nav_button(
    fixedBottomNav,
    "SESSION",
    PAGE_SESSION,
    3);

  make_fixed_bottom_nav_button(
    fixedBottomNav,
    "CREW",
    PAGE_CREW,
    4);

  // Home uses the large four-tile desktop and PWR as the Home command,
  // so the fixed nav is hidden there.
  lv_obj_add_flag(
    fixedBottomNav,
    LV_OBJ_FLAG_HIDDEN);
}

static void update_fixed_bottom_nav(
    PageId page) {
  if (!fixedBottomNav) {
    return;
  }

  if (page == PAGE_HOME) {
    lv_obj_add_flag(
      fixedBottomNav,
      LV_OBJ_FLAG_HIDDEN);
    return;
  }

  lv_obj_clear_flag(
    fixedBottomNav,
    LV_OBJ_FLAG_HIDDEN);

  fixed_bottom_nav_apply_state(
    page);

  // Keep the fixed nav above scrollable pageBody.
  // Charging standby, when active, is raised above it separately.
  lv_obj_move_foreground(
    fixedBottomNav);
}

